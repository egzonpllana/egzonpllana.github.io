---
import '@fontsource-variable/inter';
import '@fontsource-variable/jetbrains-mono';
import interLatinWoff2 from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import monoLatinWoff2 from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { SITE } from '../data/site';

interface Props {
  title: string;
  /** Raw page title for social cards (no "- site name" suffix). */
  ogTitle?: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const {
  title,
  ogTitle = title,
  description = SITE.description,
  image = '/og/default-og.png',
  imageWidth = image === '/og/default-og.png' ? 1200 : undefined,
  imageHeight = image === '/og/default-og.png' ? 630 : undefined,
  imageAlt = ogTitle,
  type = 'website',
  publishedDate,
  updatedDate,
  tags = [],
} = Astro.props;

const canonical = new URL(
  Astro.url.pathname,
  Astro.site ?? Astro.url,
).toString();
const ogImage = new URL(image, Astro.site ?? Astro.url).toString();
const isHome = Astro.url.pathname === '/';

const personLd = {
  '@type': 'Person',
  '@id': `${SITE.url}/#person`,
  name: SITE.author,
  email: `mailto:${SITE.email}`,
  jobTitle: 'Senior iOS Engineer & SDK Architect',
  url: SITE.url,
  sameAs: [
    'https://linkedin.com/in/egzon-pllana',
    'https://github.com/egzonpllana',
    'https://medium.com/@egzonpllana',
    'https://apps.apple.com/developer/id1315313322',
  ],
};

// Home: WebSite + Person. Article pages: BlogPosting. Other pages: none.
const jsonLd = isHome
  ? {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': 'WebSite',
          url: SITE.url,
          name: SITE.name,
          description: SITE.description,
          publisher: { '@id': `${SITE.url}/#person` },
        },
        personLd,
      ],
    }
  : type === 'article'
    ? {
        '@context': 'https://schema.org',
        '@type': 'BlogPosting',
        headline: ogTitle,
        description,
        image: ogImage,
        url: canonical,
        mainEntityOfPage: canonical,
        datePublished: publishedDate?.toISOString(),
        ...(updatedDate && { dateModified: updatedDate.toISOString() }),
        ...(tags.length > 0 && { keywords: tags.join(', ') }),
        author: personLd,
      }
    : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="author" content={SITE.author} />
<meta name="referrer" content="strict-origin-when-cross-origin" />

<link
  rel="preload"
  as="font"
  type="font/woff2"
  href={interLatinWoff2}
  crossorigin
/>
<link
  rel="preload"
  as="font"
  type="font/woff2"
  href={monoLatinWoff2}
  crossorigin
/>

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<meta
  name="theme-color"
  content="#ffffff"
  media="(prefers-color-scheme: light)"
/>
<meta
  name="theme-color"
  content="#0b0e14"
  media="(prefers-color-scheme: dark)"
/>

<link
  rel="alternate"
  type="application/rss+xml"
  title={`${SITE.name} - Articles`}
  href={new URL('rss.xml', Astro.site ?? Astro.url).toString()}
/>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
{imageWidth && <meta property="og:image:width" content={String(imageWidth)} />}
{
  imageHeight && (
    <meta property="og:image:height" content={String(imageHeight)} />
  )
}
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="en_US" />
{
  publishedDate && (
    <meta
      property="article:published_time"
      content={publishedDate.toISOString()}
    />
  )
}
{
  updatedDate && (
    <meta
      property="article:modified_time"
      content={updatedDate.toISOString()}
    />
  )
}
{
  type === 'article' &&
    tags.map((tag) => <meta property="article:tag" content={tag} />)
}
{type === 'article' && <meta property="article:author" content={SITE.author} />}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={ogTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

{
  jsonLd && (
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  )
}
