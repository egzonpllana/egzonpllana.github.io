---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { formatDate, isoDate } from '../lib/format-date';
import ViewCount from './ViewCount.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  date: Date;
  /** Reading time for prose, "Slides & transcript" for a deck. */
  meta: string;
  cta: string;
  image?: ImageMetadata;
  index?: number;
}

const {
  title,
  description,
  href,
  date,
  meta,
  cta,
  image,
  index = 0,
} = Astro.props;
---

<article
  class:list={['tcard', { 'tcard--media': !!image }]}
  data-reveal
  style={`--d:${(index % 3) * 80}ms`}
>
  <a class="tcard__link" href={href} aria-label={title}></a>

  {
    image && (
      <div class="tcard__media">
        <Image
          src={image}
          alt=""
          widths={[480, 960]}
          sizes="(max-width: 640px) 92vw, 480px"
          format="webp"
          quality={80}
          loading="lazy"
          decoding="async"
        />
      </div>
    )
  }

  <div class="tcard__body">
    <div class="tcard__meta">
      <time datetime={isoDate(date)}>{formatDate(date)}</time>
      <span class="tcard__dot" aria-hidden="true">·</span>
      <span>{meta}</span>
      <ViewCount path={href} />
    </div>

    <h3 class="tcard__title">{title}</h3>
    <p class="tcard__desc">{description}</p>

    <div class="tcard__footer">
      <span class="tcard__read link-accent" aria-hidden="true">
        {cta}
        <span>→</span>
      </span>
    </div>
  </div>
</article>

<style>
  .tcard {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition:
      border-color 0.18s var(--ease),
      background-color 0.18s var(--ease);
  }
  .tcard:hover {
    border-color: var(--border-strong);
    background: var(--surface-hover);
  }
  .tcard__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }
  .tcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tcard__link {
    position: absolute;
    inset: 0;
    border-radius: var(--radius-lg);
    z-index: 1;
  }
  .tcard__link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .tcard__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5);
    flex: 1;
  }
  .tcard__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .tcard__title {
    font-size: var(--fs-lg);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .tcard__desc {
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }
  .tcard__footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: var(--sp-3);
    margin-top: auto;
    padding-top: var(--sp-2);
  }
  /* Plain label: clicks fall through to the stretched card link below. */
  .tcard__read {
    font-size: var(--fs-sm);
    white-space: nowrap;
  }
  .tcard__read span {
    display: inline-block;
    transition: transform 0.18s var(--ease);
  }
  .tcard:hover .tcard__read span {
    transform: translateX(3px);
  }
</style>
