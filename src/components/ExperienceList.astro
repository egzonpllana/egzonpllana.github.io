---
import { PROFILE } from '../data/profile';
---

<div class="xp">
  {
    PROFILE.experience.map((area, i) => (
      <article class="xp__card" data-reveal style={`--d:${i * 80}ms`}>
        <header class="xp__head">
          <span class="xp__index" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <span class="xp__focus">{area.focus}</span>
        </header>
        <h3 class="xp__title">{area.title}</h3>
        <p class="xp__summary">{area.summary}</p>
        <ul class="xp__points">
          {area.highlights.map((point) => (
            <li class="xp__point">{point}</li>
          ))}
        </ul>
      </article>
    ))
  }
</div>

<ul class="xp-skills" aria-label="Core skills">
  {PROFILE.skills.map((skill) => <li class="tag">{skill}</li>)}
</ul>

<style>
  .xp {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: var(--sp-4);
    align-items: stretch;
  }
  .xp__card {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    transition:
      border-color 0.18s var(--ease),
      transform 0.18s var(--ease),
      box-shadow 0.18s var(--ease);
  }
  .xp__card:hover {
    border-color: var(--border-strong);
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
  }
  .xp__head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .xp__index {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--accent-text);
  }
  .xp__focus {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .xp__title {
    font-size: var(--fs-md);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .xp__summary {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .xp__points {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding-top: var(--sp-2);
    border-top: 1px solid var(--border);
  }
  .xp__point {
    position: relative;
    padding-left: var(--sp-4);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    line-height: 1.55;
  }
  .xp__point::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.62em;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }
  .xp-skills {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    list-style: none;
    padding: 0;
    margin-top: var(--sp-6);
  }
</style>
