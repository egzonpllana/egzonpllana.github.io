---
import { Image } from 'astro:assets';
import { PROFILE } from '../data/profile';
import SocialLinks from './SocialLinks.astro';
import portrait from '../assets/portrait.png';
---

<section class="hero">
  <div class="container">
    <div class="hero__inner">
      <div class="hero__intro">
        <p class="kicker anim-in" style="--d:0ms">{PROFILE.headline}</p>
        <h1 class="hero__name anim-in" style="--d:90ms">{PROFILE.name}</h1>
        <p class="hero__summary lede anim-in" style="--d:180ms">
          {PROFILE.summary}
        </p>
      </div>

      <aside class="hero__portrait anim-in" style="--d:220ms">
        <figure class="hero__frame">
          <Image
            class="hero__avatar"
            src={portrait}
            alt={`Illustrated portrait of ${PROFILE.name}`}
            width={305}
            height={305}
            quality={90}
            loading="eager"
            fetchpriority="high"
          />
        </figure>
      </aside>

      <div class="hero__rest">
        <div class="hero__statement callout anim-in" style="--d:260ms">
          <span class="label hero__statement-label">Focus</span>
          <p>{PROFILE.statement}</p>
        </div>

        <div class="hero__actions anim-in" style="--d:320ms">
          <a class="btn btn--primary" href="/contact/">
            Get in touch <span class="arrow" aria-hidden="true">→</span>
          </a>
          <a class="btn" href="#apps">View the apps</a>
          <SocialLinks size={18} />
        </div>

        <dl class="hero__facts anim-in" style="--d:380ms">
          <div class="hero__fact">
            <dt class="label">Based in</dt>
            <dd>{PROFILE.location}</dd>
          </div>
          <div class="hero__fact">
            <dt class="label">Availability</dt>
            <dd>
              <span class="dot" aria-hidden="true"></span>
              {PROFILE.availability}
            </dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-top: clamp(3rem, 2rem + 4vw, 6rem);
    padding-bottom: clamp(3rem, 2rem + 4vw, 5rem);
    border-bottom: 1px solid var(--border);
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: clamp(var(--sp-6), 6vw, var(--sp-9));
  }
  /* Intro (kicker, name, summary) and the rest stack in the left column;
     the portrait spans both rows on the right. */
  .hero__intro {
    grid-column: 1;
    grid-row: 1;
    max-width: 700px;
  }
  .hero__rest {
    grid-column: 1;
    grid-row: 2;
    max-width: 700px;
  }
  .hero__name {
    margin-top: var(--sp-5);
    font-size: var(--fs-display);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .hero__summary {
    margin-top: var(--sp-5);
    font-size: clamp(1.125rem, 1rem + 0.5vw, 1.3rem);
    max-width: 52ch;
  }
  .hero__statement {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    margin-top: var(--sp-6);
  }
  .hero__statement-label {
    color: var(--accent-text);
  }
  .hero__statement p {
    color: var(--fg);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  /* Key / value strip under a hairline, like slide metadata. */
  .hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5) var(--sp-7);
    margin-top: var(--sp-7);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
  }
  .hero__fact {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }
  .hero__fact dd {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--fg);
  }

  /* ---- Portrait ----------------------------------------------------------- */
  .hero__portrait {
    grid-column: 2;
    grid-row: 1 / 3;
    justify-self: end;
    align-self: center;
  }
  .hero__frame {
    width: 340px;
    max-width: 100%;
    padding: var(--sp-3);
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: color-mix(in srgb, var(--surface) 45%, transparent);
  }
  .hero__avatar {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    border-radius: var(--radius);
    border: 1px solid var(--border-strong);
    transition: border-color 0.36s var(--ease);
  }
  .hero__frame:hover .hero__avatar {
    border-color: var(--accent-line);
  }
  .dot {
    flex: none;
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: var(--accent);
    box-shadow: 0 0 0 3px var(--accent-soft);
  }

  /* Tablet: shrink the portrait before it forces a stack. */
  @media (max-width: 960px) {
    .hero__frame {
      width: 260px;
    }
  }

  /* Mobile: stack as intro, then portrait, then the rest. */
  @media (max-width: 720px) {
    .hero__inner {
      display: flex;
      flex-direction: column;
      gap: var(--sp-6);
    }
    .hero__intro {
      order: 1;
    }
    .hero__portrait {
      order: 2;
      align-self: flex-start;
    }
    .hero__rest {
      order: 3;
    }
    /* Flex gap handles the spacing above the statement on mobile. */
    .hero__statement {
      margin-top: 0;
    }
    .hero__frame {
      width: 200px;
      padding: var(--sp-2);
      border-radius: var(--radius-lg);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__fact .dot {
      /* Two pulses on arrival, then at rest; an even count ends on the base ring. */
      animation: hero-pulse 0.9s ease-in-out 0.6s 4 alternate;
    }
  }
  @keyframes hero-pulse {
    from {
      box-shadow: 0 0 0 3px var(--accent-soft);
    }
    to {
      box-shadow: 0 0 0 6px transparent;
    }
  }
</style>
