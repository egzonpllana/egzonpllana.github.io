---
/**
 * The WAV header as a real hex dump: offset column, 16 bytes per row, every
 * byte coloured by the field it belongs to. Pick a field to decode it. The
 * layout shown first is the one AVAudioFile writes: JUNK and FLLR chunks push
 * the sound to offset 4,096. The textbook 44-byte layout is the alternative.
 * The animation is the parser walking the chunks, hopping from one to the
 * next; picking a layout replays it over that layout.
 *
 * Both layouts are built at compile time from the field list below, so every
 * byte on screen is computed, not typed by hand.
 */
import VizFrame from './viz/VizFrame.astro';
import AnimControls from './viz/AnimControls.astro';

interface Props {
  caption?: string;
}
const {
  caption = 'Hover, tap or arrow through the fields. AVAudioFile pads the header with JUNK and FLLR chunks, so the sound starts at byte 4,096, not after the textbook 44 bytes. That is why the parser hops chunk by chunk instead of cutting at a fixed offset.',
} = Astro.props;

type Kind = 'tag' | 'size' | 'fmt' | 'pad' | 'sound';
interface Field {
  id: string;
  name: string;
  kind: Kind;
  bytes: number[];
  value: string;
  text: string;
  /** Decoded as little-endian unsigned integer (sizes and format fields). */
  le?: boolean;
}

const ascii = (s: string) => [...s].map((c) => c.charCodeAt(0));
const u32 = (n: number) => [
  n & 255,
  (n >> 8) & 255,
  (n >> 16) & 255,
  (n >>> 24) & 255,
];
const u16 = (n: number) => [n & 255, (n >> 8) & 255];
const fmtN = (n: number) => n.toLocaleString('en-US');

const SOUND_BYTES = 25600; // 0.8 s at 16 kHz, 16-bit, mono
const PLAIN_DATA = 44;
const PADDED_DATA = 4096;
const JUNK_SIZE = 28;
const FLLR_SIZE = PADDED_DATA - 8 - (12 + 8 + JUNK_SIZE + 8 + 16 + 8); // 4,008

const fmtChunk = (): Field[] => [
  {
    id: 'fmt',
    name: '"fmt " chunk ID',
    kind: 'tag',
    bytes: ascii('fmt '),
    value: '"fmt "',
    text: 'Start of the format chunk. Note the trailing space: every chunk name is exactly four bytes.',
  },
  {
    id: 'fmtsize',
    name: 'fmt chunk size',
    kind: 'size',
    bytes: u32(16),
    le: true,
    value: '16 bytes',
    text: 'The format chunk body is 16 bytes long, the size for plain PCM.',
  },
  {
    id: 'pcm',
    name: 'audio format',
    kind: 'fmt',
    bytes: u16(1),
    le: true,
    value: '1 = PCM',
    text: 'Uncompressed integer samples.',
  },
  {
    id: 'ch',
    name: 'channels',
    kind: 'fmt',
    bytes: u16(1),
    le: true,
    value: '1 = mono',
    text: 'One microphone channel.',
  },
  {
    id: 'rate',
    name: 'sample rate',
    kind: 'fmt',
    bytes: u32(16000),
    le: true,
    value: '16,000 Hz',
    text: 'Samples per second, the rate the speech service expects.',
  },
  {
    id: 'brate',
    name: 'byte rate',
    kind: 'fmt',
    bytes: u32(32000),
    le: true,
    value: '32,000 B/s',
    text: 'sample rate × channels × 2 bytes: one second of this sound is 32,000 bytes.',
  },
  {
    id: 'align',
    name: 'block align',
    kind: 'fmt',
    bytes: u16(2),
    le: true,
    value: '2 bytes',
    text: 'Bytes per frame: one 16-bit sample for one channel.',
  },
  {
    id: 'bits',
    name: 'bits per sample',
    kind: 'fmt',
    bytes: u16(16),
    le: true,
    value: '16 bits',
    text: 'Each sample is a signed 16-bit integer.',
  },
];
const dataChunk = (): Field[] => [
  {
    id: 'data',
    name: '"data" chunk ID',
    kind: 'tag',
    bytes: ascii('data'),
    value: '"data"',
    text: 'The four letters the parser is hunting for. The sound starts right after this chunk’s size.',
  },
  {
    id: 'datasize',
    name: 'data chunk size',
    kind: 'size',
    bytes: u32(SOUND_BYTES),
    le: true,
    value: `${fmtN(SOUND_BYTES)} bytes`,
    text: 'Exactly how many bytes of sound follow: 12,800 samples, 0.8 s at 16 kHz.',
  },
];
const riff = (total: number): Field[] => [
  {
    id: 'riff',
    name: '"RIFF" tag',
    kind: 'tag',
    bytes: ascii('RIFF'),
    value: '"RIFF"',
    text: 'Magic word: this is a RIFF container. The parser rejects the file if it is missing.',
  },
  {
    id: 'riffsize',
    name: 'RIFF size',
    kind: 'size',
    bytes: u32(total - 8),
    le: true,
    value: `${fmtN(total - 8)} bytes`,
    text: `Everything after these first 8 bytes: the file is ${fmtN(total)} bytes long.`,
  },
  {
    id: 'wave',
    name: '"WAVE" tag',
    kind: 'tag',
    bytes: ascii('WAVE'),
    value: '"WAVE"',
    text: 'Form type. The code checks bytes 8 to 11 for it before trusting anything else.',
  },
];

// Ten 16-bit samples of a quiet voiced sound, little-endian.
const samples = Array.from({ length: 10 }, (_, i) =>
  Math.round(2400 * Math.sin(i * 0.9) + 700 * Math.sin(i * 2.3 + 0.4)),
);
const soundFields = (start: number, count: number): Field[] =>
  samples.slice(0, count).map((s, i) => ({
    id: `s${i}`,
    name: `sample ${i}`,
    kind: 'sound' as Kind,
    bytes: u16(s & 0xffff),
    value: `${s < 0 ? '−' : '+'}${fmtN(Math.abs(s))}`,
    text: `PCM sample at byte ${fmtN(start + i * 2)}: two bytes, low byte first, read as a signed 16-bit integer.`,
  }));

const plainFields: Field[] = [
  ...riff(PLAIN_DATA + SOUND_BYTES),
  ...fmtChunk(),
  ...dataChunk(),
];
const paddedFields: Field[] = [
  ...riff(PADDED_DATA + SOUND_BYTES),
  {
    id: 'junk',
    name: '"JUNK" chunk ID',
    kind: 'tag',
    bytes: ascii('JUNK'),
    value: '"JUNK"',
    text: 'A placeholder chunk. Nothing in it is sound; the parser reads its size and skips it.',
  },
  {
    id: 'junksize',
    name: 'JUNK size',
    kind: 'size',
    bytes: u32(JUNK_SIZE),
    le: true,
    value: `${JUNK_SIZE} bytes`,
    text: 'Skip this many bytes to reach the next chunk.',
  },
  {
    id: 'junkbody',
    name: 'JUNK body',
    kind: 'pad',
    bytes: new Array(JUNK_SIZE).fill(0),
    value: `${JUNK_SIZE} zero bytes`,
    text: 'Reserved space, all zeros, so the file can switch to 64-bit sizes if it ever passes 4 GB. A fixed “drop 44 bytes” cut lands in the middle of it.',
  },
  ...fmtChunk(),
  {
    id: 'fllr',
    name: '"FLLR" chunk ID',
    kind: 'tag',
    bytes: ascii('FLLR'),
    value: '"FLLR"',
    text: 'Filler: padding that pushes the sound to a round offset.',
  },
  {
    id: 'fllrsize',
    name: 'FLLR size',
    kind: 'size',
    bytes: u32(FLLR_SIZE),
    le: true,
    value: `${fmtN(FLLR_SIZE)} bytes`,
    text: 'Skip this many bytes. It is chosen so the sound lands exactly at 4,096.',
  },
  {
    id: 'fllrbody',
    name: 'FLLR body',
    kind: 'pad',
    bytes: new Array(FLLR_SIZE).fill(0),
    value: `${fmtN(FLLR_SIZE)} zero bytes`,
    text: 'Pure padding, all zeros. Sent as sound, it would add about an eighth of a second of silence to every chunk.',
  },
  ...dataChunk(),
];

interface Byte {
  off: number;
  b: number;
  f: number;
}
interface Seg {
  f: number;
  bytes: Byte[];
}
type Row =
  | {
      type: 'bytes';
      off: number;
      segs: Seg[];
      ascii: { c: string; f: number }[];
    }
  | { type: 'gap'; text: string };

/** Lay a header + sound out as 16-byte rows, keeping only the listed row offsets. */
function layout(header: Field[], dataStart: number, soundRows: number) {
  const soundCount = Math.min(
    samples.length,
    (soundRows * 16 - (dataStart % 16)) / 2,
  );
  const all = [...header, ...soundFields(dataStart, soundCount)];
  const bytes: Byte[] = [];
  all.forEach((field, f) =>
    field.bytes.forEach((b) => bytes.push({ off: bytes.length, b, f })),
  );
  const fields = all.map((field, f) => {
    const start = bytes.findIndex((x) => x.f === f);
    return { ...field, start, end: start + field.bytes.length - 1 };
  });
  return { bytes, fields, total: dataStart + SOUND_BYTES };
}

function rowsFor(
  bytes: Byte[],
  keep: number[],
  gaps: Record<number, string>,
): Row[] {
  const rows: Row[] = [];
  keep.forEach((off) => {
    if (gaps[off]) rows.push({ type: 'gap', text: gaps[off] });
    const slice = bytes.slice(off, off + 16);
    const segs: Seg[] = [];
    slice.forEach((x) => {
      // Split at the 8-byte mark too, so a row can fold into 2 × 8 on phones.
      const last = segs[segs.length - 1];
      if (last && last.f === x.f && x.off % 8 !== 0) last.bytes.push(x);
      else segs.push({ f: x.f, bytes: [x] });
    });
    rows.push({
      type: 'bytes',
      off,
      segs,
      ascii: slice.map((x) => ({
        c: x.b >= 32 && x.b < 127 ? String.fromCharCode(x.b) : '.',
        f: x.f,
      })),
    });
  });
  return rows;
}

const plain = layout(plainFields, PLAIN_DATA, 2);
const plainShown = PLAIN_DATA + samples.length * 2; // 64
const plainRows = [
  ...rowsFor(plain.bytes, [0, 16, 32, 48], {}),
  {
    type: 'gap',
    text: `${fmtN(SOUND_BYTES - (plainShown - PLAIN_DATA))} more bytes of sound, to offset ${fmtN(plain.total - 1)}`,
  } as Row,
];

const padded = layout(paddedFields, PADDED_DATA, 1);
const paddedShown = PADDED_DATA + 16;
const paddedRows = [
  ...rowsFor(padded.bytes, [0, 16, 32, 48, 64, 80, 4080, 4096], {
    4080: `${fmtN(4080 - 96)} more FLLR padding bytes, offsets 96 to 4,079`,
  }),
  {
    type: 'gap',
    text: `${fmtN(SOUND_BYTES - (paddedShown - PADDED_DATA))} more bytes of sound, to offset ${fmtN(padded.total - 1)}`,
  } as Row,
];

const hex = (b: number) => b.toString(16).toUpperCase().padStart(2, '0');

/** What the detail panel needs for one field (padding bodies are summarised, not listed). */
const detailOf = (f: ReturnType<typeof layout>['fields'][number]) => {
  const shown =
    f.bytes.length > 8
      ? [...f.bytes.slice(0, 4).map(hex), '…']
      : f.bytes.map(hex);
  let read = '';
  if (f.kind === 'tag') read = `ASCII ${f.value}`;
  else if (f.kind === 'pad') read = 'skipped';
  else if (f.kind === 'sound')
    read = `0x${[...f.bytes].reverse().map(hex).join('')}`;
  else read = `0x${[...f.bytes].reverse().map(hex).join('')}`;
  return {
    name: f.name,
    kind: f.kind,
    range:
      f.start === f.end
        ? `byte ${fmtN(f.start)}`
        : `bytes ${fmtN(f.start)}–${fmtN(f.end)}`,
    raw: shown.join(' '),
    read,
    value: f.value,
    text: f.text,
  };
};

// Parser walk: each hop reads a chunk ID and its size, then jumps.
type Laid = ReturnType<typeof layout>['fields'];
function walk(fields: Laid) {
  const hops: { ids: string[]; body: string[]; text: string }[] = [
    {
      ids: ['riff', 'wave'],
      body: [],
      text: 'Check the magic words: "RIFF" at 0 and "WAVE" at 8. Then start at offset 12.',
    },
  ];
  let off = 12;
  while (off + 8 <= fields[fields.length - 1].end + 1) {
    const tag = fields.find((f) => f.start === off);
    const sizeField = fields.find((f) => f.start === off + 4);
    if (!tag || !sizeField) break;
    const [b0, b1, b2, b3] = sizeField.bytes;
    const size = (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) >>> 0;
    const name = String.fromCharCode(...tag.bytes);
    const start = off + 8;
    const body = fields
      .filter((f) => f.start >= start && f.start < start + size)
      .map((f) => f.id);
    if (name === 'data') {
      hops.push({
        ids: [tag.id, sizeField.id],
        body,
        text: `offset ${fmtN(off)}: "data", size ${fmtN(size)}. Found it: take ${fmtN(size)} bytes from offset ${fmtN(start)}, an even count, so every 16-bit sample stays whole.`,
      });
      break;
    }
    const next = start + size + (size & 1);
    hops.push({
      ids: [tag.id, sizeField.id],
      body,
      text: `offset ${fmtN(off)}: "${name}", size ${fmtN(size)}. Not data, so hop to ${fmtN(off)} + 8 + ${fmtN(size)} = ${fmtN(next)}.`,
    });
    off = next;
  }
  return hops;
}

const variants = {
  plain: {
    fields: plain.fields.map(detailOf),
    ids: plain.fields.map((f) => f.id),
    walk: walk(plain.fields),
    data: PLAIN_DATA,
  },
  padded: {
    fields: padded.fields.map(detailOf),
    ids: padded.fields.map((f) => f.id),
    walk: walk(padded.fields),
    data: PADDED_DATA,
  },
};

const plainLookup = plain.fields;
const paddedLookup = padded.fields;
---

<VizFrame
  fig="07"
  title="The WAV header, byte by byte"
  caption={caption}
  class="wbm"
  data-wbm
>
  <div slot="tools" class="wbm__tools">
    <span class="viz-chip viz-chip--sound" data-chip>sound @ 4,096</span>
    <AnimControls label="Chunk walk" />
  </div>

  <div class="wbm__bar">
    <div class="viz-seg" role="group" aria-label="Header layout">
      <button type="button" aria-pressed="false" data-variant="plain"
        >textbook 44-byte</button
      >
      <button type="button" aria-pressed="true" data-variant="padded"
        >AVAudioFile 4,096</button
      >
    </div>
  </div>

  <div class="wbm__dumpwrap">
    {
      (['plain', 'padded'] as const).map((v) => {
        const rows = v === 'plain' ? plainRows : paddedRows;
        const lookup = v === 'plain' ? plainLookup : paddedLookup;
        return (
          <div
            class="wbm__dump viz-panel"
            data-dump={v}
            hidden={v !== 'padded'}
            role="group"
            aria-label={
              v === 'plain'
                ? 'Hex dump of a plain 44-byte header'
                : 'Hex dump of a padded header'
            }
          >
            <div class="wbm__head" aria-hidden="true">
              <span>offset</span>
              <span class="wbm__colnums">
                {Array.from({ length: 16 }, (_, k) => (
                  <span>{hex(k).slice(1)}</span>
                ))}
              </span>
              <span class="wbm__ascii">ascii</span>
            </div>
            {rows.map((row) =>
              row.type === 'gap' ? (
                <div class="wbm__gap">
                  <span>⋮</span>
                  <span>{row.text}</span>
                </div>
              ) : (
                <div class="wbm__row">
                  <span class="wbm__off">{row.off}</span>
                  <span class="wbm__hex">
                    {row.segs.map((seg) => {
                      const field = lookup[seg.f];
                      return (
                        <button
                          type="button"
                          class={`wbm__f wbm__f--${field.kind}`}
                          style={`--n:${seg.bytes.length}`}
                          data-f={seg.f}
                          tabindex="-1"
                          aria-label={`${field.name}, ${field.value}`}
                        >
                          {seg.bytes.map((x) => (
                            <span
                              class:list={[
                                'wbm__b',
                                {
                                  'is-cut':
                                    v === 'padded' && x.off === PLAIN_DATA,
                                },
                              ]}
                            >
                              {hex(x.b)}
                            </span>
                          ))}
                        </button>
                      );
                    })}
                  </span>
                  <span class="wbm__ascii" aria-hidden="true">
                    {row.ascii.map((a) => (
                      <span data-af={a.f}>{a.c}</span>
                    ))}
                  </span>
                </div>
              ),
            )}
          </div>
        );
      })
    }
  </div>

  <div class="viz-legend wbm__legend">
    <span><i style="--c:var(--viz-meta)"></i>chunk tag</span>
    <span
      ><i style="--c:color-mix(in srgb, var(--viz-meta) 45%, transparent)"
      ></i>size or format field</span
    >
    <span><i style="--c:var(--fg-faint)"></i>padding</span>
    <span><i style="--c:var(--viz-sound)"></i>sound (PCM)</span>
    <span class="wbm__cutkey" data-cutkey
      ><i style="--c:var(--viz-bad)"></i>a fixed 44-byte cut</span
    >
  </div>

  <div class="wbm__detail viz-panel" data-detail aria-live="polite">
    <div class="wbm__dtop">
      <span class="wbm__dname" data-d-name></span>
      <span class="viz-chip" data-d-range></span>
    </div>
    <dl class="wbm__dl">
      <div>
        <dt class="viz-label">raw bytes</dt><dd class="viz-mono" data-d-raw>
        </dd>
      </div>
      <div>
        <dt class="viz-label">read as</dt><dd class="viz-mono" data-d-read></dd>
      </div>
      <div>
        <dt class="viz-label">value</dt><dd class="viz-mono" data-d-value></dd>
      </div>
    </dl>
    <span class="wbm__dtext" data-d-text></span>
  </div>

  <div class="wbm__walk viz-mono" data-walklog hidden aria-live="polite"></div>

  <div class="wbm__bug">
    <span class="viz-chip viz-chip--bad">clicking bug</span>
    <span
      >Every chunk went out with these bytes in front. Decoded as sound at each
      chunk boundary, they clicked. The fix sends only the data bytes; the
      handshake already says 16,000 Hz, 2 bytes per sample, 1 channel.</span
    >
  </div>

  <script
    type="application/json"
    data-variants
    set:html={JSON.stringify(variants)}
  />
</VizFrame>

<script is:inline>
  (() => {
    function initWavByteMap() {
      const root = document.querySelector('[data-wbm]');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const data = JSON.parse(
        root.querySelector('[data-variants]').textContent,
      );
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const chip = root.querySelector('[data-chip]');
      const segBtns = [...root.querySelectorAll('[data-variant]')];
      const walkLog = root.querySelector('[data-walklog]');
      const cutKey = root.querySelector('[data-cutkey]');
      const out = {
        name: root.querySelector('[data-d-name]'),
        range: root.querySelector('[data-d-range]'),
        raw: root.querySelector('[data-d-raw]'),
        read: root.querySelector('[data-d-read]'),
        value: root.querySelector('[data-d-value]'),
        text: root.querySelector('[data-d-text]'),
      };
      const KIND_CHIP = {
        tag: 'meta',
        size: 'meta',
        fmt: 'meta',
        pad: '',
        sound: 'sound',
      };
      const LEAD_MS = 400;
      const STEP_MS = 1500;

      let variant = 'padded';
      let active = 0;
      // Parser walk: hops on screen, and the time left to the next one.
      let hop = 0;
      let playing = false;
      let timer = 0;
      let due = 0;
      let left = LEAD_MS;

      const dump = () => root.querySelector(`[data-dump="${variant}"]`);
      const buttons = () => [...dump().querySelectorAll('[data-f]')];
      const hops = () => data[variant].walk;
      const fieldIndex = (id) => data[variant].ids.indexOf(id);
      // The field the detail panel rests on before the walk runs.
      const restField = () => fieldIndex(variant === 'plain' ? 'data' : 'fllr');

      function mark(cls, set) {
        dump()
          .querySelectorAll(`.${cls}`)
          .forEach((el) => el.classList.remove(cls));
        set.forEach((f) =>
          dump()
            .querySelectorAll(`[data-f="${f}"], [data-af="${f}"]`)
            .forEach((el) => el.classList.add(cls)),
        );
      }

      function show(f) {
        active = f;
        const d = data[variant].fields[f];
        out.name.textContent = d.name;
        out.range.textContent = d.range;
        out.range.className = `viz-chip${KIND_CHIP[d.kind] ? ` viz-chip--${KIND_CHIP[d.kind]}` : ''}`;
        out.raw.textContent = d.raw;
        out.read.textContent = d.read;
        out.value.textContent = d.value;
        out.text.textContent = d.text;
        mark('is-on', [f]);
        const btns = buttons();
        btns.forEach((b) => (b.tabIndex = -1));
        const first = btns.find((b) => +b.dataset.f === f);
        if (first) first.tabIndex = 0;
      }

      function renderHop(h) {
        const step = hops()[h];
        const hopSet = step.ids.map(fieldIndex).filter((i) => i >= 0);
        const bodySet = step.body.map(fieldIndex).filter((i) => i >= 0);
        mark('is-hop', hopSet);
        mark('is-body', bodySet);
        const line = document.createElement('div');
        line.className = h === hops().length - 1 ? 'is-found' : '';
        line.textContent = `${h + 1}. ${step.text}`;
        walkLog
          .querySelectorAll('div')
          .forEach((el) => el.classList.add('is-past'));
        walkLog.appendChild(line);
        walkLog.hidden = false;
        if (hopSet[0] !== undefined) show(hopSet[0]);
      }

      function clearWalk() {
        playing = false;
        clearTimeout(timer);
        hop = 0;
        left = LEAD_MS;
        mark('is-hop', []);
        mark('is-body', []);
        walkLog.hidden = true;
        walkLog.innerHTML = '';
      }

      function schedule(delay) {
        clearTimeout(timer);
        due = performance.now() + delay;
        timer = setTimeout(() => {
          renderHop(hop);
          hop += 1;
          if (hop < hops().length) {
            schedule(STEP_MS);
            return;
          }
          playing = false;
          root.dispatchEvent(new CustomEvent('anim:ended'));
        }, delay);
      }

      function play() {
        if (playing) return;
        // Reduced motion lands the whole walk at once.
        if (reduce) {
          while (hop < hops().length) renderHop(hop++);
        }
        if (hop >= hops().length) {
          root.dispatchEvent(new CustomEvent('anim:ended'));
          return;
        }
        playing = true;
        schedule(left);
      }

      function pause() {
        if (!playing) return;
        playing = false;
        clearTimeout(timer);
        left = Math.max(0, due - performance.now());
      }

      function reset() {
        clearWalk();
        show(restField());
      }

      function setVariant(v) {
        if (v === variant) return;
        clearWalk();
        variant = v;
        segBtns.forEach((b) =>
          b.setAttribute('aria-pressed', String(b.dataset.variant === v)),
        );
        root
          .querySelectorAll('[data-dump]')
          .forEach((el) => (el.hidden = el.dataset.dump !== v));
        chip.textContent = `sound @ ${data[v].data.toLocaleString('en-US')}`;
        cutKey.hidden = v !== 'padded';
        show(restField());
        // A new layout replays the walk over it; reduced motion only swaps it.
        if (reduce) return;
        root.dispatchEvent(new CustomEvent('anim:started'));
        play();
      }

      segBtns.forEach((b) =>
        b.addEventListener('click', () => setVariant(b.dataset.variant)),
      );

      root.querySelectorAll('[data-dump]').forEach((d) => {
        d.addEventListener('mouseover', (e) => {
          const b = e.target.closest('[data-f]');
          if (b) show(+b.dataset.f);
        });
        d.addEventListener('focusin', (e) => {
          const b = e.target.closest('[data-f]');
          if (b) show(+b.dataset.f);
        });
        d.addEventListener('click', (e) => {
          const b = e.target.closest('[data-f]');
          if (b) show(+b.dataset.f);
        });
        d.addEventListener('keydown', (e) => {
          const keys = {
            ArrowRight: 1,
            ArrowDown: 1,
            ArrowLeft: -1,
            ArrowUp: -1,
          };
          if (!(e.key in keys) && e.key !== 'Home' && e.key !== 'End') return;
          e.preventDefault();
          const count = data[variant].fields.length;
          let next = active + (keys[e.key] || 0);
          if (e.key === 'Home') next = 0;
          if (e.key === 'End') next = count - 1;
          next = Math.max(0, Math.min(count - 1, next));
          show(next);
          const target = buttons().find((x) => +x.dataset.f === next);
          if (target) target.focus();
        });
      });

      show(restField());

      (window.animQueue = window.animQueue || []).push({
        root,
        play,
        pause,
        reset,
      });
    }
    if (document.readyState !== 'loading') initWavByteMap();
    else document.addEventListener('DOMContentLoaded', initWavByteMap);
  })();
</script>

