---
/**
 * Voice-message bubble driven by the same pipeline as the app: each audio
 * buffer becomes 100 RMS slices, and every 0.2 s the view appends the newest
 * slice as a bar on the right while the oldest slides off the left.
 *
 * Playback is one 10 s take that fills the ribbon once: a simulated voice
 * speaking the preview sentence, or the reader's microphone when they tap it.
 */
import VizFrame from './viz/VizFrame.astro';
import AnimControls from './viz/AnimControls.astro';

interface Props {
  caption?: string;
}
const {
  caption = 'The same pipeline as the app: each audio buffer becomes 100 RMS slices, and every 0.2 s the view takes the newest one and appends it as a bar. Levels are boosted here so a laptop microphone shows clearly.',
} = Astro.props;

const BARS = 50;
// A static, deterministic "spoken sentence" shown before the demo starts.
const preview = Array.from({ length: BARS }, (_, i) => {
  const t = i / (BARS - 1);
  const noise = 0.6 + 0.4 * Math.abs((Math.sin(i * 12.9898) * 43758.5453) % 1);
  const syllables = Math.pow(
    Math.max(0, Math.sin(t * Math.PI * 7.5 + 0.4)),
    0.6,
  );
  const phrase = 0.55 + 0.45 * Math.sin(t * Math.PI * 1.6 + 0.3);
  return Math.min(1, 0.1 + 0.8 * syllables * phrase * noise);
});
---

<VizFrame
  fig="04"
  title="Live voice ribbon"
  caption={caption}
  class="vw"
  data-vw
>
  <div slot="tools" class="vw__tools">
    <span class="viz-chip" data-mode>idle</span>
    <AnimControls />
  </div>

  <div class="vw__chat">
    <span class="viz-label vw__who">You · voice message</span>
    <div class="vw__bubble">
      <button
        type="button"
        class="vw__btn"
        data-btn
        aria-pressed="false"
        aria-label="Start listening"
      >
        <svg
          class="vw__icon vw__icon--mic"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path
            d="M12 15a3.5 3.5 0 0 0 3.5-3.5v-6a3.5 3.5 0 0 0-7 0v6A3.5 3.5 0 0 0 12 15Zm6-3.5a6 6 0 0 1-12 0H4.5a7.5 7.5 0 0 0 6.75 7.46V22h1.5v-3.04A7.5 7.5 0 0 0 19.5 11.5H18Z"
          ></path></svg
        >
        <svg
          class="vw__icon vw__icon--stop"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><rect x="6" y="6" width="12" height="12" rx="2.5"></rect></svg
        >
      </button>
      <div class="vw__main">
        <div class="vw__ribbon">
          <canvas
            class="vw__canvas"
            data-canvas
            role="img"
            aria-label="Live voice level bars, newest on the right"></canvas>
          <div class="vw__preview" data-preview aria-hidden="true">
            {preview.map((v) => <i style={`--h:${v.toFixed(3)}`} />)}
          </div>
        </div>
        <div class="vw__meta">
          <span class="vw__time viz-mono" data-time>0:00</span>
          <span class="vw__rms viz-mono" aria-live="off">
            rms <b data-rms>0.000</b>
            <span class="vw__meter" aria-hidden="true"
              ><span data-rms-bar></span></span
            >
          </span>
        </div>
      </div>
    </div>
  </div>

  <p class="vw__status viz-mono" data-status role="status">
    <span class="viz-dot" aria-hidden="true"></span><span data-status-text
      >tap the microphone to listen</span
    >
  </p>
  <div class="vw__facts viz-legend" aria-hidden="true">
    <span><i style="--c:var(--viz-level)"></i>one bar per 0.2 s</span>
    <span>50 bars ≈ 10 s</span>
    <span>100 slices per buffer, newest kept</span>
  </div>
</VizFrame>

<script is:inline>
  (() => {
    function initVoiceWaves() {
      const root = document.querySelector('[data-vw]');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const btn = root.querySelector('[data-btn]');
      const canvas = root.querySelector('[data-canvas]');
      const preview = root.querySelector('[data-preview]');
      const timeEl = root.querySelector('[data-time]');
      const rmsEl = root.querySelector('[data-rms]');
      const rmsBar = root.querySelector('[data-rms-bar]');
      const statusText = root.querySelector('[data-status-text]');
      const mode = root.querySelector('[data-mode]');
      const ctx = canvas.getContext('2d');
      if (!ctx) return;

      const BARS = 50; // bars on screen: 10 s of history at one bar per tick
      const SEGMENTS = 100; // slices per buffer, as in the recorder
      const TICK_MS = 200; // the view appends one bar every 0.2 s, as in the app
      const DISPLAY_GAIN = 4; // browser microphones run quieter than an iPhone's
      const FLOOR = 0.03;
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const idleText = statusText.textContent;
      // The simulated voice speaks the preview sentence, so its take ends on it.
      const sentence = [...preview.children].map(
        (bar) => parseFloat(bar.style.getPropertyValue('--h')) || FLOOR,
      );
      // One take is BARS ticks: the ribbon fills once, then the take ends.
      const Take = Object.freeze({
        None: 'none',
        Opening: 'opening', // waiting for the microphone
        Rolling: 'rolling',
        Done: 'done',
      });

      // BARS + 1 values: index 0 is the bar sliding out on the left.
      const levels = new Array(BARS + 1).fill(FLOOR);
      let W = 0;
      let H = 0;
      let color = '';
      let drawing = false;
      let raf = 0;
      let stream = null;
      let ac = null;
      let analyser = null;
      let sampleBuf = null;
      let take = Take.None;
      let useMic = false; // this take listens to the microphone, not the sentence
      let playing = false;
      let ticks = 0;
      let tickTimer = 0;
      let lastPush = 0;
      let heldMs = 0; // how far into the current tick a pause stopped
      let session = 0;

      const readColor = () => {
        color =
          getComputedStyle(root).getPropertyValue('--viz-level').trim() ||
          'orange';
      };
      function size() {
        W = canvas.clientWidth || 400;
        H = canvas.clientHeight || 56;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      // How far the newest bar has slid in: 0 just appended, 1 in place.
      function slide() {
        if (reduce || take !== Take.Rolling) return 1;
        const ms = playing ? performance.now() - lastPush : heldMs;
        return Math.min(1, ms / TICK_MS);
      }
      function draw() {
        const p = slide();
        const step = W / BARS;
        const bw = Math.max(2, step * 0.56);
        const mid = H / 2;
        ctx.clearRect(0, 0, W, H);
        ctx.fillStyle = color;
        for (let i = 0; i <= BARS; i++) {
          const x = (i - p) * step + (step - bw) / 2;
          if (x + bw < 0 || x > W) continue;
          const h = Math.max(3, levels[i] * (H - 4));
          ctx.globalAlpha = 0.35 + 0.65 * Math.max(0, (i - p) / (BARS - 1));
          ctx.beginPath();
          ctx.roundRect(x, mid - h / 2, bw, h, bw / 2);
          ctx.fill();
        }
        ctx.globalAlpha = 1;
      }
      function frame() {
        if (!drawing) return;
        draw();
        raf = requestAnimationFrame(frame);
      }
      function setDrawing(on) {
        const want = on && !reduce;
        if (want === drawing) return;
        drawing = want;
        cancelAnimationFrame(raf);
        if (want) raf = requestAnimationFrame(frame);
      }

      function showRms(rms) {
        rmsEl.textContent = rms.toFixed(3);
        rmsBar.style.width = `${Math.min(1, rms * DISPLAY_GAIN) * 100}%`;
      }
      function showTime() {
        const secs = Math.floor((ticks * TICK_MS) / 1000);
        timeEl.textContent = `${Math.floor(secs / 60)}:${String(secs % 60).padStart(2, '0')}`;
      }
      function push(level) {
        levels.push(level);
        levels.shift();
        lastPush = performance.now();
        if (!drawing) draw();
      }

      // One buffer of samples -> 100 RMS slices (the recorder's batch) -> the view takes the newest slice.
      function pushFromSamples(buf) {
        const seg = Math.floor(buf.length / SEGMENTS);
        if (seg < 1) return;
        const batch = [];
        for (let s = 0; s < SEGMENTS; s++) {
          let acc = 0;
          for (let k = 0; k < seg; k++) acc += buf[s * seg + k] ** 2;
          batch.push(Math.sqrt(acc / seg));
        }
        const rms = batch[SEGMENTS - 1];
        const level = Math.min(Math.max(1.1 * rms, 0), 1);
        showRms(rms);
        push(Math.max(FLOOR, Math.min(1, level * DISPLAY_GAIN)));
      }

      function speak() {
        const v = sentence[ticks] ?? FLOOR;
        showRms(v / (1.1 * DISPLAY_GAIN));
        push(v);
      }

      function tick() {
        if (ticks >= BARS) {
          finish();
          return;
        }
        if (analyser && sampleBuf) {
          analyser.getFloatTimeDomainData(sampleBuf);
          pushFromSamples(sampleBuf);
        } else speak();
        ticks += 1;
        showTime();
        tickTimer = setTimeout(tick, TICK_MS);
      }

      function setStatus(text, kind) {
        statusText.textContent = text;
        mode.textContent = kind;
        mode.classList.toggle('viz-chip--level', kind === 'live mic');
        mode.classList.toggle('viz-chip--meta', kind === 'simulated');
      }
      function setListening(on) {
        btn.classList.toggle('is-on', on);
        btn.setAttribute('aria-pressed', String(on));
        btn.setAttribute(
          'aria-label',
          on ? 'Stop listening' : 'Start listening',
        );
      }

      function closeMic() {
        stream?.getTracks().forEach((t) => t.stop());
        ac?.close();
        stream = ac = analyser = sampleBuf = null;
      }
      // Also cancels a microphone request that has not been answered yet.
      function release() {
        session++;
        closeMic();
        setListening(false);
      }

      // Starts the tick clock, or resumes it where the current tick stood.
      function roll() {
        clearTimeout(tickTimer);
        lastPush = performance.now() - heldMs;
        tickTimer = setTimeout(tick, TICK_MS - heldMs);
        heldMs = 0;
        setDrawing(true);
      }

      async function openMic() {
        const id = ++session;
        setListening(true);
        setStatus('asking for the microphone…', 'starting');
        try {
          if (!navigator.mediaDevices?.getUserMedia)
            throw new Error('no microphone API');
          const s = await navigator.mediaDevices.getUserMedia({ audio: true });
          if (id !== session) {
            s.getTracks().forEach((t) => t.stop());
            return;
          }
          stream = s;
          ac = new (window.AudioContext || window.webkitAudioContext)();
          const src = ac.createMediaStreamSource(stream);
          analyser = ac.createAnalyser();
          analyser.fftSize = 2048;
          sampleBuf = new Float32Array(analyser.fftSize);
          src.connect(analyser);
          setStatus(
            'listening to your microphone, processed on this device only',
            'live mic',
          );
        } catch {
          if (id !== session) return;
          closeMic();
          setStatus(
            'microphone unavailable here, playing a simulated voice',
            'simulated',
          );
        }
        take = Take.Rolling;
        if (playing) roll();
      }

      function startTake() {
        take = Take.Opening;
        preview.hidden = true;
        if (useMic) {
          openMic();
          return;
        }
        setStatus(
          'playing a simulated voice, tap the microphone to use yours',
          'simulated',
        );
        take = Take.Rolling;
        roll();
      }

      function finish() {
        const wasMic = Boolean(stream) || take === Take.Opening;
        playing = false;
        take = Take.Done;
        clearTimeout(tickTimer);
        setDrawing(false);
        release();
        setStatus(
          wasMic
            ? 'stopped, microphone released. Tap to listen again'
            : 'simulated voice, one bar per 0.2 s. Tap the microphone to use yours',
          'idle',
        );
        draw();
        root.dispatchEvent(new CustomEvent('anim:ended'));
      }

      function play() {
        if (take === Take.Done) {
          root.dispatchEvent(new CustomEvent('anim:ended'));
          return;
        }
        playing = true;
        if (take === Take.None) startTake();
        else if (take === Take.Rolling) roll();
        // Opening: the pending microphone request rolls once it is answered.
      }

      function pause() {
        if (!playing) return;
        playing = false;
        clearTimeout(tickTimer);
        if (take === Take.Rolling)
          heldMs = Math.min(TICK_MS, performance.now() - lastPush);
        setDrawing(false);
        draw();
      }

      function reset() {
        playing = false;
        clearTimeout(tickTimer);
        setDrawing(false);
        release();
        useMic = false;
        take = Take.None;
        ticks = 0;
        heldMs = 0;
        levels.fill(FLOOR);
        preview.hidden = false;
        showRms(0);
        showTime();
        setStatus(idleText, 'idle');
        draw();
      }

      const listening = () =>
        useMic && (take === Take.Opening || take === Take.Rolling);

      // Only this button opens the microphone: it records a live take, or
      // ends the one under way. Replay and restart run the simulated voice.
      btn.addEventListener('click', () => {
        if (listening()) {
          finish();
          return;
        }
        reset();
        useMic = true;
        root.dispatchEvent(new CustomEvent('anim:started'));
        play();
      });
      window.addEventListener('pagehide', () => listening() && finish());

      const redraw = () => {
        size();
        draw();
      };
      if ('ResizeObserver' in window)
        new ResizeObserver(redraw).observe(canvas);
      else window.addEventListener('resize', redraw);
      new MutationObserver(() => {
        readColor();
        draw();
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'class'],
      });

      readColor();
      size();
      draw();

      (window.animQueue = window.animQueue || []).push({
        root,
        play,
        pause,
        reset,
      });
    }
    if (document.readyState !== 'loading') initVoiceWaves();
    else document.addEventListener('DOMContentLoaded', initVoiceWaves);
  })();
</script>

<style>
  .vw__tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .vw__chat {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 6px;
  }
  .vw__who {
    align-self: flex-end;
    padding-right: 6px;
  }
  .vw__bubble {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    width: 100%;
    padding: 10px var(--sp-5) 10px 10px;
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 999px;
  }
  .vw__btn {
    position: relative;
    flex: none;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    color: var(--accent-fg);
    background: var(--accent);
    border: 0;
    border-radius: 50%;
    cursor: pointer;
    transition:
      transform 0.15s var(--ease),
      background 0.15s var(--ease);
  }
  .vw__btn:hover {
    transform: scale(1.05);
  }
  .vw__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .vw__icon {
    grid-area: 1 / 1;
    width: 20px;
    height: 20px;
    fill: currentColor;
  }
  .vw__icon--stop,
  .vw__btn.is-on .vw__icon--mic {
    display: none;
  }
  .vw__btn.is-on .vw__icon--stop {
    display: block;
  }
  .vw__btn.is-on {
    color: var(--surface);
    background: var(--viz-level);
  }
  .vw__btn.is-on::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
  }
  /* The ring pulses only while a live take is actually recording. */
  :global(.vw[data-anim-state='playing']) .vw__btn.is-on::after {
    animation: vw-pulse 1.4s ease-out infinite;
  }

  /* Ribbon and readouts side by side, so the waves sit on the pill's centre line. */
  .vw__main {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }
  .vw__ribbon {
    position: relative;
    flex: 1 1 auto;
    min-width: 0;
    height: 48px;
  }
  .vw__canvas {
    display: block;
    width: 100%;
    height: 100%;
  }
  .vw__preview {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    gap: 0;
  }
  .vw__ribbon:has(.vw__preview:not([hidden])) .vw__canvas {
    visibility: hidden;
  }
  .vw__preview[hidden] {
    display: none;
  }
  .vw__preview i {
    flex: 1 1 0;
    display: flex;
    justify-content: center;
    height: 100%;
    align-items: center;
  }
  .vw__preview i::before {
    content: '';
    width: 56%;
    min-width: 2px;
    height: max(3px, calc(var(--h) * 100% - 4px));
    border-radius: 99px;
    background: var(--viz-level);
    opacity: 0.35;
  }

  .vw__meta {
    flex: none;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 4px;
  }
  .vw__time {
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
  }
  .vw__rms {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--fg-faint);
  }
  .vw__rms b {
    color: var(--viz-level);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .vw__meter {
    position: relative;
    width: 44px;
    height: 6px;
    overflow: hidden;
    background: color-mix(in srgb, var(--viz-level) 14%, transparent);
    border-radius: 99px;
  }
  .vw__meter span {
    position: absolute;
    inset: 0 auto 0 0;
    width: 0;
    background: var(--viz-level);
    border-radius: 99px;
    transition: width 0.18s linear;
  }

  .vw__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: var(--sp-4) 0 0;
    color: var(--fg-muted);
  }
  .vw__status .viz-dot {
    color: var(--fg-faint);
  }
  :global(.vw:has(.vw__btn.is-on)) .vw__status .viz-dot {
    color: var(--viz-level);
  }
  .vw__facts {
    margin-top: var(--sp-2);
    color: var(--fg-faint);
  }

  @keyframes vw-pulse {
    0% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--viz-level) 50%, transparent);
    }
    100% {
      box-shadow: 0 0 0 14px
        color-mix(in srgb, var(--viz-level) 0%, transparent);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.vw[data-anim-state='playing']) .vw__btn.is-on::after {
      animation: none;
    }
    .vw__meter span {
      transition: none;
    }
  }
  @media (max-width: 560px) {
    .vw__bubble {
      gap: var(--sp-2);
      padding-right: var(--sp-3);
    }
    .vw__btn {
      width: 40px;
      height: 40px;
    }
    .vw__meter {
      display: none;
    }
  }
</style>
