---
interface Props {
  /** Mono label above the title, e.g. a section number ("01") or a category. */
  kicker: string;
  title: string;
  id?: string;
  description?: string;
  descFull?: boolean;
  /** Heading level - use "h1" for the page title on standalone pages. */
  as?: 'h1' | 'h2';
}

const {
  kicker,
  title,
  id,
  description,
  descFull = false,
  as: Tag = 'h2',
} = Astro.props;
---

<div class="section-heading" id={id} data-reveal>
  <p class="kicker">{kicker}</p>
  <Tag class="section-heading__title">{title}</Tag>
  {
    description && (
      <p
        class:list={[
          'section-heading__desc',
          'lede',
          { 'section-heading__desc--full': descFull },
        ]}
      >
        {description}
      </p>
    )
  }
</div>

<style>
  .section-heading {
    margin-bottom: var(--sp-7);
  }
  .kicker {
    margin-bottom: var(--sp-4);
  }
  .section-heading__title {
    font-size: var(--fs-2xl);
  }
  .section-heading__desc {
    margin-top: var(--sp-4);
    max-width: 60ch;
  }
  .section-heading__desc--full {
    max-width: none;
  }
</style>
