---
/**
 * Metric tiles. Numeric values count up once, the first time the row scrolls
 * into view; the controls under the row pause or replay the count.
 */
import AnimControls from './viz/AnimControls.astro';

interface Tile {
  label: string;
  value: number;
  suffix?: string;
  decimals?: number;
  sub: string;
}

interface Props {
  tiles: Tile[];
}

const { tiles } = Astro.props;
---

<div class="tiles" data-stat-tiles>
  <div class="tiles__grid">
    {
      tiles.map((tile, i) => (
        <div class="tiles__item" data-reveal style={`--d:${(i % 4) * 60}ms`}>
          <span class="tiles__label">{tile.label}</span>
          <span
            class="tiles__value"
            data-count={tile.value}
            data-suffix={tile.suffix ?? ''}
            data-decimals={tile.decimals ?? 0}
          >
            0{tile.suffix ?? ''}
          </span>
          <span class="tiles__sub">{tile.sub}</span>
        </div>
      ))
    }
  </div>
  <div class="tiles__foot">
    <AnimControls />
  </div>
</div>

<script is:inline>
  (() => {
    function initStatTiles() {
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const DURATION = 1200;

      const format = (value, decimals, suffix) =>
        (decimals
          ? value.toFixed(decimals)
          : Math.round(value).toLocaleString('en-US')) + suffix;

      // The component can appear more than once per page: one engine per row.
      document.querySelectorAll('[data-stat-tiles]').forEach((root) => {
        if (root.dataset.bound === '1') return;
        root.dataset.bound = '1';

        const values = [...root.querySelectorAll('[data-count]')].map((el) => ({
          el,
          target: parseFloat(el.dataset.count),
          decimals: parseInt(el.dataset.decimals || '0', 10),
          suffix: el.dataset.suffix || '',
        }));

        // Reduced motion rests on the final values until the reader plays it.
        let elapsed = reduce ? DURATION : 0;
        let since = null;
        let raf = 0;

        const paint = () => {
          const eased = 1 - Math.pow(1 - elapsed / DURATION, 3);
          values.forEach((v) => {
            v.el.textContent = format(v.target * eased, v.decimals, v.suffix);
          });
        };

        // Progress is kept in `elapsed`, so a pause resumes the same count.
        const frame = (ts) => {
          if (since === null) since = ts - elapsed;
          elapsed = Math.min(DURATION, ts - since);
          paint();
          if (elapsed < DURATION) {
            raf = requestAnimationFrame(frame);
            return;
          }
          raf = 0;
          root.dispatchEvent(new CustomEvent('anim:ended'));
        };

        const stop = () => {
          cancelAnimationFrame(raf);
          raf = 0;
          since = null;
        };

        paint();

        (window.animQueue = window.animQueue || []).push({
          root,
          play() {
            if (raf) return;
            // Reduced motion lands on the final values without counting.
            if (reduce) elapsed = DURATION;
            if (elapsed >= DURATION) {
              paint();
              root.dispatchEvent(new CustomEvent('anim:ended'));
              return;
            }
            raf = requestAnimationFrame(frame);
          },
          pause: stop,
          reset() {
            stop();
            elapsed = 0;
            paint();
          },
        });
      });
    }

    if (document.readyState !== 'loading') initStatTiles();
    else document.addEventListener('DOMContentLoaded', initStatTiles);
  })();
</script>

<style>
  .tiles {
    margin-block: var(--sp-6);
  }
  .tiles__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: var(--sp-3);
  }
  @media (max-width: 720px) {
    .tiles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .tiles__foot {
    display: flex;
    justify-content: flex-end;
    margin-top: var(--sp-2);
  }
  .tiles__item {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-subtle);
    padding: var(--sp-4);
  }
  .tiles__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .tiles__value {
    display: block;
    font-size: var(--fs-xl);
    font-weight: 680;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
    margin-top: 0.35rem;
  }
  .tiles__sub {
    display: block;
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    margin-top: 0.2rem;
  }
</style>
