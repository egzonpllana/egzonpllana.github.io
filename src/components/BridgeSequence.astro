---
/**
 * Web <-> native message sequence player. Replays the scan handshake between a
 * page inside a WKWebView and the native app for three outcomes, so the reader
 * can see which messages actually cross the boundary and in which direction.
 * It plays once when it scrolls into view; picking an ending replays that one.
 */
import AnimControls from './viz/AnimControls.astro';

interface Step {
  /** 'in' = web -> native, 'out' = native -> web, 'local' = neither */
  dir: 'in' | 'out' | 'local';
  name: string;
  payload?: string;
  note: string;
  status?: string;
}

const SCENARIOS: Record<string, { caption: string; steps: Step[] }> = {
  success: {
    caption: 'The page asks for a scan and gets the whole backend result back.',
    steps: [
      {
        dir: 'in',
        name: 'scan.request',
        payload: '{ variant_id, …anything else }',
        note: 'Only the cluster id is required. Every other key is forwarded to the backend byte-for-byte, so the web team adds fields without an app release.',
        status: 'scanning',
      },
      {
        dir: 'out',
        name: 'scan.started',
        payload: '{ variant_id }',
        note: 'Native capture is now presented full-screen over the page. The page is still loaded underneath it.',
      },
      {
        dir: 'local',
        name: 'guided capture + reconstruction',
        note: 'Entirely on device. No frame is uploaded, and the bridge is silent for the whole of it.',
      },
      {
        dir: 'local',
        name: 'mesh export → multipart POST → 202',
        note: 'The upload is owned by a coordinator, not by the capture screen, so dismissing the sheet does not kill it.',
        status: 'uploading',
      },
      {
        dir: 'out',
        name: 'scan.result',
        payload: '{ variant_id, result_json }',
        note: 'The backend response is handed over verbatim. The app parses it for its own preview; the page gets the untouched original.',
        status: 'finished',
      },
    ],
  },
  cancel: {
    caption: 'The user backs out. The page has to learn that without polling.',
    steps: [
      {
        dir: 'in',
        name: 'scan.request',
        payload: '{ variant_id }',
        note: 'Same entry point. Nothing about the request says how it will end.',
        status: 'scanning',
      },
      {
        dir: 'out',
        name: 'scan.started',
        payload: '{ variant_id }',
        note: 'Acknowledged immediately, before any capture happens.',
      },
      {
        dir: 'local',
        name: 'user dismisses the capture sheet',
        note: 'No error, no failure — just a person changing their mind. It still has to become a message.',
      },
      {
        dir: 'out',
        name: 'scan.aborted',
        payload: '{ reason: "user_cancelled" }',
        note: 'One exit message with a typed reason covers cancel, invalid input, missing identity and upload failure. The page switches on the reason.',
        status: 'exited',
      },
    ],
  },
  timeout: {
    caption:
      'The fit outruns the reporting budget — and then lands anyway. Both facts reach the page.',
    steps: [
      {
        dir: 'in',
        name: 'scan.request',
        payload: '{ variant_id }',
        note: 'Unremarkable start. The interesting part is the ending.',
        status: 'scanning',
      },
      {
        dir: 'out',
        name: 'scan.started',
        payload: '{ variant_id }',
        note: 'Capture runs, reconstruction finishes, the mesh goes up.',
      },
      {
        dir: 'local',
        name: 'upload in flight, past the reporting budget',
        note: 'A detached reporter fires at the budget. It reports; it does not cancel. The transfer is untouched.',
        status: 'uploading',
      },
      {
        dir: 'out',
        name: 'scan.aborted',
        payload: '{ reason: "upload_timeout" }',
        note: 'The page can stop waiting and show something useful. This is a report, not a verdict.',
      },
      {
        dir: 'out',
        name: 'scan.result',
        payload: '{ variant_id, result_json }',
        note: 'The upload landed after all, so the result is still delivered. A page that treated the exit as final would drop a scan the user paid for with their time.',
        status: 'finished',
      },
    ],
  },
};

const ORDER = ['success', 'cancel', 'timeout'] as const;
const LABELS: Record<string, string> = {
  success: 'completes',
  cancel: 'user cancels',
  timeout: 'upload times out',
};
---

<figure class="bq" data-bridge-demo data-reveal>
  <div class="bq__frame">
    <div class="bq__top">
      <span class="bq__label">one bridge, three endings</span>
      <div class="bq__controls">
        <div class="bq__chips" role="group" aria-label="Scenario">
          {
            ORDER.map((key) => (
              <button
                type="button"
                class:list={['bq__chip', { 'is-on': key === 'success' }]}
                data-scenario={key}
              >
                {LABELS[key]}
              </button>
            ))
          }
        </div>
        <AnimControls />
      </div>
    </div>

    <p class="bq__caption" data-caption>
      <span class="bq__pulse" aria-hidden="true"></span>
      <span data-caption-text>Scroll on — it runs itself.</span>
    </p>

    <div class="bq__stage">
      <div class="bq__lanes" aria-hidden="true">
        <span class="bq__lane">page in a web view</span>
        <span class="bq__lane bq__lane--right">native app</span>
      </div>
      <div class="bq__rail" data-rail aria-live="polite"></div>
      <div class="bq__foot">
        <span class="bq__foot-label">reported status</span>
        <span class="bq__status" data-status>not_started</span>
      </div>
    </div>
  </div>
  <figcaption>
    Every arrow is one <code>{'{ name, payload }'}</code> envelope over the same generic
    transport. The app defines five names and one of them carries the entire backend
    response untouched — which is what keeps product changes on the web side of the
    boundary.
  </figcaption>
</figure>

<script is:inline define:vars={{ SCENARIOS }}>
  (() => {
    function initBridgeSequence() {
      const root = document.querySelector('[data-bridge-demo]');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const rail = root.querySelector('[data-rail]');
      const statusEl = root.querySelector('[data-status]');
      const captionText = root.querySelector('[data-caption-text]');
      const captionEl = root.querySelector('[data-caption]');
      const chips = Array.from(root.querySelectorAll('[data-scenario]'));
      if (!rail) return;

      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const STEP_MS = 900;
      // From the last message to the caption going quiet.
      const SETTLE_MS = STEP_MS + 400;

      let current = 'success';
      // Messages on the rail, and the time left to the next tick.
      let shown = 0;
      let playing = false;
      let timer = 0;
      let due = 0;
      let left = 0;

      function buildRow(step) {
        const row = document.createElement('div');
        row.className = `bq__row bq__row--${step.dir}`;

        const pill = document.createElement('div');
        pill.className = 'bq__pill';

        if (step.dir !== 'local') {
          const arrow = document.createElement('span');
          arrow.className = 'bq__arrow';
          arrow.setAttribute('aria-hidden', 'true');
          arrow.textContent = step.dir === 'in' ? '→' : '←';
          pill.appendChild(arrow);
        }

        const body = document.createElement('div');
        body.className = 'bq__body';

        const name = document.createElement('span');
        name.className = 'bq__name';
        name.textContent = step.name;
        body.appendChild(name);

        if (step.payload) {
          const payload = document.createElement('span');
          payload.className = 'bq__payload';
          payload.textContent = step.payload;
          body.appendChild(payload);
        }

        const note = document.createElement('span');
        note.className = 'bq__note';
        note.textContent = step.note;
        body.appendChild(note);

        pill.appendChild(body);
        row.appendChild(pill);
        return row;
      }

      function setStatus(state) {
        if (!statusEl) return;
        statusEl.textContent = state;
        statusEl.dataset.state = state;
      }

      function appendNext() {
        const step = SCENARIOS[current].steps[shown];
        rail.appendChild(buildRow(step));
        if (step.status) setStatus(step.status);
        shown += 1;
      }

      function appendAll() {
        while (shown < SCENARIOS[current].steps.length) appendNext();
      }

      function finish() {
        playing = false;
        left = 0;
        if (captionEl) captionEl.classList.remove('is-live');
        root.dispatchEvent(new CustomEvent('anim:ended'));
      }

      function schedule(delay) {
        clearTimeout(timer);
        due = performance.now() + delay;
        timer = setTimeout(() => {
          const count = SCENARIOS[current].steps.length;
          if (shown >= count) {
            finish();
            return;
          }
          appendNext();
          schedule(shown < count ? STEP_MS : SETTLE_MS);
        }, delay);
      }

      function play() {
        if (playing) return;
        // Reduced motion lands the whole exchange at once.
        if (reduce) {
          appendAll();
          finish();
          return;
        }
        playing = true;
        if (captionEl) captionEl.classList.add('is-live');
        schedule(left);
      }

      function pause() {
        if (!playing) return;
        playing = false;
        clearTimeout(timer);
        left = Math.max(0, due - performance.now());
      }

      function reset() {
        playing = false;
        clearTimeout(timer);
        shown = 0;
        left = 0;
        rail.innerHTML = '';
        setStatus('not_started');
        if (captionText) captionText.textContent = SCENARIOS[current].caption;
        if (captionEl) captionEl.classList.remove('is-live');
        chips.forEach((chip) =>
          chip.classList.toggle('is-on', chip.dataset.scenario === current),
        );
      }

      /** Picking an ending replays it; reduced motion only swaps it. */
      function choose(key) {
        current = key;
        reset();
        if (reduce) {
          appendAll();
          return;
        }
        root.dispatchEvent(new CustomEvent('anim:started'));
        play();
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => choose(chip.dataset.scenario));
      });

      // Reduced motion rests on the whole exchange until the reader plays it.
      if (reduce) {
        reset();
        appendAll();
      }

      (window.animQueue = window.animQueue || []).push({
        root,
        play,
        pause,
        reset,
      });
    }

    if (document.readyState !== 'loading') initBridgeSequence();
    else document.addEventListener('DOMContentLoaded', initBridgeSequence);
    document.addEventListener('astro:page-load', initBridgeSequence);
  })();
</script>

<style>
  .bq {
    margin-block: var(--sp-6);
  }
  .bq figcaption {
    margin-top: var(--sp-3);
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--fg-muted);
  }
  .bq__frame {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    padding: var(--sp-5);
  }
  .bq__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
  }
  .bq__label {
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bq__controls {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-left: auto;
    flex-wrap: wrap;
  }
  .bq__chips {
    display: flex;
    gap: var(--sp-1);
    flex-wrap: wrap;
  }
  .bq__chip {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--fg-muted);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.24rem 0.5rem;
    cursor: pointer;
    transition:
      color 0.2s var(--ease),
      border-color 0.2s var(--ease),
      background 0.2s var(--ease);
  }
  .bq__chip:hover {
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .bq__chip.is-on {
    color: var(--accent-text);
    border-color: var(--accent);
    background: var(--accent-soft);
  }
  .bq__caption {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    margin: var(--sp-4) 0 0;
    min-height: 1.4em;
  }
  .bq__pulse {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--border-strong);
    flex: 0 0 auto;
  }
  .bq__caption.is-live .bq__pulse {
    background: var(--accent);
    animation: bq-pulse 1.4s ease-in-out infinite;
  }
  @keyframes bq-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.85);
    }
    50% {
      opacity: 1;
      transform: scale(1.15);
    }
  }

  .bq__stage {
    margin-top: var(--sp-4);
  }
  .bq__lanes {
    display: flex;
    justify-content: space-between;
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--border);
  }
  .bq__lane {
    font-size: var(--fs-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }

  .bq__rail {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
    padding-top: var(--sp-3);
    min-height: 15rem;
  }

  .bq :global(.bq__row) {
    display: flex;
    animation: bq-in 0.45s var(--ease);
  }
  @keyframes bq-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .bq :global(.bq__row--in) {
    justify-content: flex-start;
  }
  .bq :global(.bq__row--out) {
    justify-content: flex-end;
  }
  .bq :global(.bq__row--local) {
    justify-content: center;
  }

  .bq :global(.bq__pill) {
    display: flex;
    gap: var(--sp-3);
    max-width: 84%;
    padding: 0.55rem 0.7rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg-subtle);
  }
  .bq :global(.bq__row--in .bq__pill) {
    border-left: 2px solid var(--accent);
  }
  .bq :global(.bq__row--out .bq__pill) {
    border-right: 2px solid var(--accent);
    flex-direction: row-reverse;
  }
  .bq :global(.bq__row--local .bq__pill) {
    background: transparent;
    border-style: dashed;
    max-width: 90%;
  }

  .bq :global(.bq__arrow) {
    font-family: var(--font-mono);
    color: var(--accent-text);
    line-height: 1.4;
  }
  .bq :global(.bq__body) {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .bq :global(.bq__row--out .bq__body) {
    text-align: right;
  }
  .bq :global(.bq__name) {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg);
    font-weight: 600;
  }
  .bq :global(.bq__row--local .bq__name) {
    font-family: var(--font-sans);
    font-weight: 500;
    color: var(--fg-muted);
    font-style: italic;
  }
  .bq :global(.bq__payload) {
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    color: var(--accent-text);
  }
  .bq :global(.bq__note) {
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--fg-muted);
    margin-top: 0.2rem;
  }

  .bq__foot {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-4);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--border);
  }
  .bq__foot-label {
    font-size: var(--fs-2xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .bq__status {
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.16rem 0.45rem;
    transition:
      color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }
  .bq__status[data-state='scanning'],
  .bq__status[data-state='uploading'] {
    color: var(--fg);
    border-color: var(--border-strong);
  }
  .bq__status[data-state='finished'] {
    color: var(--accent-text);
    border-color: var(--accent);
  }

  @media (max-width: 620px) {
    .bq__frame {
      padding: var(--sp-4);
    }
    .bq__controls {
      margin-left: 0;
      width: 100%;
    }
    .bq :global(.bq__pill) {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bq :global(.bq__row) {
      animation: none;
    }
    .bq__caption.is-live .bq__pulse {
      animation: none;
    }
  }
</style>
