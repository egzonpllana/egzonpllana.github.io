---
/**
 * One call crossing from the host's main actor into the SDK and back, drawn as
 * swimlanes over time: the host, the SDK's public method, the SDK's own work,
 * and the network. Four variants show who owns the task in each case and who
 * cancels it: a call that completes, a call the host abandons, an SDK-owned
 * stream with a handle, and the same stream with no owner.
 *
 * The sequence is a teaching walk-through, not a trace; the URLError code and
 * the nonisolated(nonsending) placement were checked with compiled probes
 * (Swift 6.4, Xcode 27.1).
 */
import VizFrame from './viz/VizFrame.astro';
import AnimControls from './viz/AnimControls.astro';

interface Props {
  fig?: string;
  caption?: string;
}
const {
  fig = '06',
  caption = 'Time runs to the right, one column per step. A call the host awaits runs inside the host’s task, so the host’s cancellation reaches the SDK without anyone telling it. A stream the SDK starts is the SDK’s to end: with a handle, the host’s cancel() or the handle’s deinit stops it; without one, nothing can.',
} = Astro.props;

type LaneId = 'host' | 'api' | 'work' | 'net';
type Kind = 'run' | 'net' | 'ok' | 'free' | 'cancel' | 'bad';
interface Cell {
  lane: LaneId;
  label: string;
  kind: Kind;
}
interface Step {
  cells: Cell[];
  text: string;
  code?: string;
  owner: string;
  ownerKind: 'host' | 'sdk' | 'none' | 'done';
}

const LANES: { id: LaneId; name: string; sub: string }[] = [
  { id: 'host', name: 'Host', sub: 'main actor' },
  { id: 'api', name: 'SDK API', sub: 'nonisolated async' },
  { id: 'work', name: 'SDK work', sub: '@concurrent' },
  { id: 'net', name: 'Network', sub: 'URLSession' },
];

const callStart: Step[] = [
  {
    cells: [{ lane: 'host', label: 'call', kind: 'run' }],
    text: 'The host calls the SDK from a SwiftUI .task. The call runs inside the host’s task, so the host owns it.',
    code: '.task { balance = try? await sdk.balance(for: id) }',
    owner: 'host · the view’s .task',
    ownerKind: 'host',
  },
  {
    cells: [{ lane: 'api', label: 'enter', kind: 'run' }],
    text: 'The public method is nonisolated async. Built with Swift 6.2’s nonisolated(nonsending) semantics it starts on the caller’s actor, here the main one, so it does nothing but hand off.',
    code: 'public nonisolated func balance(for id: AccountID) async throws -> Balance',
    owner: 'host · the view’s .task',
    ownerKind: 'host',
  },
  {
    cells: [
      { lane: 'host', label: 'free', kind: 'free' },
      { lane: 'work', label: 'hop off', kind: 'run' },
      { lane: 'net', label: 'request', kind: 'net' },
    ],
    text: 'Anything that costs CPU is @concurrent, so it leaves the main actor. The request goes out and the main thread is free to draw frames.',
    code: '@concurrent func fetchAndDecode(_ id: AccountID) async throws -> Balance',
    owner: 'host · the view’s .task',
    ownerKind: 'host',
  },
];

const VARIANTS: Record<string, { label: string; steps: Step[] }> = {
  complete: {
    label: 'call completes',
    steps: [
      ...callStart,
      {
        cells: [
          { lane: 'net', label: 'response', kind: 'net' },
          { lane: 'work', label: 'decode', kind: 'run' },
        ],
        text: 'The response arrives. Decoding and validation run off the main actor, in the SDK’s @concurrent function.',
        owner: 'host · the view’s .task',
        ownerKind: 'host',
      },
      {
        cells: [{ lane: 'host', label: '1 hop', kind: 'ok' }],
        text: 'One hop back to the main actor carries the finished value. The main thread paid for two short slices: the call and the assignment.',
        owner: 'finished · nothing left running',
        ownerKind: 'done',
      },
    ],
  },
  cancel: {
    label: 'host leaves',
    steps: [
      ...callStart,
      {
        cells: [{ lane: 'host', label: 'leaves', kind: 'cancel' }],
        text: 'The user navigates away and SwiftUI cancels the view’s task. The SDK call is part of that task, so it is cancelled too. That only holds because the SDK did not wrap the work in its own Task {}.',
        owner: 'host · cancelled',
        ownerKind: 'host',
      },
      {
        cells: [{ lane: 'net', label: '−999', kind: 'cancel' }],
        text: 'URLSession sees the cancellation and stops the request. It throws URLError(.cancelled), code −999, not CancellationError.',
        owner: 'host · cancelled',
        ownerKind: 'host',
      },
      {
        cells: [{ lane: 'api', label: 'normalise', kind: 'cancel' }],
        text: 'The SDK’s networking boundary maps URLError.cancelled to CancellationError, once, so no caller has to know two spellings of one event.',
        code: 'catch let e as URLError where e.code == .cancelled { throw CancellationError() }',
        owner: 'host · cancelled',
        ownerKind: 'host',
      },
      {
        cells: [{ lane: 'host', label: 'silent', kind: 'free' }],
        text: 'The host’s cancellation path does nothing visible: no error banner on a screen the user already left, and nothing left running.',
        owner: 'finished · nothing left running',
        ownerKind: 'done',
      },
    ],
  },
  stream: {
    label: 'stream, owned',
    steps: [
      {
        cells: [{ lane: 'host', label: 'subscribe', kind: 'run' }],
        text: 'The host subscribes to live balance updates. The SDK starts a task for the socket and returns a handle that owns it.',
        code: 'subscription = sdk.balanceUpdates(for: id) { state in … }',
        owner: 'SDK · the subscription handle',
        ownerKind: 'sdk',
      },
      {
        cells: [
          { lane: 'net', label: 'events', kind: 'net' },
          { lane: 'work', label: 'sequence', kind: 'run' },
        ],
        text: 'Events arrive. Each one is checked against the last applied server sequence and coalesced per key, off the main actor.',
        owner: 'SDK · the subscription handle',
        ownerKind: 'sdk',
      },
      {
        cells: [{ lane: 'host', label: '1 / frame', kind: 'ok' }],
        text: 'At most one crossing per frame delivers the latest whole state.',
        owner: 'SDK · the subscription handle',
        ownerKind: 'sdk',
      },
      {
        cells: [{ lane: 'host', label: 'cancel()', kind: 'cancel' }],
        text: 'The screen closes and calls subscription.cancel(), or simply drops the handle: its deinit cancels too.',
        code: 'deinit { task.cancel() }',
        owner: 'SDK · cancelled by its handle',
        ownerKind: 'sdk',
      },
      {
        cells: [
          { lane: 'work', label: 'exits', kind: 'cancel' },
          { lane: 'net', label: 'closed', kind: 'cancel' },
        ],
        text: 'The SDK’s task sees the cancellation, closes the socket and returns. Every task the SDK started had an owner, and the owner ended it.',
        owner: 'finished · nothing left running',
        ownerKind: 'done',
      },
    ],
  },
  orphan: {
    label: 'stream, no owner',
    steps: [
      {
        cells: [{ lane: 'host', label: 'subscribe', kind: 'run' }],
        text: 'The same subscription, but the SDK starts an unstructured task and keeps no reference to it.',
        code: 'Task { for await event in socket { await deliver(event) } }',
        owner: 'nobody',
        ownerKind: 'none',
      },
      {
        cells: [
          { lane: 'net', label: 'events', kind: 'net' },
          { lane: 'work', label: 'sequence', kind: 'run' },
        ],
        text: 'Events arrive and are processed exactly as before. Nothing looks wrong yet.',
        owner: 'nobody',
        ownerKind: 'none',
      },
      {
        cells: [{ lane: 'host', label: '1 / frame', kind: 'ok' }],
        text: 'Deliveries reach the screen once per frame.',
        owner: 'nobody',
        ownerKind: 'none',
      },
      {
        cells: [{ lane: 'host', label: 'gone', kind: 'free' }],
        text: 'The screen closes. There is nothing to cancel: no one holds the task.',
        owner: 'nobody',
        ownerKind: 'none',
      },
      {
        cells: [
          { lane: 'work', label: 'running', kind: 'bad' },
          { lane: 'net', label: 'open', kind: 'bad' },
          { lane: 'host', label: 'hops', kind: 'bad' },
        ],
        text: 'The task runs for the life of the process: the socket stays open, data and battery keep draining, and every event still hops to the main actor to update a screen that no longer exists.',
        owner: 'nobody · runs until the process dies',
        ownerKind: 'none',
      },
    ],
  },
};
const MAX_STEPS = Math.max(
  ...Object.values(VARIANTS).map((v) => v.steps.length),
);
---

<VizFrame
  fig={fig}
  title="One call across the boundary: who owns it, who cancels it"
  caption={caption}
  class="cc6"
  data-cc6
  label="Swimlane walk-through of a call from the host's main actor into the SDK and back, in four variants: completes, host cancels, SDK-owned stream, unowned stream."
>
  <div slot="tools" class="cc6__tools">
    <button type="button" class="viz-btn" data-next aria-label="Next step"
      >step</button
    >
    <AnimControls label="Call" />
  </div>

  <div class="cc6__bar" data-shot-hide>
    <div class="viz-seg cc6__seg" role="group" aria-label="Scenario">
      {
        Object.entries(VARIANTS).map(([key, v], i) => (
          <button
            type="button"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-variant={key}
          >
            {v.label}
          </button>
        ))
      }
    </div>
    <span class="viz-mono cc6__counter" data-counter></span>
  </div>

  <div class="cc6__board viz-panel" style={`--cols:${MAX_STEPS}`}>
    {
      LANES.map((lane) => (
        <Fragment>
          <div class="cc6__lane" data-lane={lane.id}>
            <span class="cc6__lane-name">
              <b>{lane.name}</b>
              <small class="viz-mono">{lane.sub}</small>
            </span>
            <span class="cc6__cells">
              {Array.from({ length: MAX_STEPS }, (_, i) => (
                <span class="cc6__cell" data-col={i} />
              ))}
            </span>
          </div>
          {lane.id === 'host' && (
            <div class="cc6__boundary" aria-hidden="true">
              <span>public API boundary</span>
            </div>
          )}
        </Fragment>
      ))
    }
  </div>

  <div class="cc6__owner">
    <span class="viz-label">task owner</span>
    <span class="viz-chip" data-owner></span>
  </div>

  <p class="cc6__text" data-text aria-live="polite"></p>
  <code class="cc6__code viz-mono" data-code></code>

  <div class="viz-legend cc6__legend" aria-hidden="true">
    <span><i style="--c:var(--viz-sound)"></i>main actor busy</span>
    <span><i style="--c:var(--viz-meta)"></i>SDK running</span>
    <span><i style="--c:var(--viz-net)"></i>on the wire</span>
    <span><i style="--c:var(--viz-level)"></i>cancellation</span>
    <span><i style="--c:var(--viz-bad)"></i>work nobody can stop</span>
  </div>

  <script
    is:inline
    type="application/json"
    data-cc6-data
    set:html={JSON.stringify(VARIANTS)}
  />
</VizFrame>

<script is:inline>
  (() => {
    const STEP_MS = 2600;

    function initCallCrossing(root) {
      if (root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const data = JSON.parse(
        root.querySelector('[data-cc6-data]').textContent,
      );
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const lanes = Object.fromEntries(
        [...root.querySelectorAll('[data-lane]')].map((el) => [
          el.dataset.lane,
          [...el.querySelectorAll('[data-col]')],
        ]),
      );
      const ownerEl = root.querySelector('[data-owner]');
      const textEl = root.querySelector('[data-text]');
      const codeEl = root.querySelector('[data-code]');
      const counterEl = root.querySelector('[data-counter]');
      const segBtns = [...root.querySelectorAll('[data-variant]')];

      let variant = 'complete';
      let current = 0;
      let playing = false;
      let timer = 0;

      const steps = () => data[variant].steps;
      const last = () => steps().length - 1;
      const OWNER_CHIP = {
        host: 'viz-chip--sound',
        sdk: 'viz-chip--meta',
        none: 'viz-chip--bad',
        done: '',
      };

      function render() {
        Object.values(lanes).forEach((cells) =>
          cells.forEach((cell, col) => {
            cell.textContent = '';
            cell.className = 'cc6__cell';
            cell.hidden = col > last();
          }),
        );
        steps().forEach((step, col) => {
          if (col > current) return;
          step.cells.forEach((c) => {
            const cell = lanes[c.lane][col];
            cell.textContent = c.label;
            cell.classList.add('is-on', `is-${c.kind}`);
            if (col === current) cell.classList.add('is-now');
          });
        });
        root.style.setProperty('--shown', String(last() + 1));
        const step = steps()[current];
        ownerEl.textContent = step.owner;
        ownerEl.className = `viz-chip ${OWNER_CHIP[step.ownerKind]}`;
        textEl.textContent = step.text;
        textEl.classList.toggle(
          'is-bad',
          step.cells.some((c) => c.kind === 'bad'),
        );
        codeEl.textContent = step.code || '';
        codeEl.hidden = !step.code;
        counterEl.textContent = `${current + 1} / ${steps().length}`;
      }

      function stop() {
        playing = false;
        clearTimeout(timer);
      }

      function schedule() {
        clearTimeout(timer);
        if (!playing) return;
        timer = setTimeout(() => {
          current += 1;
          render();
          if (current >= last()) {
            playing = false;
            root.dispatchEvent(new CustomEvent('anim:ended'));
            return;
          }
          schedule();
        }, STEP_MS);
      }

      function play() {
        if (playing) return;
        if (current >= last()) {
          root.dispatchEvent(new CustomEvent('anim:ended'));
          return;
        }
        playing = true;
        schedule();
      }

      function reset() {
        stop();
        current = 0;
        render();
      }

      root.querySelector('[data-next]').addEventListener('click', () => {
        stop();
        current = current >= last() ? 0 : current + 1;
        render();
        root.dispatchEvent(
          new CustomEvent(current >= last() ? 'anim:ended' : 'anim:paused'),
        );
      });

      segBtns.forEach((btn) =>
        btn.addEventListener('click', () => {
          if (btn.dataset.variant === variant) return;
          variant = btn.dataset.variant;
          segBtns.forEach((b) =>
            b.setAttribute('aria-pressed', String(b === btn)),
          );
          reset();
          if (reduce) {
            current = last();
            render();
            root.dispatchEvent(new CustomEvent('anim:ended'));
            return;
          }
          root.dispatchEvent(new CustomEvent('anim:started'));
          play();
        }),
      );

      (window.animQueue = window.animQueue || []).push({
        root,
        play,
        pause: stop,
        reset,
      });

      current = reduce ? last() : 0;
      render();
    }

    const boot = () =>
      document.querySelectorAll('[data-cc6]').forEach(initCallCrossing);
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);
  })();
</script>

<style>
  .cc6__tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .cc6__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-3);
  }
  .cc6__seg {
    flex-wrap: wrap;
    border-radius: 16px;
  }
  .cc6__counter {
    font-size: 11px;
    color: var(--fg-faint);
  }

  .cc6__board {
    position: relative;
    display: grid;
    gap: 6px;
    padding: var(--sp-3);
  }
  .cc6__lane {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: var(--sp-3);
    align-items: center;
  }
  .cc6__lane-name {
    display: grid;
    min-width: 0;
  }
  .cc6__lane-name b {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--fg);
  }
  .cc6__lane-name small {
    font-size: 10.5px;
    color: var(--fg-faint);
  }
  .cc6__cells {
    display: grid;
    grid-template-columns: repeat(var(--shown, var(--cols)), minmax(0, 1fr));
    gap: 4px;
  }
  .cc6__cell {
    display: grid;
    place-items: center;
    min-width: 0;
    height: 30px;
    padding: 0 4px;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
    color: var(--fg);
    background: color-mix(in srgb, var(--fg) 4%, transparent);
    border: 1px dashed var(--border);
    border-radius: 6px;
    transition:
      background 0.25s var(--ease),
      border-color 0.25s var(--ease);
  }
  .cc6__cell.is-on {
    border-style: solid;
    --c: var(--viz-meta);
    border-color: var(--c);
    background: color-mix(in srgb, var(--c) 16%, var(--viz-panel));
  }
  .cc6__lane[data-lane='host'] .cc6__cell.is-run,
  .cc6__cell.is-ok {
    --c: var(--viz-sound);
  }
  .cc6__cell.is-net {
    --c: var(--viz-net);
  }
  .cc6__cell.is-free {
    --c: var(--border-strong);
    color: var(--fg-faint);
    font-weight: 500;
  }
  .cc6__cell.is-cancel {
    --c: var(--viz-level);
  }
  .cc6__cell.is-bad {
    --c: var(--viz-bad);
  }
  .cc6__cell.is-now {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 45%, transparent);
  }

  .cc6__boundary {
    position: relative;
    height: 18px;
    display: flex;
    align-items: center;
    pointer-events: none;
  }
  .cc6__boundary::before {
    content: '';
    position: absolute;
    right: 0;
    left: 0;
    top: 50%;
    border-top: 2px solid var(--viz-sound);
    opacity: 0.55;
  }
  .cc6__boundary span {
    position: relative;
    margin-left: calc(8.5rem + var(--sp-3));
    padding: 0 6px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--viz-sound-text);
    background: var(--viz-panel);
  }

  .cc6__owner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }
  .cc6__owner .viz-chip {
    white-space: normal;
  }
  .cc6__text {
    min-height: 4.5em;
    margin: var(--sp-3) 0 0;
    padding-left: var(--sp-3);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg);
    border-left: 3px solid var(--viz-meta);
  }
  .cc6__text.is-bad {
    border-left-color: var(--viz-bad);
  }
  .cc6__code {
    display: block;
    margin-top: var(--sp-2);
    padding: 6px 10px;
    overflow-x: auto;
    font-size: 11.5px;
    white-space: pre;
    color: var(--fg-muted);
    background: var(--viz-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .cc6__legend {
    margin-top: var(--sp-3);
  }

  @media (max-width: 560px) {
    .cc6__lane {
      grid-template-columns: 4.6rem minmax(0, 1fr);
      gap: var(--sp-2);
    }
    .cc6__lane-name small {
      display: none;
    }
    .cc6__cell {
      font-size: 0;
      padding: 0;
    }
    .cc6__boundary span {
      margin-left: calc(4.6rem + var(--sp-2));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cc6__cell {
      transition: none;
    }
  }
</style>
