---
/**
 * A debounced search, two keystrokes 150 ms apart, drawn on one millisecond
 * axis: the user, the task each keystroke starts, and what the screen shows.
 * Four variants, each the bug or the fix the guide describes: the old task
 * never cancelled (a late response overwrites a newer one), cancelled but
 * slept with try? (cancellation swallowed, then URLError.cancelled misses
 * `catch is CancellationError`), cancelled and propagated, and a callback API
 * parked in a continuation that cancellation never resumes.
 *
 * The behaviour was checked with compiled Swift 6.4 probes (Xcode 27.1):
 * a cancelled Task.sleep under try? returned at the moment of cancel(), the
 * URLSession call that followed in the cancelled task threw URLError -999,
 * `error is CancellationError` was false for it, and a continuation with no
 * cancellation handler was still suspended a second after cancel(). The
 * 300 ms debounce and the latencies are illustrative.
 */
import VizFrame from './viz/VizFrame.astro';
import AnimControls from './viz/AnimControls.astro';

interface Props {
  fig?: string;
  caption?: string;
}
const {
  fig = '04',
  caption = 'Cancellation is a flag that well-behaved code checks. Not cancelling leaves the old task free to overwrite the screen. Cancelling and then sleeping with try? discards the CancellationError, so the old task carries on, and the URLError it meets next is not a CancellationError either. Only a propagated cancellation ends the task where it stands, and a continuation hears none of it unless a cancellation handler passes it on.',
} = Astro.props;

type LaneId = 'user' | 'a' | 'b' | 'screen';
type Kind = 'run' | 'net' | 'ok' | 'cancel' | 'bad' | 'mark';
interface Mark {
  /** A later mark with the same id replaces the earlier one. */
  id?: string;
  lane: LaneId;
  from: number;
  to?: number;
  open?: boolean;
  label: string;
  kind: Kind;
}
interface Step {
  marks: Mark[];
  text: string;
  code?: string;
}

const AXIS = 1000;
const LANES: { id: LaneId; name: string; sub: string }[] = [
  { id: 'user', name: 'User', sub: 'keystrokes' },
  { id: 'a', name: 'Task A', sub: '“rat”' },
  { id: 'b', name: 'Task B', sub: '“rate”' },
  { id: 'screen', name: 'Screen', sub: 'LoadState' },
];

const typeFirst: Step = {
  marks: [
    { lane: 'user', from: 0, label: 'rat', kind: 'mark' },
    {
      id: 'a-sleep',
      lane: 'a',
      from: 0,
      to: 300,
      label: 'sleep 300 ms',
      kind: 'run',
    },
  ],
  text: 'The user types “rat”. The keystroke starts a task that waits 300 ms for the typing to settle, then searches.',
  code: 'task = Task { try await Task.sleep(for: .milliseconds(300)); … }',
};

const VARIANTS: Record<string, { label: string; steps: Step[] }> = {
  ignored: {
    label: 'not cancelled',
    steps: [
      {
        ...typeFirst,
        code: 'Task { try await Task.sleep(for: .milliseconds(300)); … }',
      },
      {
        marks: [
          { lane: 'user', from: 150, label: 'rate', kind: 'mark' },
          { lane: 'b', from: 150, to: 450, label: 'sleep', kind: 'run' },
        ],
        text: 'At 150 ms the user types “rate” and a second task starts. The first is still alive: nobody stored it, so nobody can cancel it.',
      },
      {
        marks: [
          { lane: 'a', from: 300, to: 900, label: 'GET rat', kind: 'net' },
        ],
        text: 'Task A wakes and sends its request for “rat”.',
      },
      {
        marks: [
          { lane: 'b', from: 450, to: 700, label: 'GET rate', kind: 'net' },
          {
            id: 'screen',
            lane: 'screen',
            from: 700,
            to: 1000,
            label: 'rate',
            kind: 'ok',
          },
        ],
        text: 'Task B’s request comes back first. The screen shows results for “rate”, which is what the user typed.',
      },
      {
        marks: [
          {
            id: 'screen',
            lane: 'screen',
            from: 700,
            to: 900,
            label: 'rate',
            kind: 'ok',
          },
          { lane: 'screen', from: 900, to: 1000, label: 'rat', kind: 'bad' },
        ],
        text: 'Task A’s response lands last and overwrites the screen with results for a query the user has already replaced. Nothing failed, and the screen is wrong.',
      },
    ],
  },
  swallowed: {
    label: 'cancelled, try?',
    steps: [
      typeFirst,
      {
        marks: [
          { lane: 'user', from: 150, label: 'rate · cancel A', kind: 'cancel' },
          { lane: 'b', from: 150, to: 450, label: 'sleep', kind: 'run' },
        ],
        text: 'This time the model stores the task and cancels it on the next keystroke, then starts Task B. Cancellation sets a flag; Task A still has to notice it.',
        code: 'task?.cancel()',
      },
      {
        marks: [
          {
            id: 'a-sleep',
            lane: 'a',
            from: 0,
            to: 150,
            label: 'sleep',
            kind: 'run',
          },
          { lane: 'a', from: 150, label: '−999', kind: 'bad' },
        ],
        text: 'Task.sleep throws CancellationError at once. try? throws it away, so Task A carries straight on and calls URLSession, which sees a cancelled task and throws URLError.cancelled, code −999.',
        code: 'try? await Task.sleep(for: .milliseconds(300))',
      },
      {
        marks: [
          { lane: 'screen', from: 150, to: 700, label: '.failed', kind: 'bad' },
        ],
        text: 'URLError is not CancellationError, so the first catch does not match. The generic one runs and the screen shows an error for a search that did not fail.',
        code: '} catch is CancellationError { } catch { state = .failed(error) }',
      },
      {
        marks: [
          { lane: 'b', from: 450, to: 700, label: 'GET rate', kind: 'net' },
          { lane: 'screen', from: 700, to: 1000, label: 'rate', kind: 'ok' },
        ],
        text: 'Task B’s results replace the error after more than half a second. The user saw a failure that never happened.',
      },
    ],
  },
  propagated: {
    label: 'cancelled, propagated',
    steps: [
      typeFirst,
      {
        marks: [
          { lane: 'user', from: 150, label: 'rate · cancel A', kind: 'cancel' },
          { lane: 'b', from: 150, to: 450, label: 'sleep', kind: 'run' },
        ],
        text: 'The second keystroke cancels Task A and starts Task B.',
        code: 'task?.cancel()',
      },
      {
        marks: [
          {
            id: 'a-sleep',
            lane: 'a',
            from: 0,
            to: 150,
            label: 'sleep',
            kind: 'run',
          },
          { lane: 'a', from: 150, label: 'exits', kind: 'ok' },
        ],
        text: 'With try, the CancellationError propagates out of the sleep. Task A ends where it stands; no request for “rat” ever leaves.',
        code: 'try await Task.sleep(for: .milliseconds(300))',
      },
      {
        marks: [
          { lane: 'b', from: 450, to: 700, label: 'GET rate', kind: 'net' },
          { lane: 'screen', from: 700, to: 1000, label: 'rate', kind: 'ok' },
        ],
        text: 'Only “rate” is sent and shown. The token check before assigning covers what cancellation cannot: a response that had already arrived when cancel() did.',
        code: 'guard token == latest else { return }',
      },
    ],
  },
  parked: {
    label: 'parked continuation',
    steps: [
      typeFirst,
      {
        marks: [
          {
            id: 'a-wait',
            lane: 'a',
            from: 300,
            open: true,
            label: 'parked',
            kind: 'net',
          },
        ],
        text: 'Task A sends its request through an older callback API, wrapped in a continuation with no cancellation handling.',
        code: 'try await withCheckedThrowingContinuation { c in request.start { c.resume(with: $0) } }',
      },
      {
        marks: [
          {
            lane: 'user',
            from: 500,
            label: 'leaves · cancel A',
            kind: 'cancel',
          },
        ],
        text: 'The user leaves the screen and the screen cancels Task A. That sets the flag. Nothing inside the continuation looks at it.',
      },
      {
        marks: [
          {
            id: 'a-wait',
            lane: 'a',
            from: 300,
            open: true,
            label: 'still parked',
            kind: 'bad',
          },
        ],
        text: 'A continuation resumes only when the callback fires. If the stalled request never calls back, the task stays suspended for good. Across a full test run that reads as an intermittent hang on a networking thread.',
        code: 'withTaskCancellationHandler { … } onCancel: { request.cancel() }',
      },
    ],
  },
};
const MAX_STEPS = Math.max(
  ...Object.values(VARIANTS).map((v) => v.steps.length),
);
---

<VizFrame
  fig={fig}
  title="Two keystrokes, one search: where cancellation dies"
  caption={caption}
  class="clt"
  data-clt
  label="Millisecond timeline of a debounced search with two keystrokes, in four variants: the old task not cancelled, cancelled but slept with try?, cancelled and propagated, and a request parked in a continuation."
>
  <div slot="tools" class="clt__tools">
    <button type="button" class="viz-btn" data-next aria-label="Next step"
      >step</button
    >
    <AnimControls label="Search" />
  </div>

  <div class="clt__bar">
    <div class="viz-seg clt__seg" role="group" aria-label="Variant">
      {
        Object.entries(VARIANTS).map(([key, v], i) => (
          <button
            type="button"
            aria-pressed={i === 0 ? 'true' : 'false'}
            data-variant={key}
          >
            {v.label}
          </button>
        ))
      }
    </div>
    <span class="viz-mono clt__counter" data-counter></span>
  </div>

  <div class="clt__board viz-panel">
    {
      LANES.map((lane) => (
        <div class="clt__lane">
          <span class="clt__lane-name">
            <b>{lane.name}</b>
            <small class="viz-mono">{lane.sub}</small>
          </span>
          <span class="clt__track" data-lane={lane.id} />
        </div>
      ))
    }
    <div class="clt__lane clt__lane--axis" aria-hidden="true">
      <span></span>
      <span class="clt__axis viz-mono">
        {
          [0, 250, 500, 750, 1000].map((ms) => (
            <span style={`left:${(ms / AXIS) * 100}%`}>
              {ms === 1000 ? '1000 ms' : ms}
            </span>
          ))
        }
      </span>
    </div>
  </div>

  <p class="clt__text" data-text aria-live="polite"></p>
  <code class="clt__code viz-mono" data-code></code>

  <div class="viz-legend clt__legend" aria-hidden="true">
    <span><i style="--c:var(--viz-meta)"></i>task waiting</span>
    <span><i style="--c:var(--viz-net)"></i>request in flight</span>
    <span><i style="--c:var(--viz-level)"></i>cancel()</span>
    <span><i style="--c:var(--viz-sound)"></i>correct result</span>
    <span><i style="--c:var(--viz-bad)"></i>wrong, stale or stuck</span>
  </div>

  <script
    is:inline
    type="application/json"
    data-clt-data
    set:html={JSON.stringify({
      axis: AXIS,
      variants: VARIANTS,
      max: MAX_STEPS,
    })}
  />
</VizFrame>

<script is:inline>
  (() => {
    const STEP_MS = 2800;

    function initTimeline(root) {
      if (root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const data = JSON.parse(
        root.querySelector('[data-clt-data]').textContent,
      );
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const tracks = Object.fromEntries(
        [...root.querySelectorAll('[data-lane]')].map((el) => [
          el.dataset.lane,
          el,
        ]),
      );
      const textEl = root.querySelector('[data-text]');
      const codeEl = root.querySelector('[data-code]');
      const counterEl = root.querySelector('[data-counter]');
      const segBtns = [...root.querySelectorAll('[data-variant]')];

      let variant = 'ignored';
      let current = 0;
      let playing = false;
      let timer = 0;

      const steps = () => data.variants[variant].steps;
      const last = () => steps().length - 1;
      const pct = (ms) => `${(ms / data.axis) * 100}%`;

      function drawMark(m, isNow, track) {
        const el = document.createElement('span');
        const bar = m.to !== undefined || m.open;
        el.className = `clt__mark ${bar ? 'is-bar' : 'is-point'} is-${m.kind}`;
        if (isNow) el.classList.add('is-now');
        if (m.id) el.dataset.id = m.id;
        el.style.left = pct(m.from);
        if (bar) {
          const to = m.open ? data.axis : m.to;
          el.style.width = pct(to - m.from);
          if (m.open) el.classList.add('is-open');
        } else {
          if (m.from / data.axis > 0.8) el.classList.add('is-end');
          // Neighbouring points on one lane alternate top and bottom.
          const points = track.querySelectorAll('.is-point').length;
          if (points % 2 === 1) el.classList.add('is-low');
        }
        const label = document.createElement('span');
        label.className = 'clt__label';
        label.textContent = m.label;
        el.appendChild(label);
        return el;
      }

      function render() {
        Object.values(tracks).forEach((t) => (t.textContent = ''));
        steps().forEach((step, i) => {
          if (i > current) return;
          step.marks.forEach((m) => {
            const track = tracks[m.lane];
            // A later mark with the same id replaces the earlier one.
            if (m.id) {
              track
                .querySelectorAll(`[data-id="${m.id}"]`)
                .forEach((old) => old.remove());
            }
            track.appendChild(drawMark(m, i === current, track));
          });
        });
        const step = steps()[current];
        textEl.textContent = step.text;
        textEl.classList.toggle(
          'is-bad',
          step.marks.some((m) => m.kind === 'bad'),
        );
        codeEl.textContent = step.code || '';
        codeEl.hidden = !step.code;
        counterEl.textContent = `${current + 1} / ${steps().length}`;
      }

      function stop() {
        playing = false;
        clearTimeout(timer);
      }

      function schedule() {
        clearTimeout(timer);
        if (!playing) return;
        timer = setTimeout(() => {
          current += 1;
          render();
          if (current >= last()) {
            playing = false;
            root.dispatchEvent(new CustomEvent('anim:ended'));
            return;
          }
          schedule();
        }, STEP_MS);
      }

      function play() {
        if (playing) return;
        if (current >= last()) {
          root.dispatchEvent(new CustomEvent('anim:ended'));
          return;
        }
        playing = true;
        schedule();
      }

      function reset() {
        stop();
        current = 0;
        render();
      }

      root.querySelector('[data-next]').addEventListener('click', () => {
        stop();
        current = current >= last() ? 0 : current + 1;
        render();
        root.dispatchEvent(
          new CustomEvent(current >= last() ? 'anim:ended' : 'anim:paused'),
        );
      });

      segBtns.forEach((btn) =>
        btn.addEventListener('click', () => {
          if (btn.dataset.variant === variant) return;
          variant = btn.dataset.variant;
          segBtns.forEach((b) =>
            b.setAttribute('aria-pressed', String(b === btn)),
          );
          reset();
          if (reduce) {
            current = last();
            render();
            root.dispatchEvent(new CustomEvent('anim:ended'));
            return;
          }
          root.dispatchEvent(new CustomEvent('anim:started'));
          play();
        }),
      );

      (window.animQueue = window.animQueue || []).push({
        root,
        play,
        pause: stop,
        reset,
      });

      current = reduce ? last() : 0;
      render();
    }

    const boot = () =>
      document.querySelectorAll('[data-clt]').forEach(initTimeline);
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);
  })();
</script>

<style>
  .clt__tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .clt__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-3);
  }
  .clt__seg {
    flex-wrap: wrap;
    border-radius: 16px;
  }
  .clt__counter {
    font-size: 11px;
    color: var(--fg-faint);
  }

  .clt__board {
    display: grid;
    gap: 8px;
    padding: var(--sp-3);
  }
  .clt__lane {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--sp-3);
    align-items: center;
  }
  .clt__lane-name {
    display: grid;
    min-width: 0;
  }
  .clt__lane-name b {
    font-size: var(--fs-xs);
    font-weight: 600;
    color: var(--fg);
  }
  .clt__lane-name small {
    font-size: 10.5px;
    color: var(--fg-faint);
  }
  .clt__track {
    position: relative;
    height: 30px;
    background: color-mix(in srgb, var(--fg) 3%, transparent);
    border: 1px dashed var(--border);
    border-radius: 6px;
  }

  .clt__track :global(.clt__mark) {
    position: absolute;
    top: 3px;
    bottom: 3px;
    display: flex;
    align-items: center;
    --c: var(--viz-meta);
  }
  .clt__track :global(.clt__mark.is-bar) {
    justify-content: center;
    overflow: hidden;
    padding: 0 4px;
    background: color-mix(in srgb, var(--c) 18%, var(--viz-panel));
    border: 1px solid var(--c);
    border-radius: 5px;
  }
  .clt__track :global(.clt__mark.is-open) {
    border-right: 0;
    border-radius: 5px 0 0 5px;
    background: linear-gradient(
      90deg,
      color-mix(in srgb, var(--c) 18%, var(--viz-panel)) 70%,
      transparent
    );
  }
  .clt__track :global(.clt__mark.is-point) {
    width: 0;
  }
  .clt__track :global(.clt__mark.is-point::before) {
    content: '';
    position: absolute;
    top: -3px;
    bottom: -3px;
    left: -1px;
    width: 2px;
    background: var(--c);
  }
  .clt__track :global(.clt__mark.is-point .clt__label) {
    position: absolute;
    left: 4px;
    max-width: none;
    overflow: visible;
    padding: 1px 6px;
    color: var(--c);
    background: var(--viz-panel);
    border: 1px solid var(--c);
    border-radius: 999px;
  }
  /* The user lane carries two labels close together: stack them. */
  .clt__track[data-lane='user'] {
    height: 46px;
  }
  .clt__track[data-lane='user'] :global(.clt__mark.is-point .clt__label) {
    top: 0;
  }
  .clt__track[data-lane='user']
    :global(.clt__mark.is-point.is-low .clt__label) {
    top: auto;
    bottom: 0;
  }
  .clt__track :global(.clt__mark.is-point.is-end .clt__label) {
    left: auto;
    right: 4px;
  }
  .clt__track :global(.clt__label) {
    max-width: 100%;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--fg);
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .clt__track :global(.clt__mark.is-net) {
    --c: var(--viz-net);
  }
  .clt__track :global(.clt__mark.is-ok) {
    --c: var(--viz-sound);
  }
  .clt__track :global(.clt__mark.is-cancel) {
    --c: var(--viz-level);
  }
  .clt__track :global(.clt__mark.is-bad) {
    --c: var(--viz-bad);
  }
  .clt__track :global(.clt__mark.is-mark) {
    --c: var(--fg-muted);
  }
  .clt__track :global(.clt__mark.is-now.is-bar) {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 40%, transparent);
  }
  .clt__track :global(.clt__mark.is-now.is-point .clt__label) {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 35%, transparent);
  }

  .clt__axis {
    position: relative;
    height: 14px;
    font-size: 10px;
    color: var(--fg-faint);
  }
  .clt__axis span {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    white-space: nowrap;
  }
  .clt__axis span:first-child {
    transform: none;
  }
  .clt__axis span:last-child {
    transform: translateX(-100%);
  }

  .clt__text {
    min-height: 4.5em;
    margin: var(--sp-3) 0 0;
    padding-left: var(--sp-3);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg);
    border-left: 3px solid var(--viz-meta);
  }
  .clt__text.is-bad {
    border-left-color: var(--viz-bad);
  }
  .clt__code {
    display: block;
    margin-top: var(--sp-2);
    padding: 6px 10px;
    font-size: 11.5px;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    color: var(--fg-muted);
    background: var(--viz-panel);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
  }
  .clt__legend {
    margin-top: var(--sp-3);
  }

  @media (max-width: 560px) {
    .clt__lane {
      grid-template-columns: 3.6rem minmax(0, 1fr);
      gap: var(--sp-2);
    }
    .clt__lane-name small {
      display: none;
    }
    .clt__axis span:nth-child(4) {
      display: none;
    }
    .clt__track :global(.clt__mark.is-bar .clt__label) {
      font-size: 9.5px;
    }
    .clt__track :global(.clt__mark.is-point .clt__label) {
      font-size: 9.5px;
      padding: 0 4px;
    }
  }
</style>
