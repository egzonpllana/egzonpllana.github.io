---
/**
 * A continuous recording sliced into 0.8 s chunks. A record head writes the
 * stream; each time the timer fires, the chunk is closed as its own WAV file,
 * its 44-byte header is stripped, and only the sound is sent.
 */
import VizFrame from './viz/VizFrame.astro';

interface Props {
  caption?: string;
}
const {
  caption = 'The recorder never stops listening. A timer closes one small file and opens the next. Each file is written with a 44-byte header, which is stripped before sending, so only raw sound travels. Playback here is slowed to 1.2 s per chunk.',
} = Astro.props;

const CHUNK_S = 0.8;
const pad = (n: number) => String(n).padStart(2, '0');
const range = (i: number) =>
  `${(i * CHUNK_S).toFixed(1)}–${((i + 1) * CHUNK_S).toFixed(1)} s`;
const finished = Array.from({ length: 5 }, (_, i) => ({
  n: pad(i + 1),
  range: range(i),
}));
---

<VizFrame
  fig="05"
  title="Cutting a river into cups"
  caption={caption}
  class="ctl"
  data-ctl
>
  <button
    slot="tools"
    type="button"
    class="viz-btn"
    data-toggle
    aria-pressed="false"
    aria-label="Pause the animation"
  >
    <svg class="ctl__ico ctl__ico--pause" viewBox="0 0 12 12" aria-hidden="true"
      ><rect x="2" y="1.5" width="3" height="9" rx="1"></rect><rect
        x="7"
        y="1.5"
        width="3"
        height="9"
        rx="1"></rect></svg
    >
    <svg class="ctl__ico ctl__ico--play" viewBox="0 0 12 12" aria-hidden="true"
      ><path d="M3 1.6v8.8L10.4 6z"></path></svg
    >
    <span data-toggle-text>Pause</span>
  </button>

  <div class="ctl__lanehead">
    <span class="viz-label">microphone, always on</span>
    <span class="viz-chip viz-chip--sound ctl__live" data-live
      ><span class="viz-dot"></span><span data-live-text>5 chunks written</span
      ></span
    >
  </div>
  <div class="ctl__lane viz-panel">
    <canvas
      class="ctl__canvas"
      data-canvas
      role="img"
      aria-label="A continuous waveform being recorded and cut every 0.8 seconds"
    ></canvas>
  </div>
  <div class="ctl__axis" data-axis aria-hidden="true"></div>

  <div class="ctl__cardshead">
    <span class="viz-label">closed chunks, newest on the right</span>
    <div class="viz-legend" aria-hidden="true">
      <span><i style="--c:var(--viz-meta)"></i>44 B WAV header</span>
      <span><i style="--c:var(--viz-sound)"></i>sound</span>
      <span><i style="--c:var(--viz-net)"></i>sent</span>
    </div>
  </div>
  <ol class="ctl__cards" data-cards>
    {
      finished.map((c) => (
        <li class="ctl__card" data-state="sent">
          <div class="ctl__cardhead">
            <span class="ctl__n">chunk {c.n}</span>
            <span class="ctl__t">{c.range}</span>
          </div>
          <div class="ctl__file" aria-hidden="true">
            <span class="ctl__hdr">44 B</span>
            <span class="ctl__pcm">sound</span>
          </div>
          <span class="ctl__state">
            <span class="viz-dot" />
            <span data-state-text>sent</span>
          </span>
        </li>
      ))
    }
  </ol>

  <div class="ctl__math viz-panel">
    <div class="ctl__cell">
      <span class="viz-label">timer</span>
      <b>0.8 s</b>
      <span class="ctl__sub">per chunk</span>
    </div>
    <div class="ctl__cell">
      <span class="viz-label">48 kHz · 16-bit · mono</span>
      <b class="is-sound">76,800 B</b>
      <span class="ctl__sub">0.8 × 48,000 × 2</span>
    </div>
    <div class="ctl__cell">
      <span class="viz-label">resampled to 16 kHz</span>
      <b class="is-sound">25,600 B</b>
      <span class="ctl__sub">header stripped</span>
    </div>
    <div class="ctl__cell">
      <span class="viz-label">as base64 text</span>
      <b class="is-net">34,136 chars</b>
      <span class="ctl__sub">4 per 3 bytes, padded</span>
    </div>
  </div>
</VizFrame>

<script is:inline>
  (() => {
    function initChunkTimeline() {
      const root = document.querySelector('[data-ctl]');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const canvas = root.querySelector('[data-canvas]');
      const ctx = canvas.getContext('2d');
      if (!ctx) return;
      const cardsEl = root.querySelector('[data-cards]');
      const axis = root.querySelector('[data-axis]');
      const toggle = root.querySelector('[data-toggle]');
      const toggleText = root.querySelector('[data-toggle-text]');
      const liveText = root.querySelector('[data-live-text]');

      const CHUNK_S = 0.8; // the recorder's timer, in seconds of audio
      const REAL_PER_CHUNK = 1.2; // slowed down for reading
      const SPEED = CHUNK_S / REAL_PER_CHUNK;
      const VIEW_CHUNKS = 5;
      const VIEW_S = VIEW_CHUNKS * CHUNK_S;
      const HEAD_AT = 0.9; // once the head reaches 90% of the lane, the lane scrolls
      const MAX_CARDS = 5;
      const STRIP_AT = 0.3; // seconds of audio after a cut before the header goes
      const SENT_AT = 0.6;
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const pad = (n) => String(n).padStart(2, '0');
      const range = (i) =>
        `${(i * CHUNK_S).toFixed(1)}–${((i + 1) * CHUNK_S).toFixed(1)} s`;

      let W = 0;
      let H = 0;
      let colors = {};
      let t = VIEW_S; // audio seconds recorded so far
      let staticView = true; // the end state: five chunks, lane not scrolled
      let started = false;
      let userPaused = reduce;
      let running = false;
      let last = 0;
      let cards = [];

      const axisLabels = Array.from({ length: VIEW_CHUNKS + 2 }, () => {
        const s = document.createElement('span');
        axis.appendChild(s);
        return s;
      });

      function readColors() {
        const cs = getComputedStyle(root);
        const get = (n, f) => cs.getPropertyValue(n).trim() || f;
        colors = {
          sound: get('--viz-sound', 'green'),
          meta: get('--viz-meta', 'purple'),
          cut: get('--fg-muted', 'gray'),
          head: get('--fg', 'black'),
          faint: get('--border-strong', 'gray'),
        };
      }
      function size() {
        W = canvas.clientWidth || 640;
        H = canvas.clientHeight || 64;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(W * dpr);
        canvas.height = Math.round(H * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      // A deterministic, speech-like loudness envelope for any instant of audio.
      const hash = (i) => {
        const x = Math.sin(i * 12.9898) * 43758.5453;
        return x - Math.floor(x);
      };
      function amp(s) {
        const syl = Math.max(
          0,
          Math.sin(s * 2 * Math.PI * 1.6 + Math.sin(s * 0.9) * 2),
        );
        const phrase = 0.55 + 0.45 * Math.sin(s * 0.53 + 1);
        const env = 0.06 + 0.94 * Math.pow(syl, 1.4) * phrase;
        return Math.min(1, env * (0.45 + 0.55 * hash(Math.floor(s * 220))));
      }

      const viewStart = () =>
        staticView ? 0 : Math.max(0, t - HEAD_AT * VIEW_S);

      function draw() {
        const v0 = viewStart();
        const pps = W / VIEW_S;
        const headX = Math.min(W, (t - v0) * pps);
        const mid = H / 2;
        const now = Math.floor(t / CHUNK_S);
        ctx.clearRect(0, 0, W, H);

        // Closed chunks get a faint cup; the open one is brighter; a fresh cut flashes.
        const first = Math.floor(v0 / CHUNK_S);
        for (let k = first; k <= now; k++) {
          const x0 = (k * CHUNK_S - v0) * pps;
          const x1 = Math.min(headX, ((k + 1) * CHUNK_S - v0) * pps);
          if (x1 <= 0 || x0 >= W) continue;
          const since = t - (k + 1) * CHUNK_S;
          const flash =
            !staticView && since >= 0 && since < 0.3 ? 1 - since / 0.3 : 0;
          ctx.fillStyle = colors.sound;
          ctx.globalAlpha = k === now ? 0.14 : 0.05 + flash * 0.2;
          ctx.fillRect(x0, 0, x1 - x0, H);
        }
        ctx.globalAlpha = 1;

        ctx.strokeStyle = colors.faint;
        ctx.lineWidth = 1;
        ctx.setLineDash([2, 4]);
        ctx.beginPath();
        ctx.moveTo(headX, Math.round(mid) + 0.5);
        ctx.lineTo(W, Math.round(mid) + 0.5);
        ctx.stroke();
        ctx.setLineDash([]);

        ctx.strokeStyle = colors.sound;
        ctx.lineWidth = 1.5;
        ctx.lineCap = 'round';
        ctx.beginPath();
        const A = H / 2 - 8;
        for (let x = 1; x < headX; x += 3) {
          const a = Math.max(1, amp(v0 + x / pps) * A);
          ctx.moveTo(x, mid - a);
          ctx.lineTo(x, mid + a);
        }
        ctx.stroke();

        ctx.strokeStyle = colors.cut;
        ctx.lineWidth = 1.25;
        ctx.setLineDash([4, 3]);
        ctx.beginPath();
        for (let k = first + 1; k <= now; k++) {
          const x = Math.round((k * CHUNK_S - v0) * pps) + 0.5;
          if (x <= 0 || x >= W) continue;
          ctx.moveTo(x, 0);
          ctx.lineTo(x, H);
        }
        ctx.stroke();
        ctx.setLineDash([]);

        const hx = Math.min(W - 1, Math.max(1, headX));
        ctx.strokeStyle = colors.head;
        ctx.fillStyle = colors.head;
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(hx, 6);
        ctx.lineTo(hx, H);
        ctx.stroke();
        ctx.beginPath();
        ctx.arc(hx, 5, 3.5, 0, Math.PI * 2);
        ctx.fill();

        axisLabels.forEach((el, i) => {
          const k = first + i;
          const x = (k * CHUNK_S - v0) * pps;
          const show = x >= 0 && x <= W;
          el.hidden = !show;
          if (!show) return;
          el.style.left = `${(x / W) * 100}%`;
          el.textContent = `${(k * CHUNK_S).toFixed(1)} s`;
          el.classList.toggle('is-start', x < 18);
          el.classList.toggle('is-end', x > W - 18);
        });
      }

      function makeCard(i) {
        const li = document.createElement('li');
        li.className = 'ctl__card is-new';
        li.dataset.state = 'written';
        li.innerHTML =
          `<div class="ctl__cardhead"><span class="ctl__n">chunk ${pad(i + 1)}</span><span class="ctl__t">${range(i)}</span></div>` +
          '<div class="ctl__file" aria-hidden="true"><span class="ctl__hdr">44 B</span><span class="ctl__pcm">sound</span></div>' +
          `<span class="ctl__state"><span class="viz-dot"></span><span data-state-text>chunk_${pad(i + 1)}.wav</span></span>`;
        return li;
      }
      const LABELS = { written: null, stripping: 'header off', sent: 'sent' };

      function syncCards() {
        const closed = Math.floor(t / CHUNK_S);
        while (cards.length && cards[cards.length - 1].i >= closed)
          cards.pop().el.remove();
        const nextI = cards.length
          ? cards[cards.length - 1].i + 1
          : Math.max(0, closed - MAX_CARDS);
        for (let i = nextI; i < closed; i++) {
          const el = makeCard(i);
          cardsEl.appendChild(el);
          cards.push({ i, el });
          requestAnimationFrame(() => el.classList.remove('is-new'));
        }
        while (cards.length > MAX_CARDS) cards.shift().el.remove();
        cards.forEach((c) => {
          const since = t - (c.i + 1) * CHUNK_S;
          const st =
            since >= SENT_AT
              ? 'sent'
              : since >= STRIP_AT
                ? 'stripping'
                : 'written';
          if (c.el.dataset.state === st) return;
          c.el.dataset.state = st;
          if (LABELS[st])
            c.el.querySelector('[data-state-text]').textContent = LABELS[st];
        });
      }

      function updateLive() {
        if (staticView) {
          liveText.textContent = `${Math.floor(t / CHUNK_S)} chunks written`;
          return;
        }
        const k = Math.floor(t / CHUNK_S);
        const into = t - k * CHUNK_S;
        liveText.textContent = `writing chunk ${pad(k + 1)} · ${into.toFixed(2)} / 0.8 s`;
      }

      function frame(ts) {
        if (!running) return;
        const dt = last ? Math.min((ts - last) / 1000, 0.1) : 0;
        last = ts;
        t += dt * SPEED;
        syncCards();
        updateLive();
        draw();
        requestAnimationFrame(frame);
      }

      function begin() {
        cardsEl.textContent = '';
        cards = [];
        t = 0;
        staticView = false;
        started = true;
        root.classList.add('is-live');
      }

      function setButton() {
        const playing = !userPaused;
        toggle.setAttribute('aria-pressed', String(!playing));
        toggle.setAttribute(
          'aria-label',
          playing ? 'Pause the animation' : 'Play the animation',
        );
        toggleText.textContent = playing ? 'Pause' : 'Play';
        toggle.classList.toggle('is-paused', !playing);
      }

      function evaluate() {
        const want = !userPaused && root.dataset.inview === '1';
        if (want && !started) begin();
        if (want === running) return;
        running = want;
        last = 0;
        if (want) requestAnimationFrame(frame);
      }

      toggle.addEventListener('click', () => {
        userPaused = !userPaused;
        setButton();
        evaluate();
      });
      root.addEventListener('viz:inview', evaluate);

      const redraw = () => {
        size();
        draw();
      };
      if ('ResizeObserver' in window)
        new ResizeObserver(redraw).observe(canvas);
      else window.addEventListener('resize', redraw);
      new MutationObserver(() => {
        readColors();
        draw();
      }).observe(document.documentElement, {
        attributes: true,
        attributeFilter: ['data-theme', 'class'],
      });

      readColors();
      size();
      setButton();
      updateLive();
      draw();
      evaluate();
    }
    if (document.readyState !== 'loading') initChunkTimeline();
    else document.addEventListener('DOMContentLoaded', initChunkTimeline);
  })();
</script>

<style>
  .ctl__ico {
    display: none;
  }
  :global(.ctl .viz-btn:not(.is-paused)) .ctl__ico--pause,
  :global(.ctl .viz-btn.is-paused) .ctl__ico--play {
    display: block;
  }

  .ctl__lanehead,
  .ctl__cardshead {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 6px var(--sp-3);
    margin-bottom: var(--sp-2);
  }
  .ctl__live {
    font-variant-numeric: tabular-nums;
  }
  .ctl__lane {
    overflow: hidden;
  }
  .ctl__canvas {
    display: block;
    width: 100%;
    height: 72px;
  }
  .ctl__axis {
    position: relative;
    height: 16px;
    margin-top: 4px;
  }
  .ctl__axis :global(span) {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--fg-faint);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .ctl__axis :global(span.is-start) {
    transform: none;
  }
  .ctl__axis :global(span.is-end) {
    transform: translateX(-100%);
  }
  .ctl__axis :global(span[hidden]) {
    display: none;
  }

  .ctl__cardshead {
    margin-top: var(--sp-4);
  }
  .ctl__cards {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: var(--sp-2);
    min-height: 104px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ctl__cards :global(.ctl__card) {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 10px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition:
      opacity 0.35s var(--ease),
      transform 0.35s var(--ease),
      border-color 0.3s var(--ease);
  }
  .ctl__cards :global(.ctl__card.is-new) {
    opacity: 0;
    transform: translateY(-10px) scale(0.96);
  }
  .ctl__cards :global(.ctl__cardhead) {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 2px 6px;
  }
  .ctl__cards :global(.ctl__n) {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    color: var(--fg);
  }
  .ctl__cards :global(.ctl__t) {
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--fg-faint);
    font-variant-numeric: tabular-nums;
  }
  .ctl__cards :global(.ctl__file) {
    display: flex;
    height: 26px;
    overflow: hidden;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
  }
  .ctl__cards :global(.ctl__hdr),
  .ctl__cards :global(.ctl__pcm) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    overflow: hidden;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    white-space: nowrap;
  }
  .ctl__cards :global(.ctl__hdr) {
    position: relative;
    flex: 0 0 34%;
    color: var(--viz-meta);
    background: color-mix(in srgb, var(--viz-meta) 18%, var(--surface));
    border-right: 1px solid color-mix(in srgb, var(--viz-meta) 40%, transparent);
    transition:
      flex-basis 0.45s var(--ease),
      opacity 0.45s var(--ease);
  }
  .ctl__cards :global(.ctl__hdr)::after {
    content: '';
    position: absolute;
    left: 10%;
    right: 10%;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: var(--viz-bad);
    border-radius: 1px;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .ctl__cards :global(.ctl__pcm) {
    flex: 1 1 auto;
    color: var(--viz-sound-text);
    background: color-mix(in srgb, var(--viz-sound) 16%, var(--surface));
  }
  .ctl__cards :global(.ctl__state) {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    font-family: var(--font-mono);
    font-size: 10.5px;
    font-weight: 600;
    color: var(--viz-meta);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ctl__cards :global(.ctl__card[data-state='stripping'] .ctl__hdr)::after,
  .ctl__cards :global(.ctl__card[data-state='sent'] .ctl__hdr)::after {
    transform: scaleX(1);
  }
  .ctl__cards :global(.ctl__card[data-state='stripping'] .ctl__state) {
    color: var(--viz-bad);
  }
  .ctl__cards :global(.ctl__card[data-state='sent'] .ctl__hdr) {
    flex-basis: 20%;
    color: transparent;
    opacity: 0.45;
  }
  .ctl__cards :global(.ctl__card[data-state='sent']) {
    border-color: color-mix(in srgb, var(--viz-net) 45%, var(--border));
  }
  .ctl__cards :global(.ctl__card[data-state='sent'] .ctl__state) {
    color: var(--viz-net);
  }

  .ctl__math {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: var(--sp-4);
  }
  .ctl__cell {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
    padding: var(--sp-3);
  }
  .ctl__cell + .ctl__cell {
    border-left: 1px solid var(--border);
  }
  .ctl__cell b {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 700;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }
  .ctl__cell b.is-sound {
    color: var(--viz-sound-text);
  }
  .ctl__cell b.is-net {
    color: var(--viz-net);
  }
  .ctl__sub {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--fg-faint);
  }

  @media (max-width: 640px) {
    .ctl__math {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .ctl__cell:nth-child(3) {
      border-left: 0;
    }
    .ctl__cell:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
  @media (max-width: 560px) {
    .ctl__canvas {
      height: 60px;
    }
    .ctl__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    :global(.ctl.is-live)
      .ctl__cards
      :global(.ctl__card:nth-last-child(n + 4)) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ctl__cards :global(.ctl__card),
    .ctl__cards :global(.ctl__hdr),
    .ctl__cards :global(.ctl__hdr)::after {
      transition: none;
    }
  }
</style>
