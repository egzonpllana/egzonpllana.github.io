---
/**
 * A talk as a slide deck: one slide at a time with the transcript of what was
 * said under it, and a Present mode that takes the deck fullscreen. Render
 * once per page. Logic lives in src/lib/slideshow.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import DeckBlock from './DeckBlock.astro';
import { BlockKind, SlideLayout, type Slide } from '../data/deck';

interface Props {
  slides: Slide[];
  /** Cover art shown by SlideLayout.Cover slides. */
  cover?: ImageMetadata;
}

const { slides, cover } = Astro.props;
const isCover = (slide: Slide) =>
  slide.layout === SlideLayout.Cover && cover !== undefined;
const total = slides.length;
const pad = (n: number) => (n < 10 ? '0' + n : String(n));
---

<div class="deck" data-deck>
  <!-- ===== STAGE ===== -->
  <div
    class="deck-stage"
    id="deck-stage"
    data-deck-stage
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label="Talk slides - use the arrow keys to change slides, F to present"
  >
    <div class="deck-frame" data-deck-frame>
      {
        slides.map((slide) => (
          <article
            class:list={[
              'deck-slide',
              {
                'is-active': slide.n === 1,
                'deck-slide--center':
                  slide.layout === SlideLayout.Center ||
                  (slide.layout === SlideLayout.Cover && !cover),
                'deck-slide--cover': isCover(slide),
              },
            ]}
            data-index={slide.n}
            role="group"
            aria-roledescription="slide"
            aria-label={`Slide ${slide.n} of ${total}`}
            aria-hidden={slide.n === 1 ? 'false' : 'true'}
            data-transcript={slide.transcript}
          >
            {isCover(slide) && cover && (
              <Image
                class="deck-slide__cover"
                src={cover}
                alt=""
                widths={[960, 1440, 1920]}
                sizes="(max-width: 960px) 100vw, 1920px"
                format="webp"
                quality={92}
                loading="eager"
              />
            )}
            <span class="deck-slide__ghost" aria-hidden="true">
              {pad(slide.n)}
            </span>
            <span class="deck-slide__num">
              {pad(slide.n)} / {pad(total)}
            </span>
            <div class="deck-slide__content">
              <span class="deck-slide__kicker">
                <span class="deck-slide__dot" />
                {slide.kicker}
              </span>
              <h2 class="deck-slide__title" set:html={slide.titleHtml} />
              <div class="deck-slide__body">
                {slide.blocks.map((block) =>
                  block.kind === BlockKind.Columns ? (
                    <div
                      class:list={[
                        'deck-cols',
                        { 'deck-cols--wide': block.variant === 'wide' },
                      ]}
                    >
                      {block.cols.map((col) => (
                        <div class="deck-col">
                          {col.map((leaf) => (
                            <DeckBlock block={leaf} />
                          ))}
                        </div>
                      ))}
                    </div>
                  ) : (
                    <DeckBlock block={block} />
                  ),
                )}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <!-- ===== TRANSCRIPT ===== -->
  <div class="deck-transcript">
    <span class="deck-transcript__eyebrow">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M12 3a4 4 0 0 0-4 4v3a4 4 0 0 0 8 0V7a4 4 0 0 0-4-4z"
        ></path><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg
      >
      Transcript
    </span>
    <p class="deck-transcript__text" data-deck-transcript aria-live="polite">
      {slides[0]?.transcript}
    </p>
  </div>

  <!-- ===== CONTROLS (under the transcript) ===== -->
  <div class="deck-controls" role="group" aria-label="Slideshow controls">
    <div class="deck-progress"><i data-deck-fill></i></div>
    <div class="deck-controls__bar">
      <button
        class="deck-btn"
        data-deck-prev
        type="button"
        aria-label="Previous slide"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M15 18l-6-6 6-6"></path></svg
        >
      </button>
      <div class="deck-counter" data-deck-counter>
        <b>{pad(1)}</b> / {pad(total)}
      </div>
      <button
        class="deck-btn"
        data-deck-next
        type="button"
        aria-label="Next slide"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M9 6l6 6-6 6"></path></svg
        >
      </button>
      <button
        class="deck-btn deck-btn--notes"
        data-deck-notes
        type="button"
        aria-pressed="false"
        aria-label="Transcript"
        aria-keyshortcuts="T"
        title="Transcript (T)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M5 6h14M5 10h14M5 14h9M5 18h6"></path></svg
        >
      </button>
      <button
        class="deck-btn deck-btn--present"
        data-deck-present
        data-mode="inline"
        type="button"
        aria-pressed="false"
        aria-label="Present fullscreen"
        aria-keyshortcuts="F"
        title="Present fullscreen (F)"
      >
        <svg
          class="deck-btn__icon--enter"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg
        >
        <svg class="deck-btn__icon--exit" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"></path></svg
        >
        <span class="deck-btn__label">Present</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { startTalkDeck } from '../lib/slideshow';

  startTalkDeck();
</script>

<style>
  .deck {
    margin-top: var(--sp-6);
  }

  /* ===== STAGE - active slide sizes the stage; others overlay for cross-fade ===== */
  .deck-stage {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    overflow: hidden;
  }
  .deck-stage:focus:not(:focus-visible) {
    outline: none;
  }
  .deck-stage:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .deck-frame {
    position: relative;
  }
  .deck-slide {
    position: absolute;
    inset: 0;
    min-width: 0;
    padding: clamp(1.25rem, 0.8rem + 2.5vw, 3rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
    display: flex;
    flex-direction: column;
    min-height: 340px;
  }
  .deck-slide.is-active {
    position: relative;
    inset: auto;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }
  .deck-slide--center {
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .deck-slide__content {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }
  .deck-slide--center .deck-slide__content,
  .deck-slide--center .deck-slide__body {
    align-items: center;
  }
  .deck-slide--center :global(.deck-lead) {
    margin-inline: auto;
  }

  /* ===== BACKDROP: accent glow and the slide number, large and faint ===== */
  .deck-slide {
    isolation: isolate;
  }
  .deck-slide::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(55% 60% at 100% 0%, var(--accent-soft), transparent 70%),
      radial-gradient(45% 50% at 0% 100%, var(--accent-soft), transparent 70%);
  }
  .deck-slide__ghost {
    position: absolute;
    right: 0.25rem;
    bottom: -0.2em;
    z-index: -1;
    font-size: clamp(7rem, 4rem + 10vw, 15rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.06em;
    font-variant-numeric: tabular-nums;
    color: color-mix(in srgb, var(--fg) 4.5%, transparent);
    pointer-events: none;
    user-select: none;
  }

  /* ===== COVER: the talk's art fills the slide ===== */
  .deck-slide--cover {
    padding: 0;
    aspect-ratio: 16 / 9;
    min-height: 0;
    overflow: hidden;
    background: #0b0e14;
  }
  .deck-slide__cover {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .deck-slide--cover::before,
  .deck-slide--cover .deck-slide__ghost,
  .deck-slide--cover .deck-slide__num {
    display: none;
  }
  .deck-slide--cover .deck-slide__kicker,
  .deck-slide--cover .deck-slide__title,
  .deck-slide--cover .deck-slide__body {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ===== MOTION: each slide builds in as it becomes active ===== */
  .deck-slide__body > :global(:nth-child(1)) {
    --b: 0;
  }
  .deck-slide__body > :global(:nth-child(2)) {
    --b: 1;
  }
  .deck-slide__body > :global(:nth-child(3)) {
    --b: 2;
  }
  .deck-slide__body > :global(:nth-child(n + 4)) {
    --b: 3;
  }
  @media (prefers-reduced-motion: no-preference) {
    .deck-slide.is-active .deck-slide__kicker {
      animation: deck-rise 0.5s var(--ease) both;
    }
    .deck-slide.is-active .deck-slide__dot {
      animation: deck-grow 0.7s var(--ease) 0.1s both;
    }
    .deck-slide.is-active .deck-slide__title {
      animation: deck-rise 0.65s var(--ease) 0.08s both;
    }
    .deck-slide.is-active .deck-slide__body > :global(*) {
      animation: deck-rise 0.6s var(--ease) both;
      animation-delay: calc(0.2s + var(--b, 0) * 0.14s);
    }
    .deck-slide.is-active :global(.deck-pill),
    .deck-slide.is-active :global(.deck-card),
    .deck-slide.is-active :global(.deck-check),
    .deck-slide.is-active :global(.deck-stat) {
      animation: deck-pop 0.55s var(--ease) both;
      animation-delay: calc(0.3s + var(--b, 0) * 0.14s + var(--i, 0) * 0.08s);
    }
    .deck-slide.is-active :global(.deck-code__row) {
      animation: deck-type 0.4s var(--ease) both;
      animation-delay: calc(0.35s + var(--b, 0) * 0.14s + var(--i, 0) * 0.05s);
    }
    .deck-slide.is-active :global(.deck-check__mark) {
      animation: deck-tick 0.45s var(--ease) both;
      animation-delay: calc(0.45s + var(--b, 0) * 0.14s + var(--i, 0) * 0.08s);
    }
    .deck-slide.is-active .deck-slide__ghost {
      animation: deck-ghost 0.9s var(--ease) 0.1s both;
    }
    .deck-slide.is-active .deck-slide__cover {
      animation: deck-cover 1.4s var(--ease) both;
    }
    @keyframes deck-rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes deck-pop {
      from {
        opacity: 0;
        transform: translateY(12px) scale(0.97);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes deck-type {
      from {
        opacity: 0;
        transform: translateX(-8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes deck-tick {
      from {
        opacity: 0;
        transform: scale(0.4) rotate(-12deg);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes deck-grow {
      from {
        width: 0;
      }
      to {
        width: 28px;
      }
    }
    @keyframes deck-ghost {
      from {
        opacity: 0;
        transform: translateX(40px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
    @keyframes deck-cover {
      from {
        opacity: 0.4;
        transform: scale(1.05);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  .deck-slide__num {
    position: absolute;
    top: clamp(1.1rem, 1rem + 1vw, 1.6rem);
    right: clamp(1.2rem, 1rem + 1vw, 1.8rem);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-faint);
    letter-spacing: 0.08em;
  }
  .deck-slide__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--sp-4);
  }
  .deck-slide__dot {
    width: 28px;
    height: 1px;
    background: currentColor;
    flex: 0 0 auto;
  }
  .deck-slide__title {
    font-size: clamp(1.5rem, 1.05rem + 2.2vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-4);
    overflow-wrap: anywhere;
  }
  .deck-slide__title :global(.hl) {
    color: var(--accent);
  }
  .deck-slide__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    min-width: 0;
  }
  .deck-slide__body > :global(*) {
    min-width: 0;
    max-width: 100%;
  }

  /* Numbers on their own span the slide in a row; inside a column they stack. */
  .deck-slide__body > :global(.deck-stats) {
    flex-direction: row;
    flex-wrap: wrap;
    gap: var(--sp-5) var(--sp-7);
  }
  .deck-slide__body > :global(.deck-stats > .deck-stat) {
    flex: 1 1 12rem;
  }
  .deck-slide--center .deck-slide__body > :global(.deck-stats) {
    align-self: stretch;
    justify-content: center;
  }
  .deck-slide--center .deck-slide__body > :global(.deck-stats > .deck-stat) {
    flex: 0 1 12rem;
  }

  /* Columns inside a slide */
  .deck-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: start;
  }
  .deck-cols--wide {
    grid-template-columns: 1.08fr 0.92fr;
  }
  .deck-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    min-width: 0;
  }

  /* ===== CONTROLS ===== */
  .deck-controls {
    margin-top: var(--sp-4);
  }
  .deck-progress {
    height: 2px;
    border-radius: 1px;
    background: var(--border);
    overflow: hidden;
  }
  .deck-progress > i {
    display: block;
    height: 100%;
    width: 5.88%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.4s var(--ease);
  }
  .deck-controls__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
    flex-wrap: wrap;
  }
  .deck-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--fg-muted);
    transition:
      background 0.16s var(--ease),
      border-color 0.16s var(--ease),
      transform 0.16s var(--ease),
      opacity 0.16s var(--ease);
  }
  .deck-btn:hover:not(:disabled) {
    color: var(--fg);
    border-color: var(--fg-faint);
  }
  .deck-btn:active:not(:disabled) {
    transform: scale(0.92);
  }
  .deck-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .deck-btn svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 1.75;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .deck-btn--present {
    width: auto;
    gap: 0.5rem;
    margin-left: auto;
    padding-inline: 0.85rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .deck-btn--present svg {
    width: 18px;
    height: 18px;
  }
  .deck-btn--present[data-mode='inline'] .deck-btn__icon--exit,
  .deck-btn--present[data-mode='presenting'] .deck-btn__icon--enter,
  .deck-btn--present[data-mode='presenting'] .deck-btn__label {
    display: none;
  }
  .deck-btn--notes {
    display: none;
  }
  .deck-counter {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
    min-width: 66px;
    text-align: center;
  }
  .deck-counter :global(b) {
    color: var(--fg);
    font-weight: 500;
  }

  /* ===== TRANSCRIPT ===== */
  .deck-transcript {
    margin-top: var(--sp-5);
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .deck-transcript__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: var(--sp-3);
  }
  .deck-transcript__eyebrow svg {
    width: 15px;
    height: 15px;
    stroke: var(--accent);
    stroke-width: 1.7;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .deck-transcript__text {
    color: var(--fg-muted);
    line-height: 1.7;
    font-size: var(--fs-md);
  }

  @media (prefers-reduced-motion: no-preference) {
    .deck-transcript__text.swap-in {
      animation: deck-swap 0.4s var(--ease);
    }
    @keyframes deck-swap {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* ===== PRESENT MODE ===== */
  :global(html.deck-presenting) {
    overflow: hidden;
  }
  .deck.is-presenting {
    position: fixed;
    inset: 0;
    z-index: 100;
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }
  .is-presenting.is-idle {
    cursor: none;
  }
  /* The glow spans the screen, not the letterboxed frame. */
  .is-presenting .deck-stage {
    flex: 1 1 auto;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background:
      radial-gradient(50% 60% at 100% 0%, var(--accent-soft), transparent 70%),
      radial-gradient(40% 50% at 0% 100%, var(--accent-soft), transparent 70%),
      var(--bg);
  }
  .is-presenting .deck-slide::before {
    display: none;
  }
  .is-presenting .deck-stage:focus-visible {
    outline: none;
  }

  /* Landscape: fixed 16:9 frame, scaled into the stage. */
  /* Zoom, not a scale transform: the slide is laid out again at screen size,
     so text, code and figures render at full resolution. */
  .is-presenting[data-orient='landscape'] .deck-frame {
    position: absolute;
    inset: 0 0 var(--frame-reserve, 0px) 0;
    margin: auto;
    width: var(--frame-w, 1152px);
    height: var(--frame-h, 648px);
    zoom: var(--fit, 1);
  }
  .is-presenting[data-orient='landscape'] .deck-slide,
  .is-presenting[data-orient='landscape'] .deck-slide.is-active {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 100%;
    min-height: 0;
    padding: 3.25rem 4rem;
    overflow: hidden;
    transform: translateY(6px);
  }
  .is-presenting[data-orient='landscape'] .deck-slide.is-active {
    transform: none;
  }
  /* A body taller than the frame is zoomed down; the title and the backdrop
     keep their size. */
  .is-presenting[data-orient='landscape'] .deck-slide__content {
    flex: 0 0 auto;
  }
  .is-presenting[data-orient='landscape'] .deck-slide__body {
    zoom: var(--slide-fit, 1);
  }
  .is-presenting[data-orient='landscape'] .deck-slide:not(.deck-slide--cover) {
    justify-content: center;
  }
  .is-presenting[data-orient='landscape'] .deck-slide--cover {
    padding: 0;
  }
  .is-presenting[data-orient='landscape'] .deck-slide__ghost {
    font-size: 15rem;
  }
  .is-presenting[data-orient='landscape'] .deck-slide__num {
    display: block;
    top: 1.75rem;
    right: 2rem;
  }
  .is-presenting[data-orient='landscape'] .deck-slide__title {
    font-size: 2.6rem;
  }
  .is-presenting[data-orient='landscape'] .deck-cols {
    grid-template-columns: 1fr 1fr;
  }
  .is-presenting[data-orient='landscape'] .deck-cols--wide {
    grid-template-columns: 1.08fr 0.92fr;
  }
  .is-presenting[data-orient='landscape'] :global(.deck-cards--2),
  .is-presenting[data-orient='landscape'] :global(.deck-checks--2col) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .is-presenting[data-orient='landscape'] :global(.deck-cards--3) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .is-presenting[data-orient='landscape'] :global(.deck-quote) {
    font-size: var(--fs-xl);
  }

  /* Portrait: responsive slide at full width, scrolling when long. */
  .is-presenting[data-orient='portrait'] .deck-frame {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .is-presenting[data-orient='portrait'] .deck-slide {
    padding-top: max(1.5rem, env(safe-area-inset-top));
    padding-bottom: 6rem;
  }
  .is-presenting[data-orient='portrait'] .deck-slide.is-active {
    min-height: 100%;
  }

  /* Transcript: shown while presenting unless toggled off (T). */
  .is-presenting .deck-transcript {
    display: none;
  }
  .is-presenting[data-notes='on'] .deck-transcript {
    display: block;
