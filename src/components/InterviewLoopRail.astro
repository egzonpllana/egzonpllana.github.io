---
/**
 * The five stages of a senior iOS loop as one rail. Pick a stage to see who
 * is across the table, how long it runs, what it scores and where it is
 * usually lost. Every line is taken from the guide's own account of the loop;
 * nothing here is employer-specific.
 */
import VizFrame from './viz/VizFrame.astro';

interface Props {
  fig?: string;
  caption?: string;
}
const {
  fig = '01',
  caption = 'Five stages, prepared in this order even when a company merges or skips some. Only one of the four things the screen scores is technical; the technical round is one continuous task graded on four criteria at once. Most of the loop is lost on delivery rather than on knowledge.',
} = Astro.props;

interface Stage {
  key: string;
  short: string;
  name: string;
  length: string;
  who: string;
  scored: string[];
  lost: string;
  prep: string;
}

const STAGES: Stage[] = [
  {
    key: 'screen',
    short: 'Screen',
    name: 'Recruiter screen',
    length: '~30 min',
    who: 'One interviewer on video: a recruiter, or a technically literate colleague. Not the two senior engineers you meet later.',
    scored: [
      'structure',
      'impact, with numbers',
      'product ownership',
      'whether you want it',
    ],
    lost: 'Answers sized for depth you will never reach. About nine of the thirty minutes are technical, which leaves ninety seconds per answer, not four minutes.',
    prep: 'A 15-second positioning line, three STAR stories, five questions to ask.',
  },
  {
    key: 'test',
    short: 'Test',
    name: 'Coding test or take-home',
    length: 'timed, or ~3 h',
    who: 'A timed online assessment, or an iOS app built at home to a “production ready” brief.',
    scored: [
      'the right structure, quickly',
      'Swift that does not embarrass you',
      'scope judgement',
      'the README',
    ],
    lost: 'Money held in a Double. On a take-home, scope inflation: one account describes twelve hours spent and the round still failed.',
    prep: 'Fifteen to twenty medium problems, then the Swift-specific traps.',
  },
  {
    key: 'tech',
    short: 'Technical',
    name: 'Technical interview',
    length: '1–2 h',
    who: 'Two senior engineers. iOS and patterns first, then about 45 minutes building one continuous task.',
    scored: [
      'code quality',
      'testing',
      'resilience (UX)',
      'concurrency and architecture',
    ],
    lost: 'Perfecting one criterion at 10/10 and never reaching the other three. Tests bolted on at minute 40.',
    prep: 'The isolation drill, cancellation and staleness, a state enum in the first five minutes.',
  },
  {
    key: 'lead',
    short: 'Lead',
    name: 'Hiring manager or tech lead',
    length: 'behavioural',
    who: 'Behavioural, occasionally adversarial. Dismissiveness can be deliberate.',
    scored: [
      'four story shapes',
      'numbers in the result',
      'staying flat under pushback',
    ],
    lost: 'A minute of context before the action. Folding or escalating when pushed.',
    prep: 'Three stories, ninety seconds each, mapped to the questions they answer.',
  },
  {
    key: 'outcome',
    short: 'Outcome',
    name: 'Recruiter with the outcome',
    length: 'short',
    who: 'The recruiter again, with the decision.',
    scored: [],
    lost: '',
    prep: '',
  },
];
---

<VizFrame
  fig={fig}
  title="The loop: five stages, and what each one scores"
  caption={caption}
  class="ilr"
  data-ilr
  label="The five stages of a senior iOS interview loop. Select a stage to see who interviews, how long it lasts, what is scored and where it is usually lost."
>
  <ol class="ilr__rail" role="group" aria-label="Interview stages">
    {
      STAGES.map((s, i) => (
        <li class="ilr__stop">
          <button
            type="button"
            class="ilr__btn"
            data-stage={s.key}
            aria-pressed={i === 0 ? 'true' : 'false'}
          >
            <span class="ilr__num viz-mono">{`0${i + 1}`}</span>
            <span class="ilr__name">{s.short}</span>
            <span class="ilr__len viz-mono">{s.length}</span>
          </button>
        </li>
      ))
    }
  </ol>

  {
    STAGES.map((s, i) => (
      <div class="ilr__detail viz-panel" data-panel={s.key} hidden={i !== 0}>
        <div class="ilr__head">
          <h4 class="ilr__title">{s.name}</h4>
          <span class="viz-chip viz-chip--level">{s.length}</span>
        </div>
        <p class="ilr__who">{s.who}</p>
        <div class="ilr__row">
          <span class="viz-label">scored on</span>
          {s.scored.length > 0 ? (
            <ul class="ilr__chips">
              {s.scored.map((item) => (
                <li class="viz-chip viz-chip--meta">{item}</li>
              ))}
            </ul>
          ) : (
            <span class="ilr__none">Nothing new is scored here.</span>
          )}
        </div>
        {s.lost && (
          <p class="ilr__lost">
            <span class="viz-label">where it is lost</span>
            {s.lost}
          </p>
        )}
        {s.prep && (
          <p class="ilr__prep">
            <span class="viz-label">prepare</span>
            {s.prep}
          </p>
        )}
      </div>
    ))
  }

  <p class="ilr__note viz-mono">
    Stages get merged and skipped under headcount pressure. Prepare for all
    five.
  </p>
</VizFrame>

<script is:inline>
  (() => {
    function initLoopRail(root) {
      if (root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const buttons = [...root.querySelectorAll('[data-stage]')];
      const panels = [...root.querySelectorAll('[data-panel]')];

      const select = (key, focus) => {
        buttons.forEach((b) => {
          const on = b.dataset.stage === key;
          b.setAttribute('aria-pressed', String(on));
          if (on && focus) b.focus();
        });
        panels.forEach((p) => (p.hidden = p.dataset.panel !== key));
        const index = buttons.findIndex((b) => b.dataset.stage === key);
        root.style.setProperty('--ilr-at', String(index));
      };

      buttons.forEach((b, i) => {
        b.addEventListener('click', () => select(b.dataset.stage, false));
        b.addEventListener('keydown', (e) => {
          const step =
            e.key === 'ArrowRight' || e.key === 'ArrowDown'
              ? 1
              : e.key === 'ArrowLeft' || e.key === 'ArrowUp'
                ? -1
                : 0;
          if (!step) return;
          e.preventDefault();
          const next = (i + step + buttons.length) % buttons.length;
          select(buttons[next].dataset.stage, true);
        });
      });

      select(buttons[0].dataset.stage, false);
    }

    const boot = () =>
      document.querySelectorAll('[data-ilr]').forEach(initLoopRail);
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);
  })();
</script>

<style>
  .ilr__rail {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
    margin-bottom: var(--sp-3) !important;
  }
  /* The rail line behind the stops, filled up to the selected stage. */
  .ilr__rail::before,
  .ilr__rail::after {
    content: '';
    position: absolute;
    top: 21px;
    left: 10%;
    height: 2px;
    border-radius: 2px;
    pointer-events: none;
  }
  .ilr__rail::before {
    right: 10%;
    background: var(--border-strong);
  }
  .ilr__rail::after {
    width: calc(var(--ilr-at, 0) * 20%);
    background: var(--viz-sound);
    transition: width 0.3s var(--ease);
  }
  .ilr__stop {
    position: relative;
    z-index: 1;
    min-width: 0;
  }
  .ilr__btn {
    display: grid;
    justify-items: center;
    gap: 4px;
    width: 100%;
    padding: 6px 2px 8px;
    color: var(--fg-muted);
    background: transparent;
    border: 1px solid transparent;
    border-radius: var(--radius);
    cursor: pointer;
    transition:
      background 0.15s var(--ease),
      border-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }
  .ilr__btn:hover {
    color: var(--fg);
    border-color: var(--border);
  }
  .ilr__btn:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .ilr__num {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    font-size: 11px;
    font-weight: 600;
    color: var(--fg-muted);
    background: var(--viz-panel);
    border: 1.5px solid var(--border-strong);
    border-radius: 50%;
  }
  .ilr__name {
    max-width: 100%;
    overflow: hidden;
    font-size: var(--fs-xs);
    font-weight: 600;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .ilr__len {
    font-size: 10.5px;
    color: var(--fg-faint);
    white-space: nowrap;
  }
  .ilr__btn[aria-pressed='true'] {
    color: var(--fg);
    background: var(--viz-panel);
    border-color: var(--border);
  }
  .ilr__btn[aria-pressed='true'] .ilr__num {
    color: var(--accent-fg);
    background: var(--viz-sound);
    border-color: var(--viz-sound);
  }

  .ilr__detail {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
  }
  .ilr__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2);
  }
  .ilr__title {
    margin: 0;
    font-size: var(--fs-base);
  }
  .ilr__who,
  .ilr__lost,
  .ilr__prep {
    margin: 0;
    font-size: var(--fs-sm);
    line-height: 1.55;
    color: var(--fg-muted);
  }
  .ilr__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-2);
  }
  .ilr__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .ilr__chips .viz-chip {
    white-space: normal;
  }
  .ilr__none {
    font-size: var(--fs-sm);
    color: var(--fg-muted);
  }
  .ilr__lost,
  .ilr__prep {
    display: grid;
    gap: 2px;
    padding-left: var(--sp-3);
    border-left: 3px solid var(--viz-bad);
  }
  .ilr__prep {
    border-left-color: var(--viz-sound);
  }
  .ilr__note {
    margin: var(--sp-3) 0 0;
    font-size: 11px;
    color: var(--fg-faint);
  }

  @media (max-width: 560px) {
    .ilr__len {
      display: none;
    }
    .ilr__name {
      font-size: 10.5px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ilr__rail::after,
    .ilr__btn {
      transition: none;
    }
  }
</style>
