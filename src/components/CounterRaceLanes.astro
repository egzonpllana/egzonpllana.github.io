---
/**
 * Two increments of one shared counter, one machine step at a time.
 * `count += 1` is three steps: load into a register, add, store back.
 *
 * "class, no lock": two threads interleave the steps and one increment is
 * lost. "actor": both callers enqueue a job, and the actor runs one job to the
 * end before it starts the next, so the same three steps cannot interleave.
 *
 * The figure is the mechanism behind the probe in the article: two threads,
 * 1,000,000 increments each, about 46% lost in a release build.
 */
import VizFrame from './viz/VizFrame.astro';
import AnimControls from './viz/AnimControls.astro';

interface Props {
  fig?: string;
  caption?: string;
}
const {
  fig = '01',
  caption = 'count += 1 is a load, an add and a store. Two threads that interleave those steps both read the same old value, and the second store overwrites the first: two increments, one counted. An actor does not make the steps atomic; it runs one caller’s job to the end before it starts the next one.',
} = Astro.props;

interface Lane {
  op: string;
  reg: string;
  state: 'idle' | 'run' | 'wait' | 'done';
}
interface Step {
  lanes: [Lane, Lane];
  count: number;
  calls: number;
  mailbox?: string[];
  running?: string;
  text: string;
  bad?: boolean;
}
interface Variant {
  lanes: [string, string];
  middle: string;
  steps: Step[];
}

const idle = (op = 'not started'): Lane => ({ op, reg: '–', state: 'idle' });

const variants: Record<'racy' | 'actor', Variant> = {
  racy: {
    lanes: ['Thread 1', 'Thread 2'],
    middle: 'shared memory',
    steps: [
      {
        lanes: [idle(), idle()],
        count: 0,
        calls: 0,
        text: 'One Counter instance, count = 0. Two threads call increment() at the same moment.',
      },
      {
        lanes: [{ op: 'load count', reg: '0', state: 'run' }, idle()],
        count: 0,
        calls: 1,
        text: 'Thread 1 loads count into its register: 0.',
      },
      {
        lanes: [
          { op: 'load count', reg: '0', state: 'wait' },
          { op: 'load count', reg: '0', state: 'run' },
        ],
        count: 0,
        calls: 2,
        text: 'Before Thread 1 stores anything, Thread 2 loads count too. It also reads 0.',
        bad: true,
      },
      {
        lanes: [
          { op: 'add 1', reg: '1', state: 'run' },
          { op: 'add 1', reg: '1', state: 'run' },
        ],
        count: 0,
        calls: 2,
        text: 'Each thread adds 1 to its own register. Both registers now hold 1.',
        bad: true,
      },
      {
        lanes: [
          { op: 'store', reg: '1', state: 'done' },
          { op: 'add 1', reg: '1', state: 'wait' },
        ],
        count: 1,
        calls: 2,
        text: 'Thread 1 stores 1. Its increment is done.',
      },
      {
        lanes: [
          { op: 'store', reg: '1', state: 'done' },
          { op: 'store', reg: '1', state: 'done' },
        ],
        count: 1,
        calls: 2,
        text: 'Thread 2 stores its 1 over Thread 1’s 1. Two increments ran; count went up by one. Nothing crashed and nothing was logged.',
        bad: true,
      },
    ],
  },
  actor: {
    lanes: ['Task A', 'Task B'],
    middle: 'actor CounterActor',
    steps: [
      {
        lanes: [idle(), idle()],
        count: 0,
        calls: 0,
        mailbox: [],
        text: 'One CounterActor, count = 0. Two tasks call await counter.increment() at the same moment.',
      },
      {
        lanes: [
          { op: 'await increment()', reg: '–', state: 'wait' },
          { op: 'await increment()', reg: '–', state: 'wait' },
        ],
        count: 0,
        calls: 2,
        mailbox: ['A: increment', 'B: increment'],
        text: 'Neither task touches count. Each call becomes a job in the actor’s queue, and each task suspends until its job has run.',
      },
      {
        lanes: [
          { op: 'job running', reg: '0 → 1', state: 'run' },
          { op: 'queued', reg: '–', state: 'wait' },
        ],
        count: 1,
        calls: 2,
        mailbox: ['B: increment'],
        running: 'A',
        text: 'The actor runs A’s job: load 0, add, store 1. B’s job waits in the queue; no other code can touch count now.',
      },
      {
        lanes: [
          { op: 'resumed', reg: '–', state: 'done' },
          { op: 'job running', reg: '1 → 2', state: 'run' },
        ],
        count: 2,
        calls: 2,
        mailbox: [],
        running: 'B',
        text: 'A’s job is finished, so A resumes. The actor runs B’s job: load 1, add, store 2.',
      },
      {
        lanes: [
          { op: 'resumed', reg: '–', state: 'done' },
          { op: 'resumed', reg: '–', state: 'done' },
        ],
        count: 2,
        calls: 2,
        mailbox: [],
        text: 'Two increments, count = 2. The steps are the same three; the actor only guarantees that one job at a time runs them.',
      },
    ],
  },
};
---

<VizFrame
  fig={fig}
  title="One counter, two increments"
  caption={caption}
  class="crl"
  data-crl
>
  <div slot="tools" class="crl__tools">
    <button type="button" class="viz-btn" data-next aria-label="Next step"
      >step</button
    >
    <AnimControls label="Race" />
  </div>

  <div class="crl__bar">
    <div class="viz-seg" role="group" aria-label="Who owns the counter">
      <button type="button" aria-pressed="true" data-variant="racy"
        >class, no lock</button
      >
      <button type="button" aria-pressed="false" data-variant="actor"
        >actor</button
      >
    </div>
    <span class="viz-mono crl__counter" data-counter></span>
  </div>

  <div class="crl__board">
    <div class="crl__lane viz-panel" data-lane="0">
      <span class="viz-label" data-lane-name>Thread 1</span>
      <span class="crl__op" data-op></span>
      <span class="crl__reg viz-mono"
        ><span class="crl__reg-name">register</span> <b data-reg>–</b></span
      >
    </div>

    <div class="crl__mid viz-panel">
      <span class="crl__mid-name viz-mono" data-mid-name>shared memory</span>
      <span class="crl__cell viz-mono"
        >count = <b class="crl__count" data-count>0</b></span
      >
      <div class="crl__mailbox" data-mailbox-wrap>
        <span class="viz-label">queue</span>
        <ol class="crl__jobs" data-mailbox></ol>
      </div>
    </div>

    <div class="crl__lane viz-panel" data-lane="1">
      <span class="viz-label" data-lane-name>Thread 2</span>
      <span class="crl__op" data-op></span>
      <span class="crl__reg viz-mono"
        ><span class="crl__reg-name">register</span> <b data-reg>–</b></span
      >
    </div>
  </div>

  <div class="crl__tally viz-mono" aria-hidden="true">
    <span>increment() calls <b data-calls>0</b></span>
    <span>count <b data-tally-count>0</b></span>
    <span data-lost-wrap>lost <b data-lost>0</b></span>
  </div>

  <p class="crl__text" data-text aria-live="polite"></p>

  <div class="viz-legend crl__legend" aria-hidden="true">
    <span><i style="--c:var(--viz-sound)"></i>the shared value</span>
    <span><i style="--c:var(--viz-net)"></i>a caller doing a step</span>
    <span><i style="--c:var(--viz-meta)"></i>actor and its queue</span>
    <span><i style="--c:var(--viz-bad)"></i>lost update</span>
  </div>

  <script
    is:inline
    type="application/json"
    data-crl-data
    set:html={JSON.stringify(variants)}
  />
</VizFrame>

<script is:inline>
  (() => {
    const STEP_MS = 2400;

    function initCounterRace(root) {
      if (root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const data = JSON.parse(
        root.querySelector('[data-crl-data]').textContent,
      );
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const lanes = [...root.querySelectorAll('[data-lane]')];
      const midName = root.querySelector('[data-mid-name]');
      const countEl = root.querySelector('[data-count]');
      const mailboxWrap = root.querySelector('[data-mailbox-wrap]');
      const mailboxEl = root.querySelector('[data-mailbox]');
      const callsEl = root.querySelector('[data-calls]');
      const tallyCountEl = root.querySelector('[data-tally-count]');
      const lostEl = root.querySelector('[data-lost]');
      const lostWrap = root.querySelector('[data-lost-wrap]');
      const textEl = root.querySelector('[data-text]');
      const counterEl = root.querySelector('[data-counter]');
      const segBtns = [...root.querySelectorAll('[data-variant]')];

      let variant = 'racy';
      let current = 0;
      let playing = false;
      let timer = 0;

      const steps = () => data[variant].steps;
      const last = () => steps().length - 1;

      function render() {
        const v = data[variant];
        const s = v.steps[current];
        root.dataset.variant = variant;
        lanes.forEach((el, i) => {
          const lane = s.lanes[i];
          el.querySelector('[data-lane-name]').textContent = v.lanes[i];
          el.querySelector('[data-op]').textContent = lane.op;
          el.querySelector('[data-reg]').textContent = lane.reg;
          el.dataset.state = lane.state;
          el.classList.toggle(
            'is-running',
            Boolean(s.running) && s.running === 'AB'[i],
          );
        });
        midName.textContent = v.middle;
        countEl.textContent = String(s.count);
        mailboxWrap.hidden = s.mailbox === undefined;
        mailboxEl.replaceChildren(
          ...(s.mailbox || []).map((job) => {
            const li = document.createElement('li');
            li.className = 'viz-chip viz-chip--meta';
            li.textContent = job;
            return li;
          }),
        );
        if (s.mailbox && s.mailbox.length === 0) {
          const li = document.createElement('li');
          li.className = 'crl__empty';
          li.textContent = 'empty';
          mailboxEl.append(li);
        }
        const finished = current === last();
        const lost = finished ? s.calls - s.count : 0;
        callsEl.textContent = String(s.calls);
        tallyCountEl.textContent = String(s.count);
        lostEl.textContent = finished ? String(lost) : '–';
        lostWrap.classList.toggle('is-bad', lost > 0);
        textEl.textContent = s.text;
        textEl.classList.toggle('is-bad', Boolean(s.bad));
        root.classList.toggle('is-bad', lost > 0);
        counterEl.textContent = `${current + 1} / ${v.steps.length}`;
      }

      function stop() {
        playing = false;
        clearTimeout(timer);
      }

      function schedule() {
        clearTimeout(timer);
        if (!playing) return;
        timer = setTimeout(() => {
          current += 1;
          render();
          if (current >= last()) {
            playing = false;
            root.dispatchEvent(new CustomEvent('anim:ended'));
            return;
          }
          schedule();
        }, STEP_MS);
      }

      function play() {
        if (playing) return;
        if (current >= last()) {
          root.dispatchEvent(new CustomEvent('anim:ended'));
          return;
        }
        playing = true;
        schedule();
      }

      function reset() {
        stop();
        current = 0;
        render();
      }

      root.querySelector('[data-next]').addEventListener('click', () => {
        stop();
        current = current >= last() ? 0 : current + 1;
        render();
        root.dispatchEvent(
          new CustomEvent(current >= last() ? 'anim:ended' : 'anim:paused'),
        );
      });

      segBtns.forEach((btn) =>
        btn.addEventListener('click', () => {
          if (btn.dataset.variant === variant) return;
          variant = btn.dataset.variant;
          segBtns.forEach((b) =>
            b.setAttribute('aria-pressed', String(b === btn)),
          );
          reset();
          if (reduce) {
            current = last();
            render();
            root.dispatchEvent(new CustomEvent('anim:ended'));
            return;
          }
          root.dispatchEvent(new CustomEvent('anim:started'));
          play();
        }),
      );

      (window.animQueue = window.animQueue || []).push({
        root,
        play,
        pause: stop,
        reset,
      });

      // Reduced motion rests on the outcome until the reader steps through.
      current = reduce ? last() : 0;
      render();
    }

    const boot = () =>
      document.querySelectorAll('[data-crl]').forEach(initCounterRace);
    if (document.readyState !== 'loading') boot();
    else document.addEventListener('DOMContentLoaded', boot);
  })();
</script>

<style>
  .crl__tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .crl__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-3);
    margin-bottom: var(--sp-3);
  }
  .crl__counter {
    font-size: 11px;
    color: var(--fg-faint);
  }

  .crl__board {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--sp-2);
    align-items: stretch;
  }
  .crl__lane,
  .crl__mid {
    display: grid;
    align-content: start;
    gap: 6px;
    min-width: 0;
    padding: var(--sp-3);
    transition:
      border-color 0.25s var(--ease),
      background 0.25s var(--ease);
  }
  .crl__lane {
    border-style: dashed;
  }
  .crl__lane[data-state='run'] {
    border-style: solid;
    border-color: var(--viz-net);
    background: color-mix(in srgb, var(--viz-net) 8%, var(--viz-panel));
  }
  .crl__lane[data-state='wait'] {
    border-color: color-mix(in srgb, var(--viz-net) 45%, transparent);
  }
  .crl__lane[data-state='done'] {
    border-style: solid;
  }
  .crl__op {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    color: var(--fg);
    overflow-wrap: anywhere;
  }
  .crl__lane[data-state='idle'] .crl__op {
    color: var(--fg-faint);
    font-weight: 400;
  }
  .crl__reg {
    font-size: 11.5px;
    color: var(--fg-muted);
  }
  .crl__reg b {
    color: var(--viz-net);
  }

  .crl__mid {
    justify-items: center;
    text-align: center;
    border-color: color-mix(in srgb, var(--viz-sound) 40%, var(--border));
  }
  :global(.crl[data-variant='actor']) .crl__mid {
    border-color: var(--viz-meta);
    background: color-mix(in srgb, var(--viz-meta) 6%, var(--viz-panel));
  }
  .crl__mid-name {
    font-size: 11px;
    color: var(--fg-faint);
  }
  .crl__cell {
    font-size: 13px;
    color: var(--fg-muted);
  }
  .crl__count {
    display: inline-block;
    min-width: 1.6em;
    font-size: 22px;
    color: var(--viz-sound-text);
  }
  :global(.crl.is-bad) .crl__count {
    color: var(--viz-bad);
  }
  .crl__mailbox {
    display: grid;
    justify-items: center;
    gap: 4px;
    width: 100%;
  }
  .crl__jobs {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
  }
  .crl__jobs :global(.crl__empty) {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-faint);
  }

  .crl__tally {
    display: flex;
    flex-wrap: wrap;
    gap: 4px var(--sp-4);
    margin-top: var(--sp-3);
    font-size: 11.5px;
    color: var(--fg-muted);
  }
  .crl__tally b {
    color: var(--fg);
  }
  .crl__tally .is-bad,
  .crl__tally .is-bad b {
    color: var(--viz-bad);
  }

  .crl__text {
    margin: var(--sp-3) 0 0;
    min-height: 3em;
    padding-left: var(--sp-3);
    font-size: var(--fs-sm);
    line-height: 1.5;
    color: var(--fg);
    border-left: 3px solid var(--viz-meta);
  }
  .crl__text.is-bad {
    border-left-color: var(--viz-bad);
  }
  .crl__legend {
    margin-top: var(--sp-2);
  }

  @media (max-width: 560px) {
    .crl__board {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .crl__mid {
      grid-column: 1 / -1;
      grid-row: 1;
    }
    .crl__reg-name {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .crl__lane,
    .crl__mid {
      transition: none;
    }
  }
</style>
