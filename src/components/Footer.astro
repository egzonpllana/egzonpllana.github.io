---
import { NAV, SITE } from '../data/site';
import SocialLinks from './SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="footer" data-fullscreen-hide>
  <!-- build:iq9zxzxiq9zxzxiqiq9zxzxzx9zxiq -->
  <div class="container footer__inner">
    <div class="footer__brand">
      <span class="footer__name">
        <i class="footer__mark" aria-hidden="true"></i>
        {SITE.name}
      </span>
      <p class="footer__tag">
        Senior iOS Engineer · SDK &amp; Mobile Architect
      </p>
    </div>

    <nav class="footer__nav" aria-label="Footer">
      {NAV.map((item) => <a href={item.href}>{item.label}</a>)}
      <a href="/rss.xml">RSS</a>
    </nav>

    <SocialLinks size={18} />
  </div>

  <div class="container footer__base">
    <span>© {year} {SITE.name}. All rights reserved.</span>
    <span class="footer__built">Built with Astro</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding-block: var(--sp-7) var(--sp-5);
    margin-top: var(--sp-8);
  }
  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-5);
  }
  .footer__name {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .footer__mark {
    width: 10px;
    height: 10px;
    border-radius: 2px;
    background: var(--accent);
  }
  .footer__tag {
    margin-top: var(--sp-2);
    color: var(--fg-muted);
    font-size: var(--fs-sm);
  }
  .footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-5);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .footer__nav a {
    color: var(--fg-faint);
    transition: color 0.18s var(--ease);
  }
  .footer__nav a:hover {
    color: var(--fg);
  }
  .footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-faint);
  }
</style>
