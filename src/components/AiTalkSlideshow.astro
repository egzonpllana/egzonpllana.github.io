---
import AiBlock from './AiBlock.astro';
import { SLIDES, BlockKind, SlideLayout } from '../data/aiTalk';

const total = SLIDES.length;
const pad = (n: number) => (n < 10 ? '0' + n : String(n));
---

<div class="ai-talk" data-ai-talk>
  <!-- ===== STAGE ===== -->
  <div
    class="ai-stage"
    id="ai-stage"
    data-ai-stage
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label="Talk slides - use the arrow keys to change slides, F to present"
  >
    <div class="ai-frame" data-ai-frame>
    {
      SLIDES.map((slide) => (
        <article
          class:list={[
            'ai-slide',
            {
              'is-active': slide.n === 1,
              'ai-slide--center': slide.layout === SlideLayout.Center,
            },
          ]}
          data-index={slide.n}
          role="group"
          aria-roledescription="slide"
          aria-label={`Slide ${slide.n} of ${total}`}
          aria-hidden={slide.n === 1 ? 'false' : 'true'}
          data-transcript={slide.transcript}
        >
          <span class="ai-slide__num">
            {pad(slide.n)} / {pad(total)}
          </span>
          <span class="ai-slide__kicker">
            <span class="ai-slide__dot" />
            {slide.kicker}
          </span>
          <h2 class="ai-slide__title" set:html={slide.titleHtml} />
          <div class="ai-slide__body">
            {slide.blocks.map((block) =>
              block.kind === BlockKind.Columns ? (
                <div
                  class:list={[
                    'ai-cols',
                    { 'ai-cols--wide': block.variant === 'wide' },
                  ]}
                >
                  {block.cols.map((col) => (
                    <div class="ai-col">
                      {col.map((leaf) => (
                        <AiBlock block={leaf} />
                      ))}
                    </div>
                  ))}
                </div>
              ) : (
                <AiBlock block={block} />
              ),
            )}
          </div>
        </article>
      ))
    }
    </div>
  </div>

  <!-- ===== TRANSCRIPT ===== -->
  <div class="ai-transcript">
    <span class="ai-transcript__eyebrow">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M12 3a4 4 0 0 0-4 4v3a4 4 0 0 0 8 0V7a4 4 0 0 0-4-4z"
        ></path><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg
      >
      Transcript
    </span>
    <p class="ai-transcript__text" data-ai-transcript aria-live="polite">
      {SLIDES[0].transcript}
    </p>
  </div>

  <!-- ===== CONTROLS (under the transcript) ===== -->
  <div class="ai-controls" role="group" aria-label="Slideshow controls">
    <div class="ai-progress"><i data-ai-fill></i></div>
    <div class="ai-controls__bar">
      <button
        class="ai-btn"
        data-ai-prev
        type="button"
        aria-label="Previous slide"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M15 18l-6-6 6-6"></path></svg
        >
      </button>
      <div class="ai-counter" data-ai-counter>
        <b>{pad(1)}</b> / {pad(total)}
      </div>
      <button class="ai-btn" data-ai-next type="button" aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M9 6l6 6-6 6"></path></svg
        >
      </button>
      <button
        class="ai-btn ai-btn--notes"
        data-ai-notes
        type="button"
        aria-pressed="false"
        aria-label="Transcript"
        aria-keyshortcuts="T"
        title="Transcript (T)"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M5 6h14M5 10h14M5 14h9M5 18h6"></path></svg
        >
      </button>
      <button
        class="ai-btn ai-btn--present"
        data-ai-present
        data-mode="inline"
        type="button"
        aria-pressed="false"
        aria-label="Present fullscreen"
        aria-keyshortcuts="F"
        title="Present fullscreen (F)"
      >
        <svg
          class="ai-btn__icon--enter"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5"></path></svg
        >
        <svg
          class="ai-btn__icon--exit"
          viewBox="0 0 24 24"
          aria-hidden="true"
          ><path d="M9 4v5H4M15 4v5h5M9 20v-5H4M15 20v-5h5"></path></svg
        >
        <span class="ai-btn__label">Present</span>
      </button>
    </div>
  </div>
</div>

<script>
  import { startTalkDeck } from '../lib/slideshow';

  startTalkDeck();
</script>

<style>
  .ai-talk {
    margin-top: var(--sp-6);
  }

  /* ===== STAGE - active slide sizes the stage; others overlay for cross-fade ===== */
  .ai-stage {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-xl);
    background: var(--surface);
    overflow: hidden;
  }
  .ai-stage:focus:not(:focus-visible) {
    outline: none;
  }
  .ai-stage:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .ai-frame {
    position: relative;
  }
  .ai-slide {
    position: absolute;
    inset: 0;
    min-width: 0;
    padding: clamp(1.25rem, 0.8rem + 2.5vw, 3rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
    display: flex;
    flex-direction: column;
    min-height: 340px;
  }
  .ai-slide.is-active {
    position: relative;
    inset: auto;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }
  .ai-slide--center {
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .ai-slide--center .ai-slide__body {
    align-items: center;
  }
  .ai-slide--center :global(.ai-lead) {
    margin-inline: auto;
  }

  .ai-slide__num {
    position: absolute;
    top: clamp(1.1rem, 1rem + 1vw, 1.6rem);
    right: clamp(1.2rem, 1rem + 1vw, 1.8rem);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-faint);
    letter-spacing: 0.08em;
  }
  .ai-slide__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-text);
    margin-bottom: var(--sp-4);
  }
  .ai-slide__dot {
    width: 28px;
    height: 1px;
    background: currentColor;
    flex: 0 0 auto;
  }
  .ai-slide__title {
    font-size: clamp(1.5rem, 1.05rem + 2.2vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    margin-bottom: var(--sp-4);
    overflow-wrap: anywhere;
  }
  .ai-slide__title :global(.hl) {
    color: var(--accent);
  }
  .ai-slide__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    min-width: 0;
  }
  .ai-slide__body > :global(*) {
    min-width: 0;
    max-width: 100%;
  }

  /* Columns inside a slide */
  .ai-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: start;
  }
  .ai-cols--wide {
    grid-template-columns: 1.08fr 0.92fr;
  }
  .ai-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    min-width: 0;
  }

  /* ===== CONTROLS ===== */
  .ai-controls {
    margin-top: var(--sp-4);
  }
  .ai-progress {
    height: 2px;
    border-radius: 1px;
    background: var(--border);
    overflow: hidden;
  }
  .ai-progress > i {
    display: block;
    height: 100%;
    width: 5.88%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.4s var(--ease);
  }
  .ai-controls__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
    flex-wrap: wrap;
  }
  .ai-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--fg-muted);
    transition:
      background 0.16s var(--ease),
      border-color 0.16s var(--ease),
      transform 0.16s var(--ease),
      opacity 0.16s var(--ease);
  }
  .ai-btn:hover:not(:disabled) {
    color: var(--fg);
    border-color: var(--fg-faint);
  }
  .ai-btn:active:not(:disabled) {
    transform: scale(0.92);
  }
  .ai-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .ai-btn svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 1.75;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ai-btn--present {
    width: auto;
    gap: 0.5rem;
    margin-left: auto;
    padding-inline: 0.85rem 1rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .ai-btn--present svg {
    width: 18px;
    height: 18px;
  }
  .ai-btn--present[data-mode='inline'] .ai-btn__icon--exit,
  .ai-btn--present[data-mode='presenting'] .ai-btn__icon--enter,
  .ai-btn--present[data-mode='presenting'] .ai-btn__label {
    display: none;
  }
  .ai-btn--notes {
    display: none;
  }
  .ai-counter {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
    min-width: 66px;
    text-align: center;
  }
  .ai-counter :global(b) {
    color: var(--fg);
    font-weight: 500;
  }

  /* ===== TRANSCRIPT ===== */
  .ai-transcript {
    margin-top: var(--sp-5);
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }
  .ai-transcript__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: var(--sp-3);
  }
  .ai-transcript__eyebrow svg {
    width: 15px;
    height: 15px;
    stroke: var(--accent);
    stroke-width: 1.7;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ai-transcript__text {
    color: var(--fg-muted);
    line-height: 1.7;
    font-size: var(--fs-md);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ai-transcript__text.swap-in {
      animation: ai-swap 0.4s var(--ease);
    }
    @keyframes ai-swap {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  /* ===== PRESENT MODE ===== */
  :global(html.ai-presenting) {
    overflow: hidden;
  }
  .ai-talk.is-presenting {
    position: fixed;
    inset: 0;
    z-index: 100;
    margin: 0;
    display: flex;
    flex-direction: column;
    background: var(--bg);
  }
  .is-presenting.is-idle {
    cursor: none;
  }
  .is-presenting .ai-stage {
    flex: 1 1 auto;
    min-height: 0;
    border: 0;
    border-radius: 0;
    background: var(--bg);
  }
  .is-presenting .ai-stage:focus-visible {
    outline: none;
  }

  /* Landscape: fixed 16:9 frame, scaled into the stage. */
  .is-presenting[data-orient='landscape'] .ai-frame {
    position: absolute;
    left: 50%;
    top: var(--frame-top, 50%);
    width: var(--frame-w, 1280px);
    height: var(--frame-h, 720px);
    transform: translate(-50%, -50%) scale(var(--fit, 1));
  }
  .is-presenting[data-orient='landscape'] .ai-slide,
  .is-presenting[data-orient='landscape'] .ai-slide.is-active {
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    min-height: 100%;
    padding: 3.25rem 4rem;
    transform-origin: top center;
    transform: translateY(6px) scale(var(--slide-fit, 1));
  }
  .is-presenting[data-orient='landscape'] .ai-slide.is-active {
    transform: scale(var(--slide-fit, 1));
  }
  .is-presenting[data-orient='landscape'] .ai-slide__num {
    display: block;
    top: 1.75rem;
    right: 2rem;
  }
  .is-presenting[data-orient='landscape'] .ai-slide__title {
    font-size: 2.6rem;
  }
  .is-presenting[data-orient='landscape'] .ai-cols {
    grid-template-columns: 1fr 1fr;
  }
  .is-presenting[data-orient='landscape'] .ai-cols--wide {
    grid-template-columns: 1.08fr 0.92fr;
  }
  .is-presenting[data-orient='landscape'] :global(.ai-cards--2),
  .is-presenting[data-orient='landscape'] :global(.ai-checks--2col) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .is-presenting[data-orient='landscape'] :global(.ai-cards--3) {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .is-presenting[data-orient='landscape'] :global(.ai-quote) {
    font-size: var(--fs-xl);
  }

  /* Portrait: responsive slide at full width, scrolling when long. */
  .is-presenting[data-orient='portrait'] .ai-frame {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .is-presenting[data-orient='portrait'] .ai-slide {
    padding-top: max(1.5rem, env(safe-area-inset-top));
    padding-bottom: 6rem;
  }
  .is-presenting[data-orient='portrait'] .ai-slide.is-active {
    min-height: 100%;
  }

  /* Transcript: shown while presenting unless toggled off (T). */
  .is-presenting .ai-transcript {
    display: none;
  }
  .is-presenting[data-notes='on'] .ai-transcript {
    display: block;
    flex: 0 0 auto;
    max-height: 34vh;
    overflow-y: auto;
    margin: 0;
    padding: var(--sp-5) max(var(--sp-6), env(safe-area-inset-right))
      var(--sp-3) max(var(--sp-6), env(safe-area-inset-left));
    border: 0;
    border-top: 1px solid var(--border);
    border-radius: 0;
  }
  .is-presenting[data-notes='on'] .ai-transcript__text {
    max-width: 64rem;
    margin-inline: auto;
    font-size: var(--fs-lg);
    line-height: 1.6;
    color: var(--fg);
  }
  .is-presenting[data-notes='on'] .ai-transcript__eyebrow {
    display: flex;
    max-width: 64rem;
    margin-inline: auto;
    margin-bottom: var(--sp-3);
  }

  /* Controls float over the bottom edge and fade when the pointer rests. */
  .is-presenting .ai-controls {
    margin: 0;
  }
  .is-presenting .ai-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2;
    height: 3px;
    border-radius: 0;
    background: transparent;
  }
  .is-presenting .ai-progress > i {
    border-radius: 0;
  }
  .is-presenting .ai-controls__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: max(var(--sp-5), env(safe-area-inset-bottom));
    z-index: 2;
    width: max-content;
    margin: 0 auto;
    padding: 6px;
    gap: var(--sp-2);
    flex-wrap: nowrap;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: color-mix(in srgb, var(--surface) 88%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    transition: opacity 0.36s var(--ease);
  }
  /* With the transcript open the controls sit under it, never on its text. */
  .is-presenting[data-notes='on'] .ai-controls {
    flex: 0 0 auto;
    padding: var(--sp-2) 0 max(var(--sp-3), env(safe-area-inset-bottom));
    background: var(--surface);
  }
  .is-presenting[data-notes='on'] .ai-controls__bar {
    position: static;
  }
  @media (max-height: 520px) {
    .is-presenting[data-notes='on'] .ai-transcript {
      padding-top: var(--sp-3);
    }
    .is-presenting[data-notes='on'] .ai-transcript__eyebrow {
      display: none;
    }
    .is-presenting[data-notes='on'] .ai-transcript__text {
      font-size: var(--fs-base);
    }
    .is-presenting[data-notes='on'] .ai-controls {
      padding-block: 0 max(var(--sp-2), env(safe-area-inset-bottom));
    }
    .is-presenting[data-notes='on'] .ai-controls__bar {
      padding: 2px;
    }
  }
  .is-presenting[data-notes='off'].is-idle
    .ai-controls__bar:not(:focus-within, :hover) {
    opacity: 0;
    pointer-events: none;
  }
  .is-presenting .ai-btn {
    border-color: transparent;
  }
  .is-presenting .ai-btn--notes {
    display: inline-flex;
  }
  .is-presenting .ai-btn--notes[aria-pressed='true'] {
    color: var(--accent-text);
    border-color: var(--accent-line);
  }
  .is-presenting .ai-btn--present {
    width: 44px;
    margin-left: 0;
    padding: 0;
  }

  @media (max-width: 720px) {
    .ai-cols,
    .ai-cols--wide {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .ai-slide__num {
      display: none;
    }
  }
</style>
