---
import AiBlock from './AiBlock.astro';
import { SLIDES, BlockKind, SlideLayout } from '../data/aiTalk';

const total = SLIDES.length;
const pad = (n: number) => (n < 10 ? '0' + n : String(n));
---

<div class="ai-talk" data-ai-talk>
  <!-- ===== STAGE ===== -->
  <div
    class="ai-stage"
    id="ai-stage"
    tabindex="0"
    role="region"
    aria-roledescription="carousel"
    aria-label="Talk slides - use the arrow keys to change slides"
  >
    {
      SLIDES.map((slide) => (
        <article
          class:list={[
            'ai-slide',
            {
              'is-active': slide.n === 1,
              'ai-slide--center': slide.layout === SlideLayout.Center,
            },
          ]}
          data-index={slide.n}
          role="group"
          aria-roledescription="slide"
          aria-label={`Slide ${slide.n} of ${total}`}
          aria-hidden={slide.n === 1 ? 'false' : 'true'}
        >
          <span class="ai-slide__num">
            {pad(slide.n)} / {pad(total)}
          </span>
          <span class="ai-slide__kicker">
            <span class="ai-slide__dot" />
            {slide.kicker}
          </span>
          <h2 class="ai-slide__title" set:html={slide.titleHtml} />
          <div class="ai-slide__body">
            {slide.blocks.map((block) =>
              block.kind === BlockKind.Columns ? (
                <div
                  class:list={[
                    'ai-cols',
                    { 'ai-cols--wide': block.variant === 'wide' },
                  ]}
                >
                  {block.cols.map((col) => (
                    <div class="ai-col">
                      {col.map((leaf) => (
                        <AiBlock block={leaf} />
                      ))}
                    </div>
                  ))}
                </div>
              ) : (
                <AiBlock block={block} />
              ),
            )}
          </div>
        </article>
      ))
    }
  </div>

  <!-- ===== CONTROLS ===== -->
  <div class="ai-controls" role="group" aria-label="Slideshow controls">
    <div class="ai-progress"><i data-ai-fill></i></div>
    <div class="ai-controls__bar">
      <button
        class="ai-btn"
        data-ai-prev
        type="button"
        aria-label="Previous slide"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M15 18l-6-6 6-6"></path></svg
        >
      </button>
      <div class="ai-counter" data-ai-counter>
        <b>{pad(1)}</b> / {pad(total)}
      </div>
      <button class="ai-btn" data-ai-next type="button" aria-label="Next slide">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M9 6l6 6-6 6"></path></svg
        >
      </button>
      <div class="ai-dots" role="group" aria-label="Go to slide">
        {
          SLIDES.map((slide) => (
            <button
              class:list={['ai-dot', { 'is-active': slide.n === 1 }]}
              data-ai-dot={slide.n}
              type="button"
              aria-label={`Go to slide ${slide.n}`}
              aria-current={slide.n === 1 ? 'true' : undefined}
            >
              <span aria-hidden="true" />
            </button>
          ))
        }
      </div>
    </div>
  </div>

  <!-- ===== TRANSCRIPT ===== -->
  <div class="ai-transcript">
    <span class="ai-transcript__eyebrow">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M12 3a4 4 0 0 0-4 4v3a4 4 0 0 0 8 0V7a4 4 0 0 0-4-4z"
        ></path><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg
      >
      Transcript
    </span>
    <p class="ai-transcript__text" data-ai-transcript aria-live="polite">
      {SLIDES[0].transcript}
    </p>
  </div>
</div>

<script
  is:inline
  define:vars={{ transcripts: SLIDES.map((s) => s.transcript), total }}
>
  (() => {
    function initAiTalk() {
      const root = document.querySelector('[data-ai-talk]');
      if (!root || root.dataset.bound === '1') return;
      root.dataset.bound = '1';

      const stage = root.querySelector('#ai-stage');
      const slides = Array.from(root.querySelectorAll('.ai-slide'));
      const dots = Array.from(root.querySelectorAll('[data-ai-dot]'));
      const prevBtn = root.querySelector('[data-ai-prev]');
      const nextBtn = root.querySelector('[data-ai-next]');
      const counter = root.querySelector('[data-ai-counter]');
      const fill = root.querySelector('[data-ai-fill]');
      const scriptEl = root.querySelector('[data-ai-transcript]');
      if (!slides.length) return;

      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)',
      ).matches;
      const pad = (n) => (n < 10 ? '0' + n : String(n));
      let current = 0;

      function show(n) {
        n = Math.max(0, Math.min(total - 1, n));
        if (n === current && root.dataset.init === '1') return;
        current = n;
        root.dataset.init = '1';

        slides.forEach((sl, i) => {
          const on = i === current;
          sl.classList.toggle('is-active', on);
          sl.setAttribute('aria-hidden', on ? 'false' : 'true');
        });
        dots.forEach((d, i) => {
          const on = i === current;
          d.classList.toggle('is-active', on);
          if (on) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
        if (fill) fill.style.width = ((current + 1) / total) * 100 + '%';
        if (counter)
          counter.innerHTML = '<b>' + pad(current + 1) + '</b> / ' + pad(total);
        if (prevBtn) prevBtn.disabled = current === 0;
        if (nextBtn) nextBtn.disabled = current === total - 1;

        if (scriptEl) {
          scriptEl.textContent = transcripts[current];
          if (!reduce) {
            scriptEl.classList.remove('swap-in');
            void scriptEl.offsetWidth; // force reflow to replay the animation
            scriptEl.classList.add('swap-in');
          }
        }
      }

      const next = () => show(current + 1);
      const prev = () => show(current - 1);

      if (nextBtn) nextBtn.addEventListener('click', next);
      if (prevBtn) prevBtn.addEventListener('click', prev);
      dots.forEach((d, i) => d.addEventListener('click', () => show(i)));

      // Keyboard - only while focus is inside the slideshow, so page-level
      // arrow-key scrolling and other widgets are never hijacked.
      root.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
        if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
        const t = e.target;
        if (t.closest && t.closest('a, input, textarea, select')) return;
        e.preventDefault();
        e.key === 'ArrowRight' ? next() : prev();
      });

      // Touch: swipe left/right anywhere; on mobile, Stories-style tap zones -
      // left third goes back, the rest advances.
      const isMobile = () => window.matchMedia('(max-width: 640px)').matches;
      let x0 = null,
        y0 = null;
      stage.addEventListener(
        'touchstart',
        (e) => {
          x0 = e.touches[0].clientX;
          y0 = e.touches[0].clientY;
        },
        { passive: true },
      );
      stage.addEventListener(
        'touchend',
        (e) => {
          if (x0 === null) return;
          const endX = e.changedTouches[0].clientX;
          const dx = endX - x0;
          const dy = e.changedTouches[0].clientY - y0;
          x0 = y0 = null;
          if (Math.abs(dx) > 50) {
            (dx < 0 ? next : prev)();
            return;
          }
          // Tap (negligible movement), mobile only, unless on a link/button.
          if (isMobile() && Math.abs(dx) < 10 && Math.abs(dy) < 10) {
            if (e.target.closest && e.target.closest('a, button')) return;
            const r = stage.getBoundingClientRect();
            endX - r.left < r.width / 3 ? prev() : next();
          }
        },
        { passive: true },
      );

      show(0);
    }

    if (document.readyState !== 'loading') initAiTalk();
    else document.addEventListener('DOMContentLoaded', initAiTalk);
  })();
</script>

<style>
  .ai-talk {
    margin-top: var(--sp-6);
  }

  /* ===== STAGE - active slide sizes the stage; others overlay for cross-fade ===== */
  .ai-stage {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
    box-shadow: var(--shadow-sm);
    overflow: hidden;
  }
  .ai-stage:focus:not(:focus-visible) {
    outline: none;
  }
  .ai-stage:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }
  .ai-slide {
    position: absolute;
    inset: 0;
    min-width: 0;
    padding: clamp(1.25rem, 0.8rem + 2.5vw, 3rem);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(6px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.4s var(--ease);
    display: flex;
    flex-direction: column;
    min-height: 340px;
  }
  .ai-slide.is-active {
    position: relative;
    inset: auto;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: none;
  }
  .ai-slide--center {
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .ai-slide--center .ai-slide__body {
    align-items: center;
  }
  .ai-slide--center :global(.ai-lead) {
    margin-inline: auto;
  }

  .ai-slide__num {
    position: absolute;
    top: clamp(1.1rem, 1rem + 1vw, 1.6rem);
    right: clamp(1.2rem, 1rem + 1vw, 1.8rem);
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    color: var(--fg-faint);
    letter-spacing: 0.08em;
  }
  .ai-slide__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: var(--sp-3);
  }
  .ai-slide__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }
  .ai-slide__title {
    font-size: clamp(1.5rem, 1.05rem + 2.2vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-4);
    overflow-wrap: anywhere;
  }
  .ai-slide__title :global(.hl) {
    color: var(--accent);
  }
  .ai-slide__body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    min-width: 0;
  }
  .ai-slide__body > :global(*) {
    min-width: 0;
    max-width: 100%;
  }

  /* Columns inside a slide */
  .ai-cols {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-5);
    align-items: start;
  }
  .ai-cols--wide {
    grid-template-columns: 1.08fr 0.92fr;
  }
  .ai-col {
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
    min-width: 0;
  }

  /* ===== CONTROLS ===== */
  .ai-controls {
    margin-top: var(--sp-4);
  }
  .ai-progress {
    height: 3px;
    border-radius: 999px;
    background: var(--border);
    overflow: hidden;
  }
  .ai-progress > i {
    display: block;
    height: 100%;
    width: 5.88%;
    background: var(--accent);
    border-radius: 999px;
    transition: width 0.4s var(--ease);
  }
  .ai-controls__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
    flex-wrap: wrap;
  }
  .ai-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--fg);
    transition:
      background 0.16s var(--ease),
      border-color 0.16s var(--ease),
      transform 0.16s var(--ease),
      opacity 0.16s var(--ease);
  }
  .ai-btn:hover:not(:disabled) {
    background: var(--surface-hover);
    border-color: var(--fg-faint);
  }
  .ai-btn:active:not(:disabled) {
    transform: scale(0.92);
  }
  .ai-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }
  .ai-btn svg {
    width: 20px;
    height: 20px;
    stroke: currentColor;
    stroke-width: 2;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ai-counter {
    font-family: var(--font-mono);
    font-size: var(--fs-sm);
    color: var(--fg-muted);
    font-variant-numeric: tabular-nums;
    min-width: 66px;
    text-align: center;
  }
  .ai-counter :global(b) {
    color: var(--accent-text);
    font-weight: 600;
  }
  .ai-dots {
    display: flex;
    align-items: center;
    margin-left: auto;
    flex-wrap: wrap;
  }
  /* 24x24 hit target around an 8px visual dot (WCAG 2.5.8). */
  .ai-dot {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border-radius: 999px;
    background: none;
  }
  .ai-dot span {
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--fg-faint);
    transition:
      background 0.16s var(--ease),
      transform 0.16s var(--ease);
  }
  .ai-dot:hover span {
    background: var(--fg-muted);
  }
  .ai-dot.is-active span {
    background: var(--accent);
    transform: scale(1.35);
  }

  /* ===== TRANSCRIPT ===== */
  .ai-transcript {
    margin-top: var(--sp-5);
    padding: var(--sp-5);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: var(--radius);
    background: var(--bg-subtle);
  }
  .ai-transcript__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-faint);
    margin-bottom: var(--sp-3);
  }
  .ai-transcript__eyebrow svg {
    width: 15px;
    height: 15px;
    stroke: var(--accent);
    stroke-width: 1.7;
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ai-transcript__text {
    color: var(--fg-muted);
    line-height: 1.7;
    font-size: var(--fs-md);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ai-transcript__text.swap-in {
      animation: ai-swap 0.4s var(--ease);
    }
    @keyframes ai-swap {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
      to {
        opacity: 1;
        transform: none;
      }
    }
  }

  @media (max-width: 720px) {
    .ai-cols,
    .ai-cols--wide {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 640px) {
    .ai-slide__num {
      display: none;
    }
    .ai-dots {
      width: 100%;
      margin-left: 0;
      margin-top: var(--sp-2);
      justify-content: center;
    }
  }
</style>
