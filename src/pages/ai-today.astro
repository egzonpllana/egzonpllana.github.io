---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import AiTalkSlideshow from '../components/AiTalkSlideshow.astro';
import ViewCount from '../components/ViewCount.astro';
import { AI_TALK_INTRO, AI_TALK_META } from '../data/aiTalk';
import { formatDate, isoDate } from '../lib/format-date';
import { AI_TODAY_CARD } from '../data/talks';

const publishedDate = new Date('2026-07-07');

// Social preview: a compressed ~1200px variant instead of the original PNG.
const og = AI_TODAY_CARD.image
  ? await getImage({
      src: AI_TODAY_CARD.image,
      width: 1200,
      format: 'jpeg',
      quality: 85,
    })
  : undefined;
---

<BaseLayout
  title={AI_TALK_META.title}
  description={AI_TALK_META.description}
  type="article"
  publishedDate={publishedDate}
  image={og?.src}
  imageWidth={typeof og?.attributes.width === 'number'
    ? og.attributes.width
    : undefined}
  imageHeight={typeof og?.attributes.height === 'number'
    ? og.attributes.height
    : undefined}
  imageAlt={`${AI_TALK_META.title} - talk cover`}
>
  <section class="section">
    <div class="container palette-content">
      <a class="ai-back backlink" href="/talks/">
        <span aria-hidden="true">&#8592;</span> All talks
      </a>
      <SectionHeading
        as="h1"
        kicker="Talk · Slides and transcript"
        title={AI_TALK_INTRO.title}
        description={AI_TALK_INTRO.lead}
        descFull
      />
      <p class="ai-date" data-reveal>
        <time datetime={isoDate(publishedDate)}
          >{formatDate(publishedDate)}</time
        >
        <ViewCount path={Astro.url.pathname} />
      </p>
      <p class="ai-intro" data-reveal>{AI_TALK_INTRO.body}</p>
      <AiTalkSlideshow />
    </div>
  </section>
</BaseLayout>

<style>
  .ai-back {
    margin-bottom: var(--sp-6);
  }
  .ai-date {
    display: block;
    margin-top: calc(-1 * var(--sp-5));
    margin-bottom: var(--sp-3);
    font-family: var(--font-mono);
    font-size: var(--fs-2xs);
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-faint);
  }
  .ai-intro {
    max-width: 68ch;
    color: var(--fg-muted);
    line-height: 1.7;
  }
</style>
