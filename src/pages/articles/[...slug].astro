---
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { readingTime } from '../../lib/reading-time';
import { articleSlug } from '../../lib/slug';

export async function getStaticPaths() {
  const articles = (await getCollection('articles')).filter(
    (a) => !a.data.draft,
  );

  return articles.map((article) => {
    // "Read next": rank the other articles by shared tags, then recency.
    const related = articles
      .filter((other) => other.id !== article.id)
      .map((other) => ({
        entry: other,
        overlap: other.data.tags.filter((t: string) =>
          article.data.tags.includes(t),
        ).length,
      }))
      .sort(
        (a, b) =>
          b.overlap - a.overlap ||
          b.entry.data.date.valueOf() - a.entry.data.date.valueOf(),
      )
      .slice(0, 3)
      .map(({ entry }) => ({
        title: entry.data.title,
        description: entry.data.description,
        slug: articleSlug(entry.id),
        date: entry.data.date,
        readingTime: readingTime(entry.body ?? ''),
      }));

    return {
      params: { slug: articleSlug(article.id) },
      props: { article, related },
    };
  });
}

const { article, related } = Astro.props;
const { Content, headings } = await render(article);
const minutes = readingTime(article.body ?? '');
---

<ArticleLayout
  title={article.data.title}
  description={article.data.description}
  date={article.data.date}
  updated={article.data.updated}
  tags={article.data.tags}
  readingTime={minutes}
  heroImage={article.data.heroImage}
  ogImage={article.data.ogImage}
  repoUrl={article.data.repoUrl}
  headings={headings}
  related={related}
>
  <Content />
</ArticleLayout>
