---
import '../styles/global.css';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../data/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  tags?: string[];
}

const {
  title,
  description,
  image,
  imageWidth,
  imageHeight,
  imageAlt,
  type,
  publishedDate,
  updatedDate,
  tags,
} = Astro.props;
const isSiteTitle = title === SITE.name || title === SITE.title;
const fullTitle = isSiteTitle ? title : `${title} - ${SITE.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={fullTitle}
      ogTitle={title}
      description={description}
      image={image}
      imageWidth={imageWidth}
      imageHeight={imageHeight}
      imageAlt={imageAlt}
      type={type}
      publishedDate={publishedDate}
      updatedDate={updatedDate}
      tags={tags}
    />
    <script is:inline>
      // No-flash theme: run before paint. Also marks JS availability so
      // scroll-reveal styles only hide content when JS will reveal it.
      (() => {
        document.documentElement.classList.add('js');
        let theme = 'light';
        try {
          theme =
            localStorage.getItem('theme') ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light');
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
        // Keep the browser chrome color in sync with a manual theme override.
        const color = theme === 'dark' ? '#0b0e14' : '#ffffff';
        document.querySelectorAll('meta[name="theme-color"]').forEach((m) => {
          m.setAttribute('content', color);
          m.removeAttribute('media');
        });
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script is:inline>
      // Scroll-reveal: fade/slide elements in as they enter the viewport.
      (() => {
        const reduce = window.matchMedia(
          '(prefers-reduced-motion: reduce)',
        ).matches;
        const reveal = () => {
          const els = document.querySelectorAll(
            '[data-reveal]:not(.is-visible)',
          );
          if (reduce || !('IntersectionObserver' in window)) {
            els.forEach((el) => el.classList.add('is-visible'));
            return;
          }
          const io = new IntersectionObserver(
            (entries, obs) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  obs.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          els.forEach((el) => io.observe(el));
        };
        if (document.readyState !== 'loading') reveal();
        else document.addEventListener('DOMContentLoaded', reveal);
      })();
    </script>
  </body>
</html>
